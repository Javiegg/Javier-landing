'                    <th style="width:95px;text-align:right">P. Unit ($)</th>' +
'                    <th style="width:105px;text-align:right">Subtotal ($)</th>' +
'                </tr>' +
'            </thead>' +
'            <tbody>' +
                rowsHtml +
'            </tbody>' +
'        </table>' +
'        <div class="totals-container">' +
'            <table class="totals-table">' +
'                <tr>' +
'                    <td style="color:#4b5563">Subtotal Neto (' + totalPrendas + ' prendas):</td>' +
'                    <td style="text-align:right;font-weight:700">$' + subtotal.toFixed(2) + '</td>' +
'                </tr>' +
'                <tr>' +
'                    <td style="color:#4b5563">IVA Estimado (16%):</td>' +
'                    <td style="text-align:right;font-weight:700">$' + iva.toFixed(2) + '</td>' +
'                </tr>' +
