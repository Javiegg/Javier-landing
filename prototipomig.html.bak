'            <p><b>Condiciones Comerciales y de Suministro:</b></p>' +
'            <ul style="padding-left:18px;margin-top:4px">' +
'                <li><b>Moneda y Facturación:</b> Precios expresados en Dólares de los Estados Unidos (USD). Pagos en Bolívares calculados a la tasa oficial del Banco Central de Venezuela (BCV) a la fecha de pago.</li>' +
'                <li><b>Tiempos de Despacho:</b> Inmediato para existencias en inventario. De 7 a 12 días hábiles para órdenes de confección con bordado computarizado o tallas especiales.</li>' +
'                <li><b>Garantía de Calidad:</b> Confección con costuras triples reforzadas, hilos de alta tenacidad y telas certificadas (Algodón, Dril, Gabardina, Ignífugas). Calzado con normativas COVENIN.</li>' +
'                <li><b>Despacho y Envíos:</b> Entregas directas en sedes Maracay y Caracas. Despacho nacional por encomiendas aseguradas.</li>' +
'            </ul>' +
'        </div>' +
'        <div class="signatures">' +
'            <div class="sign-line">' +
'                <b>UNIFORTEX INDUSTRIAL C.A.</b>' +
'                <span>Dpto. de Ventas Técnicas & Cotizaciones</span><br>' +
'                <span style="font-size:10px;color:#9ca3af;font-style:italic">[Documento emitido electrónicamente con validez comercial]</span>' +
'            </div>' +
'            <div class="sign-line">' +
'                <b>Aceptación / Aprobación del Cliente</b>' +
'                <span>Firma Autorizada, Nombre y Sello de la Empresa</span>' +
'            </div>' +
'        </div>' +
'    </div>' +
'</body>' +
'</html>';

            // Abrir documento en ventana emergente o pestaña
            const printWindow = window.open('', '_blank', 'width=950,height=800,scrollbars=yes,resizable=yes');
            if (!printWindow) {
                alert('⚠️ El navegador bloqueó la ventana emergente. Por favor permite las ventanas emergentes en este sitio para generar tu cotización en PDF.');
                return;
            }

            printWindow.document.open();
            printWindow.document.write(printableHtml);
            printWindow.document.close();

            // Disparar diálogo de impresión automáticamente
            setTimeout(() => {
                try {
                    printWindow.focus();
                    printWindow.print();
                } catch(e) {}
            }, 350);
        }


        /* ---------- NAVEGACIÓN POR PESTAÑAS CON DESLIZAMIENTO HORIZONTAL ---------- */
        const TAB_KEYS = ['inicio', 'config', 'diseno', 'orden-compra', 'cotiza'];
        let currentTabIndex = 0;
        let isTabTransitioning = false;

        function navigateToTab(targetId) {
            const targetIndex = TAB_KEYS.indexOf(targetId);
            if (targetIndex === -1 || targetIndex === currentTabIndex || isTabTransitioning) return;

            const currentView = document.getElementById('view-' + TAB_KEYS[currentTabIndex]);
            const targetView = document.getElementById('view-' + targetId);
            if (!currentView || !targetView) return;

            isTabTransitioning = true;
            if (typeof resetHeaderScrollState === 'function') resetHeaderScrollState();
            if (targetId === 'cotiza') setTimeout(actualizarBannerCotizacionCarrito, 50);
            window.scrollTo(0, 0);
            document.documentElement.scrollTop = 0;
            document.body.scrollTop = 0;

            const goingForward = targetIndex > currentTabIndex;

            // Actualizar estado activo en la barra superior
            document.querySelectorAll('.nav-btns-row .nav-item').forEach(item => {
                const href = item.getAttribute('href');
                if (href === '#' + targetId) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });

            // Asignar clases de animación de izquierda a derecha
            currentView.className = 'tab-view active ' + (goingForward ? 'sliding-out-left' : 'sliding-out-right');
            targetView.className = 'tab-view active ' + (goingForward ? 'sliding-in-right' : 'sliding-in-left');

            setTimeout(() => {
                currentView.className = 'tab-view';
                targetView.className = 'tab-view active';
                currentTabIndex = targetIndex;
                window.scrollTo(0, 0);
                document.documentElement.scrollTop = 0;
                document.body.scrollTop = 0;
                isTabTransitioning = false;
                if (window.location.hash !== '#' + targetId) {
                    history.replaceState(null, '', '#' + targetId);
                }
            }, 410);
        }

        // Cargar vista por Hash si existe en la URL
        window.addEventListener('load', () => {
            actualizarBannerCotizacionCarrito();
            const hash = window.location.hash.replace('#', '');
            if (TAB_KEYS.includes(hash)) {
                TAB_KEYS.forEach(key => {
                    const v = document.getElementById('view-' + key);
                    if (v) v.className = (key === hash) ? 'tab-view active' : 'tab-view';
                });
                document.querySelectorAll('.nav-btns-row .nav-item').forEach(item => {
                    item.classList.toggle('active', item.getAttribute('href') === '#' + hash);
                });
                currentTabIndex = TAB_KEYS.indexOf(hash);
            }
        });

        /* ---------- CONTROL ESTABLE DE HEADER SCROLL (SIN BUCLES NI JITTER) ---------- */
        let isHeaderScrolledState = false;
        function resetHeaderScrollState() {
            isHeaderScrolledState = false;
            const header = document.getElementById('mainHeader') || document.querySelector('header');
            if (header) header.classList.remove('header-scrolled');
        }

        function initHeaderScrollAnimation() {
            const header = document.getElementById('mainHeader') || document.querySelector('header');
            if (!header) return;

            let ticking = false;

            function checkScroll() {
                // Durante la transición entre pestañas nunca alternar para evitar saltos
                if (isTabTransitioning) return;

                const y = window.pageYOffset || document.documentElement.scrollTop || 0;

                // 1. En el tope superior de la página, siempre restaurar el menú
                if (y <= 15) {
                    if (isHeaderScrolledState) {
                        isHeaderScrolledState = false;
                        header.classList.remove('header-scrolled');
                    }
                    return;
                }

                // 2. Transición ágil y libre de bucles
                if (!isHeaderScrolledState && y > 35) {
                    isHeaderScrolledState = true;
                    header.classList.add('header-scrolled');
                } else if (isHeaderScrolledState && y < 20) {
                    isHeaderScrolledState = false;
                    header.classList.remove('header-scrolled');
                }
            }

            window.addEventListener('scroll', () => {
                if (!ticking) {
                    window.requestAnimationFrame(() => {
                        checkScroll();
                        ticking = false;
                    });
                    ticking = true;
                }
            }, { passive: true });

            checkScroll();
        }

        /* ---------- COTIZACIÓN RÁPIDA (ENFOQUE PERSONAL) ---------- */
        function enviarCotizacionPersonal(event) {
            if (event) event.preventDefault();

            const nombreInput = document.getElementById('cotizaNombre');
            const telefonoInput = document.getElementById('cotizaTelefono');
            const emailInput = document.getElementById('cotizaEmail');
            const comentariosInput = document.getElementById('cotizaComentarios');
            const notice = document.getElementById('cotizaFriendlyNotice');

            const nombre = nombreInput ? nombreInput.value.trim() : '';
            const telefono = telefonoInput ? telefonoInput.value.trim() : '';
            const email = emailInput ? emailInput.value.trim() : '';
            const comentarios = comentariosInput ? comentariosInput.value.trim() : '';

            // Lista de campos faltantes obligatorios
            const faltantes = [];
            if (!nombre) faltantes.push('tu nombre completo');
            if (!telefono) faltantes.push('tu teléfono o WhatsApp');
            if (!email) faltantes.push('tu correo electrónico');

            if (faltantes.length > 0) {
                let mensajeAmigable = '';
                if (faltantes.length === 3) {
                    mensajeAmigable = '👋 ¡Hola! Para poder enviarte tu cotización personalizada, por favor facilítanos tu nombre, teléfono y correo electrónico. ¡Con gusto te atenderemos!';
                } else if (faltantes.length === 2) {
                    mensajeAmigable = `👋 ¡Casi listo! Solo nos falta ${faltantes[0]} y ${faltantes[1]} para poder enviarte la cotización.`;
                } else {
                    mensajeAmigable = `👋 ¡Solo un detalle! Por favor indícanos ${faltantes[0]} para poder enviarte la información.`;
                }

                if (notice) {
                    notice.style.display = 'block';
                    notice.style.background = 'rgba(253, 196, 23, 0.12)';
                    notice.style.borderColor = 'rgba(253, 196, 23, 0.4)';
                    notice.style.color = 'var(--ama)';
                    notice.innerHTML = `<div style="display:flex;align-items:center;gap:.6rem"><span style="font-size:1.2rem">💡</span><div>${mensajeAmigable}</div></div>`;
                    notice.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }

                if (!nombre && nombreInput) nombreInput.focus();
                else if (!telefono && telefonoInput) telefonoInput.focus();
                else if (!email && emailInput) emailInput.focus();

                return false;
            }

            // Validación suave de formato de correo
            if (!email.includes('@') || !email.includes('.')) {
                if (notice) {
                    notice.style.display = 'block';
                    notice.style.background = 'rgba(253, 196, 23, 0.12)';
                    notice.style.borderColor = 'rgba(253, 196, 23, 0.4)';
                    notice.style.color = 'var(--ama)';
                    notice.innerHTML = `<div style="display:flex;align-items:center;gap:.6rem"><span style="font-size:1.2rem">✉️</span><div>👋 Por favor revisa que tu correo electrónico tenga un formato válido (ejemplo: nombre@correo.com) para poder responderte.</div></div>`;
                    if (emailInput) emailInput.focus();
                }
                return false;
            }

            // Guardar datos en memoria para que el PDF los conserve aunque el formulario se limpie
            window.ultimaCotizacionData = { nombre, telefono, email, comentarios };

            // Éxito: El campo de comentarios es opcional (si no dejó comentarios, no pasa nada)
            const detalleComentario = comentarios ? ' y revisaremos con atención tus comentarios' : '';
            const tienePrendasEnCarro = Object.keys(cart).length > 0;
            const extraCarroMsg = tienePrendasEnCarro ? '\n\n📄 Nota: Tienes productos en tu carrito. Puedes descargar tu cotización formal en PDF con membrete usando el botón que aparece arriba.' : '';
            const confirmMsg = `✅ ¡Muchas gracias, ${nombre}! Hemos recibido tu solicitud correctamente${detalleComentario}. Un asesor se comunicará contigo vía WhatsApp o correo a la brevedad.${extraCarroMsg}`;

            if (notice) {
                notice.style.display = 'block';
                notice.style.background = 'rgba(37, 211, 102, 0.15)';
                notice.style.borderColor = '#25d366';
                notice.style.color = '#25d366';
                const extraNoticeCarro = tienePrendasEnCarro ? '<div style="margin-top:.45rem;padding-top:.4rem;border-top:1px solid rgba(37,211,102,0.3);font-size:.82rem;color:#ffffff">📄 <b>Tip:</b> Tienes productos en el carrito. Haz clic en <b>"Descargar Cotización en PDF"</b> arriba para guardarla o imprimirla al instante.</div>' : '';
                notice.innerHTML = `<div style="display:flex;align-items:flex-start;gap:.6rem"><span style="font-size:1.2rem">✨</span><div><div>${confirmMsg.replace('\n\n', '<br><br>')}</div>${extraNoticeCarro}</div></div>`;
            }

            alert(confirmMsg);

            // Limpiar formulario
            const form = document.getElementById('formCotizaPersonal');
            if (form) form.reset();

            // Ocultar mensaje después de un tiempo prudencial
            setTimeout(() => {
                if (notice) {
                    notice.style.display = 'none';
                    notice.style.background = 'rgba(253, 196, 23, 0.12)';
                    notice.style.borderColor = 'rgba(253, 196, 23, 0.4)';
                    notice.style.color = 'var(--ama)';
                }
            }, 8000);

            return false;
        }

        initHeaderScrollAnimation();

        renderOCTable();
        if (typeof renderDisenoStudio === 'function') renderDisenoStudio();
        renderCart();
        renderCatalog();
    </script>
</body>

</html>