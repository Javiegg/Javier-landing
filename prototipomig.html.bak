<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>UNIFORTEX · Asesor Integral EPP</title>
    <meta name="description" content="Asesor inteligente y configurador de kits de EPP, uniformes y bioseguridad.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,400;0,600;0,700;0,800;1,400;1,700;1,800&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --ama: #FDC417;
            --nar: #D35914;
            --neg: #1D1D1B;
            --gri: #323231;
            --bla: #FFF;
            --gcl: #C5C5C5;
            --npu: #000;
            --gw: linear-gradient(135deg, #FDC417, #D35914);
            --gd: linear-gradient(135deg, #1D1D1B, #323231)
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box
        }

        html {
            scroll-behavior: auto;
            overflow-y: scroll;
            scrollbar-gutter: stable;
            overflow-anchor: none;
        }

        section,
        .hero-wrapper {
            scroll-margin-top: 85px;
        }

        body {
            font-family: Poppins, sans-serif;
            color: var(--neg);
            background: #fff;
            line-height: 1.6;
            overflow-x: hidden;
            overflow-anchor: none;
        }

        h1,
        h2,
        h3 {
            font-weight: 800;
            font-style: italic;
            text-transform: uppercase;
            line-height: 1.1
        }

        h1 {
            font-size: clamp(2rem, 5vw, 3.4rem)
        }

        h2 {
            font-size: clamp(1.5rem, 3vw, 2.3rem)
        }

        p {
            font-style: italic
        }

        .container {
            width: min(1180px, 92%);
            margin: 0 auto
        }

        section {
            padding: clamp(3rem, 7vw, 6rem) 0
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: .5rem;
            padding: .9rem 1.8rem;
            border: none;
            border-radius: 999px;
            font-family: Poppins;
            font-weight: 800;
            font-style: italic;
            text-transform: uppercase;
            font-size: .8rem;
            cursor: pointer;
            transition: .3s;
            text-decoration: none
        }

        .btn-w {
            background: var(--gw);
            color: var(--neg)
        }

        .btn-w:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(211, 89, 20, .45)
        }

        .btn-d {
            background: var(--neg);
            color: #fff
        }

        .btn-d:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, .35)
        }

        .btn-o {
            background: transparent;
            border: 2px solid var(--neg);
            color: var(--neg)
        }

        .btn-o:hover {
            background: var(--neg);
            color: #fff
        }

        header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            width: 100%;
            z-index: 1000;
            background: #000;
            border-bottom: 2px solid rgba(253, 196, 23, .18);
            transition: box-shadow .2s ease, border-color .2s ease;
        }

        .header-spacer {
            height: 122px;
            width: 100%;
            display: block;
            flex-shrink: 0;
        }

        header.header-scrolled {
            box-shadow: 0 8px 25px rgba(0, 0, 0, .75);
            border-bottom-color: rgba(253, 196, 23, .35);
        }

        /* Fila 1: marca (escudo + logo) */
        .nav-brand-row {
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            width: 100%;
            height: 70px;
            padding: .5rem 1.8rem;
            box-sizing: border-box;
            transition: height .18s cubic-bezier(0.16, 1, 0.3, 1);
        }

        header.header-scrolled .nav-brand-row {
            height: 50px;
        }

        /* Estilo base compartido para la marca */
        .nav-brand-row .brand {
            display: inline-flex;
            align-items: center;
            gap: .85rem;
            text-decoration: none;
            cursor: pointer;
            white-space: nowrap;
        }

        /* 1. Logo centrado (estado normal) */
        .nav-brand-row .brand-center {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(1);
            opacity: 1;
            pointer-events: auto;
            transition: opacity .15s ease-out, transform .18s cubic-bezier(0.16, 1, 0.3, 1);
        }

        header.header-scrolled .nav-brand-row .brand-center {
            opacity: 0;
            transform: translate(-54%, -50%) scale(0.92);
            pointer-events: none;
        }

        /* 2. Logo izquierdo (estado scrolled) */
        .nav-brand-row .brand-left {
            position: absolute;
            top: 50%;
            left: 1.5rem;
            transform: translate(-8px, -50%) scale(0.82);
            opacity: 0;
            pointer-events: none;
            transition: opacity .18s ease-out, transform .18s cubic-bezier(0.16, 1, 0.3, 1);
        }

        header.header-scrolled .nav-brand-row .brand-left {
            opacity: 1;
            transform: translate(0, -50%) scale(0.84);
            pointer-events: auto;
        }

        @media (max-width: 680px) {
            .nav-brand-row .brand-left {
                left: 0.8rem;
            }
            header.header-scrolled .nav-brand-row .brand-left {
                transform: translate(0, -50%) scale(0.76);
            }
        }

        /* Imagen del logo oficial con iluminación blanca al ras */
        .brand-logo-img {
            height: 48px;
            max-height: 52px;
            width: auto;
            max-width: min(300px, 60vw);
            object-fit: contain;
            display: block;
            filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.95)) drop-shadow(0 0 7px rgba(255, 255, 255, 0.45));
            transition: filter .2s ease;
        }

        /* Imagen del escudo oficial a la izquierda del logo con iluminación blanca al ras */
        .brand-escudo-img {
            height: 48px;
            max-height: 52px;
            width: auto;
            max-width: 48px;
            object-fit: contain;
            display: block;
            filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.95)) drop-shadow(0 0 7px rgba(255, 255, 255, 0.45));
            transition: filter .2s ease;
        }

        .brand:hover .brand-logo-img,
        .brand:hover .brand-escudo-img {
            filter: drop-shadow(0 0 3px #ffffff) drop-shadow(0 0 10px rgba(253, 196, 23, 0.5));
        }

        /* Botón de acceso rápido al carrito en modo scrolled (extremo derecho) */
        .scrolled-header-cart {
            position: absolute;
            right: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            opacity: 0;
            pointer-events: none;
            transition: opacity .18s ease, transform .18s ease;
            background: rgba(253, 196, 23, .12);
            border: 1px solid var(--ama);
            color: #fff;
            padding: .32rem .85rem;
            border-radius: 999px;
            font-family: Poppins, sans-serif;
            font-size: .75rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

        .scrolled-header-cart:hover {
            background: var(--ama);
            color: #000;
        }

        header.header-scrolled .scrolled-header-cart {
            opacity: 1;
            pointer-events: auto;
        }

        @media (max-width: 680px) {
            .scrolled-header-cart {
                right: 0.8rem;
                padding: .28rem .6rem;
                font-size: .7rem;
            }
        }

        /* Bloque de marca en footer */
        .footer-brand {
            display: inline-flex;
            align-items: center;
            gap: .7rem;
            margin-bottom: .8rem;
            position: static;
        }

        /* Logo en footer */
        .footer-logo-img {
            height: 40px;
            max-height: 44px;
            width: auto;
            max-width: 230px;
            object-fit: contain;
            display: block;
            filter: drop-shadow(0 0 1px #ffffff) 
                    drop-shadow(0 0 2px rgba(255, 255, 255, 0.92)) 
                    drop-shadow(0 0 5px rgba(255, 255, 255, 0.45));
        }

        /* ===== MENÚ DE NAVEGACIÓN (bajo el logo) ===== */
        .nav-btns-row {
            display: flex;
            align-items: stretch;
            justify-content: center;
            background: #000;
            border-top: 1px solid rgba(253, 196, 23, .12);
            overflow-x: auto;
            white-space: nowrap;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            height: 52px;
            opacity: 1;
            transform: translateY(0);
            will-change: opacity, transform;
            transition: opacity .18s ease-out, transform .18s cubic-bezier(0.1, 0.9, 0.2, 1);
        }

        /* En modo scrolled: los botones se recogen hacia arriba de inmediato */
        header.header-scrolled .nav-btns-row {
            height: 0;
            opacity: 0;
            transform: translateY(-12px);
            pointer-events: none;
            border-top-color: transparent;
            overflow: hidden;
        }

        .nav-btns-row::-webkit-scrollbar {
            display: none;
        }

        /* Cada ítem del menú */
        .nav-item {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .65rem 1.4rem;
            font-family: Poppins;
            font-weight: 600;
            font-style: italic;
            text-transform: uppercase;
            font-size: .73rem;
            letter-spacing: .8px;
            color: #fff;
            text-decoration: none;
            background: none;
            border: none;
            border-radius: 0;
            cursor: pointer;
            position: relative;
            transition: color .22s ease;
            flex-shrink: 0;
        }

        /* Línea de subrayado dorado animada */
        .nav-item::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            right: 50%;
            height: 2.5px;
            background: var(--ama);
            transition: left .22s ease, right .22s ease;
            border-radius: 2px 2px 0 0
        }

        .nav-item:hover,
        .nav-item.active {
            color: var(--ama)
        }

        .nav-item:hover::after,
        .nav-item.active::after {
            left: 0;
            right: 0
        }

        /* Separador vertical sutil entre ítems */
        .nav-item+.nav-item {
            border-left: 1px solid rgba(255, 255, 255, .07)
        }

        /* Ícono de carrito: destaca levemente */
        .nav-item-cart {
            font-size: .95rem;
            padding: .65rem 1.2rem
        }

        .nav-item-cart:hover {
            color: var(--ama)
        }

        /* ===== HERO: TARJETA FLOTANTE CON CARRUSEL ===== */
        /* Fondo exterior de la página (claro, da la sensación de cuadro flotante) */
        .hero-wrapper {
            background: #f0efed;
            padding: 1.6rem 1rem 2rem
        }

        /* La tarjeta principal con bordes redondeados */
        .hero-card {
            position: relative;
            overflow: hidden;
            border-radius: 22px;
            min-height: 460px;
            display: flex;
            align-items: center;
            box-shadow: 0 28px 75px rgba(0, 0, 0, .24);
            width: min(1120px, 100%);
            margin: 0 auto
        }

        /* Carrusel de fondos dentro de la tarjeta */
        .hero-carousel {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none
        }

        .hero-slide {
            position: absolute;
            inset: 0;
            opacity: 0;
            transition: opacity 1.3s ease-in-out, transform 8s ease-out;
            transform: scale(1.06);
            will-change: opacity, transform;
            backface-visibility: hidden;
        }

        .hero-slide.active {
            opacity: 1;
            transform: scale(1)
        }

        /* Slide 1 – foto real del proyecto */
        .slide-photo {
            background: url('imagenes pasantias/fondo1.jpg') center/cover no-repeat
        }

        /* Slide 2 – negro industrial */
        .slide-black {
            background:
                radial-gradient(circle at 70% 25%, rgba(50, 50, 49, .5) 0%, transparent 55%),
                radial-gradient(circle at 15% 75%, rgba(29, 29, 27, .8) 0%, transparent 50%),
                linear-gradient(135deg, #0a0a09 0%, #151514 55%, #0d0d0c 100%)
        }

        /* Slide 3 – dorado corporativo */
        .slide-gold {
            background:
                radial-gradient(circle at 75% 20%, rgba(253, 196, 23, .28) 0%, transparent 52%),
                radial-gradient(circle at 20% 75%, rgba(211, 89, 20, .22) 0%, transparent 58%),
                linear-gradient(135deg, #171309 0%, #26200b 48%, #131008 100%)
        }

        /* Overlay: oscurece el fondo para legibilidad */
        .hero-overlay {
            position: absolute;
            inset: 0;
            z-index: 2;
            background: linear-gradient(105deg,
                    rgba(12, 12, 11, .93) 0%,
                    rgba(14, 14, 13, .84) 50%,
                    rgba(14, 14, 13, .68) 100%);
        }

        /* Contenido centrado dentro de la tarjeta */
        .hero-card-body {
            position: relative;
            z-index: 3;
            width: 100%;
            padding: 3rem 3.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            color: #fff;
            gap: 0
        }

        /* Insignia/badge superior */
        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            background: rgba(253, 196, 23, .13);
            border: 1px solid rgba(253, 196, 23, .45);
            color: var(--ama);
            padding: .3rem .9rem;
            border-radius: 999px;
            font-size: .7rem;
            font-weight: 700;
            font-style: italic;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 1.1rem
        }

        /* Título principal dentro de la tarjeta */
        .hero-card-body h1 {
            font-size: clamp(2rem, 4.5vw, 3.1rem);
            line-height: 1.12;
            text-transform: uppercase;
            font-weight: 800;
            font-style: italic;
            margin-bottom: .75rem
        }

        .hero-card-body h1 .gold {
            background: var(--gw);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent
        }

        /* Descripción */
        .hero-card-body .hero-desc {
            color: #d5d5d3;
            font-size: .9rem;
            line-height: 1.65;
            max-width: 620px;
            margin: 0 auto 1.55rem;
            font-style: italic
        }

        /* Estadísticas rápidas */
        .hero-stats {
            display: flex;
            gap: 2.8rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 1.85rem;
            padding-bottom: 1.6rem;
            border-bottom: 1px solid rgba(255, 255, 255, .12)
        }

        .hstat b {
            display: block;
            font-size: 2rem;
            font-weight: 800;
            font-style: italic;
            background: var(--gw);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            line-height: 1
        }

        .hstat small {
            text-transform: uppercase;
            font-size: .63rem;
            letter-spacing: 1.2px;
            color: var(--gcl);
            font-style: italic;
            display: block;
            margin-top: .25rem
        }

        /* Botones de la tarjeta hero */
        .hero-btns {
            display: flex;
            gap: .85rem;
            flex-wrap: wrap;
            justify-content: center
        }

        .hero-btns .btn-o {
            border-color: var(--ama);
            color: var(--ama);
            background: #000;
            transition: all .25s ease;
        }

        .hero-btns .btn-o:hover {
            background: var(--gw);
            color: var(--neg);
            border-color: transparent;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(253, 196, 23, .35);
        }

        /* Puntos indicadores del carrusel */
        .carousel-dots {
            position: absolute;
            bottom: 16px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 4;
            display: flex;
            gap: .5rem;
            align-items: center
        }

        .carousel-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: rgba(255, 255, 255, .3);
            border: none;
            cursor: pointer;
            transition: all .3s ease;
            padding: 0
        }

        .carousel-dot:hover {
            background: rgba(253, 196, 23, .65)
        }

        .carousel-dot.active {
            width: 28px;
            background: var(--gw);
            box-shadow: 0 0 10px rgba(253, 196, 23, .55)
        }

        .grid {
            display: grid;
            gap: 1.4rem
        }

        .g3 {
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr))
        }

        /* ========================================================
           CATÁLOGO DE PRODUCTOS UNIFORTEX (IDENTIDAD CORPORATIVA)
           ======================================================== */
        .catalog-container {
            width: min(1320px, 94%);
            margin: 0 auto;
        }

        #config {
            background:
                radial-gradient(circle at 8% 8%, rgba(253, 196, 23, .08), transparent 28%),
                linear-gradient(180deg, #f4f5f7 0%, #fbfbfa 48%, #f0f1f3 100%) !important;
            padding-top: 2rem;
            padding-bottom: 4rem;
            min-height: 85vh;
        }

        /* ========================================================
           HUB CENTRALIZADO DE BÚSQUEDA Y FILTRADO (ESTILO CORPORATIVO DARK/GOLD)
           ======================================================== */
        .catalog-filter-hub {
            max-width: 1080px;
            margin: 0 auto 2.4rem;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            text-align: left;
            padding: clamp(1.4rem, 3.2vw, 2.3rem);
            border: 1px solid rgba(255, 255, 255, .12);
            border-radius: 28px;
            background:
                radial-gradient(circle at 92% 0%, rgba(211, 89, 20, .28), transparent 30%),
                linear-gradient(135deg, #171817 0%, #272826 58%, #111211 100%);
            box-shadow: 0 24px 55px rgba(20, 22, 22, .25);
            position: relative;
            overflow: hidden;
        }

        .catalog-filter-hub::after {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            right: -100px;
            bottom: -120px;
            border: 1px solid rgba(253, 196, 23, .25);
            border-radius: 50%;
            box-shadow: 0 0 0 20px rgba(253, 196, 23, .04), 0 0 0 42px rgba(253, 196, 23, .03);
            pointer-events: none;
        }

        .catalog-hub-header,
        .catalog-central-search-card,
        .catalog-search-hint,
        .cat-pills-wrapper,
        .catalog-status-bar {
            position: relative;
            z-index: 1;
        }

        .catalog-hub-header {
            margin-bottom: 1.45rem;
        }

        .catalog-hub-tag {
            display: inline-block;
            font-size: .68rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            color: var(--ama);
            background: rgba(253, 196, 23, .12);
            border: 1px solid rgba(253, 196, 23, .35);
            padding: .35rem .85rem;
            border-radius: 999px;
            margin-bottom: .6rem;
            text-transform: uppercase;
        }

        .catalog-hub-title {
            font-size: clamp(1.8rem, 4vw, 2.65rem);
            font-weight: 800;
            color: #ffffff;
            margin-bottom: .35rem;
            letter-spacing: -.5px;
            line-height: 1.15;
        }

        .catalog-hub-title span {
            color: var(--ama) !important;
        }

        .catalog-hub-sub {
            font-size: .88rem;
            color: #bfc2c2;
            margin: 0;
            max-width: 620px;
            font-style: normal;
        }

        /* Barra central combinada: Input + Select */
        .catalog-central-search-card {
            display: flex;
            align-items: center;
            gap: .75rem;
            background: #ffffff;
            border: 2px solid rgba(253, 196, 23, .25);
            border-radius: 16px;
            padding: .45rem .55rem .45rem 1.1rem;
            box-shadow: 0 12px 28px rgba(0, 0, 0, .22);
            margin-bottom: 1.1rem;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

        .catalog-central-search-card:focus-within {
            border-color: var(--ama);
            box-shadow: 0 0 0 4px rgba(253, 196, 23, .16), 0 14px 34px rgba(0, 0, 0, .28);
            transform: translateY(-1px);
        }

        .catalog-search-input-group {
            display: flex;
            align-items: center;
            flex: 1;
            gap: .75rem;
        }

        .catalog-search-icon {
            width: 20px;
            height: 20px;
            color: var(--nar);
            flex-shrink: 0;
        }

        #catalogSearchInput {
            width: 100%;
            border: none;
            outline: none;
            font-family: Poppins, sans-serif;
            font-size: .92rem;
            font-weight: 600;
            color: var(--neg);
            background: transparent;
        }

        #catalogSearchInput::placeholder {
            color: #9aa0a6;
            font-weight: 400;
        }

        .catalog-search-clear-btn {
            border: none;
            background: #e4e6eb;
            color: #444;
            font-size: .75rem;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .2s;
        }

        .catalog-search-clear-btn:hover {
            background: var(--nar);
            color: #fff;
        }

        /* Selector de categoría integrado */
        .catalog-cat-select-group {
            display: flex;
            align-items: center;
            border-left: 1px solid #d9dce0;
            padding-left: .75rem;
            background: #f1f2f3;
            border-radius: 10px;
            padding: .25rem .65rem;
        }

        #catalogCategorySelect {
            border: none;
            outline: none;
            background: transparent;
            font-family: Poppins, sans-serif;
            font-size: .84rem;
            font-weight: 700;
            color: var(--neg);
            cursor: pointer;
        }

        /* Indicador de ayuda bajo la búsqueda */
        .catalog-search-hint {
            width: 100%;
            display: flex;
            justify-content: space-between;
            font-size: .75rem;
            color: #aeb3b3;
            margin: -.35rem 0 .9rem;
            padding: 0 .4rem;
        }

        .catalog-search-hint strong {
            color: var(--ama);
        }

        /* Panel de categorías desplazable horizontal */
        .cat-pills-wrapper {
            width: 100%;
            display: flex;
            align-items: center;
            gap: .5rem;
            position: relative;
            border: 1px solid rgba(255, 255, 255, .13);
            border-radius: 16px;
            padding: .45rem .45rem;
            background: rgba(0, 0, 0, .2);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, .04);
        }

        .cat-scroll-btn {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #303331;
            color: var(--ama);
            border: 1px solid rgba(253, 196, 23, .28);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            line-height: 1;
            cursor: pointer;
            flex-shrink: 0;
            transition: all .2s ease;
            user-select: none;
        }

        .cat-scroll-btn:hover {
            background: var(--ama);
            color: var(--neg);
            border-color: var(--ama);
            transform: scale(1.05);
        }

        .cat-pills-scroll {
            display: flex;
            align-items: center;
            gap: .5rem;
            overflow-x: auto;
            scroll-behavior: smooth;
            scrollbar-width: none;
            -ms-overflow-style: none;
            flex: 1;
            padding: .15rem 0;
        }

        .cat-pills-scroll::-webkit-scrollbar {
            display: none;
        }

        .cat-pill {
            white-space: nowrap;
            border: 1px solid rgba(255, 255, 255, .14);
            background: rgba(255, 255, 255, .08);
            color: #e6e7e7;
            padding: .48rem .95rem;
            border-radius: 999px;
            font-family: Poppins, sans-serif;
            font-size: .78rem;
            font-weight: 700;
            cursor: pointer;
            transition: all .2s ease;
        }

        .cat-pill:hover {
            background: rgba(253, 196, 23, .16);
            color: #ffffff;
            border-color: rgba(253, 196, 23, .55);
        }

        .cat-pill.active {
            background: var(--gw);
            color: var(--neg);
            border-color: transparent;
            box-shadow: 0 5px 14px rgba(253, 196, 23, .3);
            font-weight: 800;
        }

        /* Barra de estado discreta y centrada */
        .catalog-status-bar {
            display: inline-flex;
            align-items: center;
            gap: .8rem;
            margin-top: .9rem;
            padding: .35rem 1.1rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, .08);
            border: 1px solid rgba(255, 255, 255, .14);
            font-size: .77rem;
            color: #d0d3d3;
            align-self: center;
        }

        .catalog-status-count b {
            color: #ffffff;
        }

        .catalog-status-divider {
            color: #666;
        }

        .catalog-status-filter b {
            color: var(--ama);
        }

        .catalog-reset-link {
            background: none;
            border: none;
            color: var(--nar);
            font-family: Poppins, sans-serif;
            font-size: .75rem;
            font-weight: 700;
            cursor: pointer;
            text-decoration: underline;
            margin-left: .4rem;
        }

        .catalog-reset-link:hover {
            color: var(--ama);
        }

        /* ========================================================
           GRID DE TARJETAS DE PRODUCTO
           ======================================================== */
        .catalog-grid-motos {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.45rem;
        }

        /* Tarjeta individual estilo corporativo */
        .prod-card-moto {
            background: #ffffff;
            border: 1px solid #e0e2e5;
            border-top: 3.5px solid var(--ama);
            border-radius: 18px;
            padding: 1.15rem;
            display: flex;
            flex-direction: column;
            position: relative;
            box-shadow: 0 8px 22px rgba(25, 28, 31, .07);
            transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
            overflow: hidden;
            content-visibility: auto;
            contain-intrinsic-size: 0 380px;
        }

        .prod-card-moto:hover {
            transform: translateY(-8px);
            border-color: #c9cdd1;
            border-top-color: var(--nar);
            box-shadow: 0 20px 38px rgba(25, 28, 31, .14);
        }

        /* Badge superior derecho de código */
        .card-moto-badge {
            position: absolute;
            top: 1.4rem;
            right: 1.4rem;
            background: rgba(29, 29, 27, .92);
            color: var(--ama);
            border: 1px solid rgba(253, 196, 23, .45);
            font-size: .65rem;
            font-weight: 800;
            padding: .2rem .55rem;
            border-radius: 6px;
            letter-spacing: .5px;
            z-index: 2;
        }

        /* Recuadro visual del producto */
        .card-moto-media {
            width: 100%;
            height: 180px;
            border-radius: 13px;
            background:
                radial-gradient(circle at 50% 40%, rgba(255, 255, 255, .95), transparent 44%),
                linear-gradient(135deg, #f1f2f0, #e4e6e6);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: .9rem;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

        .card-moto-media::after {
            content: 'VER FICHA';
            position: absolute;
            left: .75rem;
            bottom: .65rem;
            padding: .2rem .5rem;
            border-radius: 5px;
            background: rgba(29, 29, 27, .82);
            color: #ffffff;
            font-size: .58rem;
            font-weight: 800;
            letter-spacing: 1px;
            opacity: 0;
            transform: translateY(4px);
            transition: opacity .2s ease, transform .2s ease;
        }

        .prod-card-moto:hover .card-moto-media::after {
            opacity: 1;
            transform: translateY(0);
        }

        .card-moto-emoji {
            font-size: 4.8rem;
            filter: drop-shadow(0 8px 16px rgba(0, 0, 0, .14));
            transition: transform .3s cubic-bezier(.175, .885, .32, 1.275);
            will-change: transform;
        }

        .prod-card-moto:hover .card-moto-emoji {
            transform: scale(1.1) translateY(-2px);
        }

        /* Marca y Categoría pequeña */
        .card-moto-brand {
            font-size: .65rem;
            font-weight: 800;
            color: var(--nar);
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: .25rem;
        }

        /* Título del Producto */
        .card-moto-title {
            font-size: .98rem;
            font-weight: 800;
            color: var(--neg);
            margin-bottom: .75rem;
            line-height: 1.25;
            cursor: pointer;
            transition: color .2s ease;
            font-style: normal;
            letter-spacing: -.2px;
        }

        .card-moto-title:hover {
            color: var(--nar);
        }

        /* Micro-especificaciones (Tela y Tallas) */
        .card-moto-specs {
            display: flex;
            flex-direction: column;
            gap: .35rem;
            background: #f3f5f5;
            border: 1px solid #e3e6e8;
            border-radius: 8px;
            padding: .5rem .75rem;
            margin-bottom: 1rem;
            font-size: .73rem;
            color: #555;
        }

        .card-moto-specs div {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-moto-specs span {
            font-weight: 600;
            color: #222;
        }

        /* Fila de Precios */
        .card-moto-price-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin-bottom: 1.05rem;
            margin-top: auto;
        }

        .card-moto-price {
            display: flex;
            align-items: baseline;
            gap: .25rem;
        }

        .card-moto-price b {
            font-size: 1.35rem;
            font-weight: 900;
            color: var(--neg);
        }

        .card-moto-price span {
            font-size: .75rem;
            color: #777;
            font-weight: 600;
        }

        .card-moto-bulk {
            font-size: .72rem;
            font-weight: 700;
            color: #a4420b;
            background: rgba(211, 89, 20, 0.08);
            padding: .2rem .55rem;
            border-radius: 6px;
            border: 1px solid rgba(211, 89, 20, 0.22);
        }

        /* Botones de acción */
        .card-moto-actions {
            display: flex;
            gap: .5rem;
        }

        .btn-moto-details {
            flex: 1;
            border: 1.5px solid var(--neg);
            background: var(--neg);
            color: #ffffff;
            border-radius: 999px;
            padding: .65rem 1rem;
            font-family: Poppins, sans-serif;
            font-size: .8rem;
            font-weight: 800;
            cursor: pointer;
            transition: all .2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
        }

        .btn-moto-details:hover {
            background: var(--gw);
            border-color: transparent;
            color: var(--neg);
            box-shadow: 0 6px 18px rgba(211, 89, 20, .35);
            transform: translateY(-1px);
        }

        .btn-moto-cart {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: #f1f2f4;
            border: 1px solid #d9dce0;
            color: var(--neg);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .2s ease;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .btn-moto-cart:hover {
            background: var(--gw);
            border-color: transparent;
            color: var(--neg);
            transform: scale(1.08);
            box-shadow: 0 4px 12px rgba(253, 196, 23, 0.45);
        }

        /* Modal Detalle de Producto */
        /* Modal Detalle de Producto Ampliado y Optimizado para Pantalla */
        .prod-modal-box {
            max-width: 820px;
            width: 94%;
            background: #171816;
            color: #ffffff;
            border: 1px solid rgba(253, 196, 23, 0.35);
            border-radius: 18px;
            padding: 1.25rem 1.6rem;
            position: relative;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85);
            max-height: 94vh;
            overflow-y: auto;
        }

        /* Pestañas de la Ficha Técnica (Detallado vs Mayorista) */
        .prod-modal-tabs {
            display: flex;
            background: #111211;
            padding: 3px;
            border-radius: 10px;
            margin: .55rem 0 .8rem;
            border: 1px solid rgba(255, 255, 255, 0.12);
            gap: 5px;
        }

        .modal-tab-btn {
            flex: 1;
            padding: .5rem .85rem;
            border-radius: 8px;
            border: 1px solid transparent;
            background: transparent;
            color: #9ca3af;
            font-family: 'Poppins', sans-serif;
            font-size: .82rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .45rem;
            transition: all .2s ease;
        }

        .modal-tab-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.05);
        }

        /* Estado Activo Detallado (Gama Acero / Titanio / Plata) */
        .modal-tab-btn.active-detal {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            color: #ffffff;
            border: 1px solid rgba(148, 163, 184, 0.45);
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.35);
        }

        /* Estado Activo Mayorista (Gama Oro / Fuego Unifortex) */
        .modal-tab-btn.active-mayor {
            background: linear-gradient(135deg, #fdc417 0%, #d97706 100%);
            color: #111827;
            font-weight: 800;
            border: 1px solid #fdc417;
            box-shadow: 0 3px 14px rgba(253, 196, 23, 0.4);
        }

        /* Botones de Selección Interactiva de Tallas */
        .modal-size-btn {
            padding: .28rem .65rem;
            border-radius: 7px;
            border: 1px solid rgba(255, 255, 255, 0.16);
            background: rgba(255, 255, 255, 0.05);
            color: #e5e7eb;
            font-family: 'Poppins', sans-serif;
            font-size: .78rem;
            font-weight: 700;
            cursor: pointer;
            transition: all .16s ease;
            user-select: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .modal-size-btn:hover,
        .modal-size-btn.active-size {
            background: var(--ama);
            color: #111110;
            border-color: var(--ama);
            font-weight: 800;
            box-shadow: 0 2px 8px rgba(253, 196, 23, 0.45);
            transform: scale(1.05);
        }

        .prod-modal-grid {
            display: grid;
            grid-template-columns: 220px 1fr;
            gap: 1.3rem;
            margin-top: .6rem;
        }

        @media (max-width: 640px) {
            .prod-modal-grid {
                grid-template-columns: 1fr;
            }
            .catalog-search-hint {
                flex-direction: column;
                gap: .25rem;
            }
        }

        .sec-dark {
            background: var(--gd);
            color: #fff
        }

        .sec-dark p {
            color: var(--gcl)
        }

        /* chatbot */
        #chatBtn {
            position: fixed !important;
            bottom: 24px;
            right: 24px;
            width: 62px;
            height: 62px;
            border-radius: 50%;
            background: var(--gw);
            border: none;
            cursor: pointer;
            z-index: 1010;
            box-shadow: 0 10px 30px rgba(211, 89, 20, .45), 0 0 0 2px rgba(253, 196, 23, .3);
            transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            outline: none;
        }

        #chatBtn:hover {
            transform: scale(1.08) translateY(-2px);
            box-shadow: 0 14px 35px rgba(211, 89, 20, .6), 0 0 0 3px rgba(253, 196, 23, .5);
        }

        #chatBtn:active {
            transform: scale(0.96);
        }

        .chat-btn-escudo {
            width: 38px;
            height: 38px;
            max-width: 38px;
            max-height: 38px;
            object-fit: contain;
            filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.35));
            transition: transform .25s ease;
            pointer-events: none;
            display: block;
        }

        #chatBtn:hover .chat-btn-escudo {
            transform: scale(1.12);
        }

        .chat-head-escudo {
            width: 28px;
            height: 28px;
            max-width: 28px;
            max-height: 28px;
            object-fit: contain;
            flex-shrink: 0;
            filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.35));
            display: block;
        }

        #chatBox {
            position: fixed;
            bottom: 98px;
            right: 24px;
            width: min(390px, calc(100vw - 32px));
            height: 560px;
            max-height: min(560px, calc(100dvh - 120px));
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 25px 70px rgba(0, 0, 0, .35), 0 0 0 1px rgba(0,0,0,.08);
            z-index: 1010;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border: 1px solid rgba(253, 196, 23, .25);
            transform: translateY(20px) scale(.95);
            opacity: 0;
            pointer-events: none;
            transition: transform .32s cubic-bezier(.34,1.56,.64,1), opacity .25s ease;
        }

        #chatBox.open {
            transform: translateY(0) scale(1);
            opacity: 1;
            pointer-events: auto;
        }

        /* Notificación proactiva (burbuja orientada hacia el botón flotante) */
        .chat-greeting-bubble {
            position: fixed;
            bottom: 96px;
            right: 28px;
            background: #1D1D1B;
            color: #fff;
            padding: .75rem 1.1rem;
            border-radius: 16px 16px 4px 16px;
            font-size: .8rem;
            font-family: Poppins, sans-serif;
            font-style: italic;
            font-weight: 600;
            box-shadow: 0 10px 35px rgba(0,0,0,.35), 0 0 0 1px rgba(253,196,23,.2);
            z-index: 1009;
            max-width: 230px;
            line-height: 1.35;
            animation: chatBubbleIn .5s cubic-bezier(.34,1.56,.64,1) forwards;
            cursor: pointer;
            transition: opacity .3s ease, transform .2s ease;
        }
        .chat-greeting-bubble:hover {
            transform: translateY(-2px);
        }
        .chat-greeting-bubble::after {
            content: '';
            position: absolute;
            bottom: -8px;
            right: 22px;
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-top: 8px solid #1D1D1B;
        }
        .chat-greeting-bubble .greeting-close {
            position: absolute;
            top: -6px;
            right: -6px;
            width: 18px;
            height: 18px;
            background: var(--nar);
            color: #fff;
            border: none;
            border-radius: 50%;
            font-size: .65rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
            transition: transform .2s ease;
        }
        .chat-greeting-bubble .greeting-close:hover {
            transform: scale(1.15);
        }
        @keyframes chatBubbleIn {
            0% { transform: translateY(10px) scale(.8); opacity: 0 }
            100% { transform: translateY(0) scale(1); opacity: 1 }
        }

        /* Badge de notificación en botón (sin romper position fixed) */
        .chat-notif-dot {
            position: absolute;
            top: 1px;
            right: 1px;
            width: 14px;
            height: 14px;
            background: #e53935;
            border-radius: 50%;
            border: 2.5px solid #fff;
            box-shadow: 0 2px 6px rgba(0,0,0,.3);
            animation: notifPulse 2s infinite;
            pointer-events: none;
        }
        @keyframes notifPulse {
            0%, 100% { transform: scale(1) }
            50% { transform: scale(1.3) }
        }

        .chat-head {
            background: linear-gradient(135deg, #1a1a18, #2a2a28);
            color: #fff;
            padding: .85rem 1.1rem;
            display: flex;
            align-items: center;
            gap: .75rem;
            position: relative;
            flex-shrink: 0;
            border-bottom: 1px solid rgba(253, 196, 23, .2);
            min-height: 58px;
            box-sizing: border-box;
        }

        .chat-head svg.chat-head-logo {
            width: 28px;
            height: 30px;
            flex-shrink: 0;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,.3));
        }

        .chat-head-info {
            display: flex;
            flex-direction: column;
            min-width: 0;
            flex: 1;
        }

        .chat-head b {
            font-style: italic;
            text-transform: uppercase;
            font-size: .85rem;
            letter-spacing: .3px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-head small {
            display: flex;
            align-items: center;
            gap: .35rem;
            font-size: .65rem;
            color: var(--ama);
        }
        .chat-head small::before {
            content: '';
            width: 7px;
            height: 7px;
            background: #4caf50;
            border-radius: 50%;
            display: inline-block;
            animation: onlinePulse 2.5s infinite;
        }
        @keyframes onlinePulse {
            0%, 100% { opacity: 1 }
            50% { opacity: .4 }
        }

        .chat-head-actions {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: .4rem;
            flex-shrink: 0;
        }

        .chat-head-btn {
            background: rgba(255, 255, 255, .08);
            border: 1px solid rgba(255, 255, 255, .12);
            color: rgba(255, 255, 255, .7);
            width: 30px;
            height: 30px;
            border-radius: 50%;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: .85rem;
            transition: all .2s ease;
            padding: 0;
            line-height: 1;
        }

        .chat-head-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, .18);
            border-color: rgba(255, 255, 255, .3);
            transform: scale(1.05);
        }

        .chat-head-btn.btn-close:hover {
            background: rgba(229, 57, 53, .85);
            border-color: #e53935;
            color: #fff;
        }

        #chatLog {
            flex: 1 1 0;
            min-height: 120px;
            overflow-y: auto;
            padding: 1rem;
            display: flex;
            flex-direction: column;
            gap: .55rem;
            background: linear-gradient(180deg, #fafafa 0%, #f5f4f0 100%);
            scroll-behavior: smooth;
        }
        #chatLog::-webkit-scrollbar { width: 4px }
        #chatLog::-webkit-scrollbar-thumb { background: rgba(0,0,0,.15); border-radius: 4px }

        .msg {
            max-width: 84%;
            padding: .65rem 1rem;
            border-radius: 16px;
            font-size: .8rem;
            font-style: italic;
            line-height: 1.45;
            animation: msgSlideIn .3s ease-out;
            word-break: break-word;
        }
        @keyframes msgSlideIn {
            from { transform: translateY(8px); opacity: 0 }
            to { transform: translateY(0); opacity: 1 }
        }

        .msg .msg-time {
            display: block;
            font-size: .6rem;
            opacity: .5;
            margin-top: .25rem;
            font-style: normal;
        }

        .bot {
            background: #fff;
            color: var(--neg);
            align-self: flex-start;
            border-bottom-left-radius: 4px;
            border: 1px solid rgba(0,0,0,.06);
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
        }

        .usr {
            background: linear-gradient(135deg, #FDC417, #D35914);
            color: #fff;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
            font-weight: 600;
            box-shadow: 0 2px 8px rgba(211,89,20,.25);
        }

        /* Indicador de "escribiendo..." */
        .typing-indicator {
            align-self: flex-start;
            display: flex;
            gap: 4px;
            padding: .7rem 1rem;
            background: #fff;
            border-radius: 16px 16px 16px 4px;
            border: 1px solid rgba(0,0,0,.06);
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
        }
        .typing-indicator span {
            width: 7px; height: 7px;
            background: #bbb;
            border-radius: 50%;
            animation: typingDot 1.4s infinite ease-in-out both;
        }
        .typing-indicator span:nth-child(1) { animation-delay: 0s }
        .typing-indicator span:nth-child(2) { animation-delay: .2s }
        .typing-indicator span:nth-child(3) { animation-delay: .4s }
        @keyframes typingDot {
            0%, 80%, 100% { transform: scale(.6); opacity: .4 }
            40% { transform: scale(1); opacity: 1 }
        }

        .opts {
            display: flex;
            flex-wrap: wrap;
            gap: .4rem;
            padding: .45rem .85rem .75rem;
            background: linear-gradient(180deg, #f5f4f0 0%, #fafafa 100%);
            border-top: 1px solid rgba(0,0,0,.04);
            max-height: 130px;
            overflow-y: auto;
            flex-shrink: 0;
        }
        .opts:empty {
            display: none;
            padding: 0;
            border: none;
        }
        .opts::-webkit-scrollbar { width: 3px; }
        .opts::-webkit-scrollbar-thumb { background: rgba(0,0,0,.15); border-radius: 3px; }

        .opts button {
            background: #fff;
            border: 1.5px solid var(--nar);
            color: var(--nar);
            padding: .4rem .85rem;
            border-radius: 999px;
            font-size: .72rem;
            font-style: italic;
            font-weight: 600;
            cursor: pointer;
            transition: all .25s ease;
            box-shadow: 0 1px 3px rgba(0,0,0,.06);
        }

        .opts button:hover {
            background: linear-gradient(135deg, #FDC417, #D35914);
            color: #fff;
            border-color: transparent;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(211,89,20,.3);
        }

        #chatForm {
            display: flex;
            border-top: 1px solid #eee;
            background: #fff;
            flex-shrink: 0;
        }

        #chatForm input {
            flex: 1;
            border: none;
            padding: .9rem 1rem;
            font-family: Poppins, sans-serif;
            font-size: .82rem;
            outline: none;
            background: transparent;
        }
        #chatForm input::placeholder { color: #bbb; font-style: italic }

        #chatForm button {
            background: linear-gradient(135deg, #FDC417, #D35914);
            border: none;
            padding: 0 1.3rem;
            font-weight: 800;
            cursor: pointer;
            font-size: 1.1rem;
            color: #fff;
            transition: filter .2s;
        }
        #chatForm button:hover { filter: brightness(1.1) }

        @media (max-width: 480px) {
            #chatBtn {
                bottom: 18px;
                right: 18px;
                width: 56px;
                height: 56px;
            }
            #chatBox {
                right: 12px;
                left: 12px;
                width: auto;
                bottom: 82px;
                height: calc(100dvh - 96px);
                max-height: calc(100dvh - 96px);
                border-radius: 16px;
            }
            .chat-greeting-bubble {
                right: 18px;
                bottom: 80px;
                max-width: 220px;
            }
        }

        /* modal */
        .modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, .75);
            z-index: 300;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 1rem
        }

        .modal.open {
            display: flex
        }

        .modal-box {
            background: #fff;
            border-radius: 20px;
            padding: 2rem;
            width: min(560px, 100%);
            max-height: 90vh;
            overflow: auto;
            position: relative
        }

        .modal-box h3 {
            margin-bottom: 1rem
        }

        .modal-box input,
        .modal-box select,
        .modal-box textarea {
            width: 100%;
            padding: .8rem;
            border: 1.5px solid #ddd;
            border-radius: 10px;
            margin-bottom: .8rem;
            font-family: Poppins;
            font-style: italic;
            font-size: .85rem
        }

        .modal-box input:focus,
        .modal-box textarea:focus {
            outline: none;
            border-color: var(--nar)
        }

        .close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--gri)
        }

        .dash-row {
            display: flex;
            justify-content: space-between;
            padding: .7rem 0;
            border-bottom: 1px solid #eee;
            font-size: .85rem;
            font-style: italic
        }

        footer {
            background: #0c0c0b;
            color: var(--gcl);
            padding: 3.5rem 0 1.5rem;
            font-size: .83rem;
            border-top: 1px solid rgba(253, 196, 23, 0.2);
            position: relative;
            z-index: 10;
        }

        footer .fg {
            display: grid;
            grid-template-columns: 1.15fr 0.75fr 2.1fr;
            gap: 2.2rem;
            margin-bottom: 2.5rem;
            align-items: start;
        }

        @media (max-width: 1024px) {
            footer .fg {
                grid-template-columns: 1fr 1fr;
                gap: 1.8rem;
            }
            .footer-col-maps {
                grid-column: 1 / -1;
            }
        }

        @media (max-width: 640px) {
            footer .fg {
                grid-template-columns: 1fr;
                gap: 1.8rem;
            }
        }

        footer h5 {
            color: var(--ama);
            text-transform: uppercase;
            font-style: normal;
            font-weight: 800;
            margin-bottom: .9rem;
            font-size: .85rem;
            letter-spacing: .5px;
            display: flex;
            align-items: center;
            gap: .4rem;
        }

        footer a {
            color: var(--gcl);
            text-decoration: none;
            display: block;
            padding: .25rem 0;
            transition: color .2s ease;
        }

        footer a:hover {
            color: var(--ama);
        }

        .footer-brand {
            display: flex;
            align-items: center;
            gap: .75rem;
            margin-bottom: .85rem;
        }

        .footer-logo-img {
            height: 38px;
            width: auto;
            object-fit: contain;
            filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.95)) drop-shadow(0 0 8px rgba(253, 196, 23, 0.5));
        }

        .footer-contact-pills {
            display: flex;
            flex-direction: column;
            gap: .45rem;
            margin-top: .85rem;
        }

        .footer-link-pill {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            color: #d1d5db !important;
            font-size: .78rem;
            padding: .3rem .6rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            width: fit-content;
            transition: all .2s ease;
        }

        .footer-link-pill:hover {
            background: rgba(253, 196, 23, 0.12);
            border-color: rgba(253, 196, 23, 0.35);
            color: var(--ama) !important;
            transform: translateX(3px);
        }

        .footer-social-wrapper {
            margin-top: .85rem;
            display: flex;
            flex-direction: column;
            gap: .35rem;
        }

        .footer-social-label {
            font-size: .72rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: .05em;
            color: var(--ama);
            display: flex;
            align-items: center;
            gap: .35rem;
        }

        .footer-social-chips {
            display: flex;
            flex-wrap: wrap;
            gap: .45rem;
        }

        .footer-social-pill {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            color: #d1d5db !important;
            font-size: .78rem;
            font-weight: 600;
            padding: .3rem .65rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 8px;
            transition: all .2s ease;
            text-decoration: none;
            cursor: pointer;
        }

        .footer-social-pill:hover {
            background: rgba(253, 196, 23, 0.15);
            border-color: var(--ama);
            color: var(--ama) !important;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        }

        /* Sedes en Google Maps dentro del Footer */
        .footer-col-maps {
            width: 100%;
        }

        .footer-maps-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.1rem;
            margin-top: .6rem;
        }

        @media (max-width: 680px) {
            .footer-maps-grid {
                grid-template-columns: 1fr;
            }
        }

        .footer-map-card {
            background: #141413;
            border: 1px solid rgba(253, 196, 23, 0.22);
            border-radius: 14px;
            padding: .85rem;
            display: flex;
            flex-direction: column;
            gap: .5rem;
            transition: border-color .25s ease, transform .25s ease, box-shadow .25s ease;
        }

        .footer-map-card:hover {
            border-color: var(--ama);
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55), 0 0 15px rgba(253, 196, 23, 0.15);
        }

        .footer-map-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .5rem;
        }

        .footer-map-badge {
            font-size: .76rem;
            font-weight: 800;
            color: var(--ama);
            text-transform: uppercase;
            letter-spacing: .5px;
            display: flex;
            align-items: center;
            gap: .3rem;
            font-style: normal;
        }

        .footer-map-btn {
            font-size: .68rem;
            font-weight: 800;
            color: var(--neg) !important;
            background: var(--gw);
            padding: .28rem .7rem;
            border-radius: 999px;
            text-decoration: none !important;
            display: inline-flex;
            align-items: center;
            gap: .25rem;
            transition: transform .2s ease, box-shadow .2s ease;
            white-space: nowrap;
            font-style: normal;
        }

        .footer-map-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 14px rgba(253, 196, 23, 0.45);
        }

        .footer-map-addr {
            font-size: .74rem;
            color: #d1d5db;
            margin: 0;
            line-height: 1.35;
            font-style: normal;
        }

        .footer-map-frame-wrap {
            position: relative;
            width: 100%;
            height: 135px;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: #1e1e1c;
        }

        .footer-map-iframe {
            width: 100%;
            height: 100%;
            border: none;
            display: block;
        }

        .footer-map-overlay-link {
            position: absolute;
            inset: 0;
            z-index: 2;
            cursor: pointer;
            text-decoration: none;
            background: rgba(0, 0, 0, 0);
            transition: background .2s ease;
            display: flex;
            align-items: flex-end;
            justify-content: flex-end;
            padding: .45rem;
        }

        .footer-map-overlay-link:hover {
            background: rgba(0, 0, 0, 0.15);
        }

        .footer-map-overlay-hint {
            background: rgba(29, 29, 27, 0.92);
            color: var(--ama);
            font-size: .65rem;
            font-weight: 700;
            padding: .22rem .55rem;
            border-radius: 6px;
            border: 1px solid rgba(253, 196, 23, 0.35);
            pointer-events: none;
            opacity: 0;
            transform: translateY(4px);
            transition: opacity .2s ease, transform .2s ease;
            font-style: normal;
        }

        .footer-map-frame-wrap:hover .footer-map-overlay-hint {
            opacity: 1;
            transform: translateY(0);
        }

        .footer-map-meta {
            font-size: .68rem;
            color: var(--gcl);
            font-style: italic;
        }

        .copy {
            border-top: 1px solid #222;
            padding-top: 1.2rem;
            text-align: center;
            font-size: .72rem
        }

        @media(max-width: 860px) {
            .hero-card-body {
                padding: 2.2rem 1.3rem
            }

            .hero-stats {
                gap: 1.6rem
            }

            nav ul {
                display: none
            }

            nav ul.open {
                display: flex;
                position: absolute;
                top: 100%;
                left: 0;
                right: 0;
                background: var(--neg);
                flex-direction: column;
                padding: 1rem;
                gap: 1rem
            }

            .menu-btn {
                display: block
            }
        }

        /* ===== ESTILOS: DISEÑO PERSONALIZADO ===== */
        .diseno-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 2rem;
            align-items: start;
        }

        .diseno-panel {
            background: #fff;
            border: 1px solid #eee;
            border-radius: 20px;
            padding: 2.2rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .04);
        }

        .diseno-preview-box {
            background: var(--gd);
            color: #fff;
            border-radius: 20px;
            padding: 2rem;
            position: sticky;
            top: 95px;
            border: 1px solid rgba(253, 196, 23, .25);
            box-shadow: 0 18px 45px rgba(0, 0, 0, .2);
        }

        .opt-group {
            margin-bottom: 1.4rem;
        }

        .opt-label {
            display: block;
            font-size: .75rem;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: var(--gri);
            margin-bottom: .6rem;
            font-style: italic;
        }

        .opt-chips {
            display: flex;
            gap: .5rem;
            flex-wrap: wrap;
        }

        .opt-chip {
            padding: .5rem 1.1rem;
            border-radius: 999px;
            border: 1.5px solid #ddd;
            background: #fafafa;
            font-family: Poppins;
            font-size: .78rem;
            font-style: italic;
            cursor: pointer;
            transition: .22s ease;
            font-weight: 600;
            color: var(--neg);
        }

        .opt-chip:hover {
            border-color: var(--nar);
            background: #fff;
            transform: translateY(-2px);
        }

        .opt-chip.active {
            background: var(--gw);
            border-color: transparent;
            color: var(--neg);
            font-weight: 800;
            box-shadow: 0 4px 14px rgba(211, 89, 20, .3);
        }

        .swatches-bar {
            display: flex;
            gap: .7rem;
            flex-wrap: wrap;
            align-items: center;
        }

        .swatch-circle {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            border: 3px solid transparent;
            transition: .2s ease;
            box-shadow: 0 2px 6px rgba(0, 0, 0, .25);
        }

        .swatch-circle:hover {
            transform: scale(1.15);
        }

        .swatch-circle.active {
            border-color: var(--ama);
            transform: scale(1.18);
            box-shadow: 0 0 0 2px #fff inset;
        }

        /* Barra de ángulos interactivos */
        .diseno-angle-nav {
            display: flex;
            gap: .4rem;
            background: rgba(0, 0, 0, .45);
            padding: .35rem;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, .1);
            margin-bottom: .85rem;
        }

        .diseno-angle-btn {
            flex: 1;
            padding: .45rem .5rem;
            background: transparent;
            border: none;
            border-radius: 8px;
            color: var(--gcl);
            font-family: Poppins, sans-serif;
            font-size: .72rem;
            font-weight: 700;
            font-style: italic;
            cursor: pointer;
            transition: all .2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: .3rem;
            white-space: nowrap;
        }

        .diseno-angle-btn:hover {
            color: #fff;
            background: rgba(255, 255, 255, .08);
        }

        .diseno-angle-btn.active {
            background: var(--gw);
            color: var(--neg);
            box-shadow: 0 4px 12px rgba(211, 89, 20, .35);
        }

        /* Mockup Studio Stage */
        .preview-stage {
            background: radial-gradient(circle at 50% 35%, #2a2a28 0%, #111110 100%);
            border: 1px solid rgba(253, 196, 23, .25);
            border-radius: 18px;
            padding: 1rem;
            text-align: center;
            margin-bottom: .85rem;
            position: relative;
            min-height: 410px;
            height: 420px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            box-shadow: inset 0 0 40px rgba(0, 0, 0, .8), 0 10px 25px rgba(0, 0, 0, .4);
            user-select: none;
            touch-action: none;
        }

        .stage-lighting {
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 50% 30%, rgba(253, 196, 23, 0.08) 0%, transparent 65%);
        }

        .mockup-svg-wrap {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
            filter: drop-shadow(0 16px 28px rgba(0, 0, 0, .6));
            transition: transform .25s ease;
        }

        .mockup-svg-wrap svg {
            width: auto;
            height: 380px;
            max-width: 96%;
            object-fit: contain;
            transition: all .25s ease;
        }

        /* Capa interactiva de logos arrastrables */
        .diseno-drag-layer {
            position: absolute;
            inset: 0;
            z-index: 10;
            pointer-events: none;
        }

        /* Cada logo colocado sobre la prenda */
        .placed-logo-item {
            position: absolute;
            pointer-events: auto;
            cursor: grab;
            touch-action: none;
            user-select: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            border: 1.5px dashed transparent;
            transition: border-color .15s ease, box-shadow .15s ease;
            z-index: 15;
        }

        .placed-logo-item:hover {
            border-color: rgba(253, 196, 23, .65);
            background: rgba(253, 196, 23, .08);
        }

        .placed-logo-item.active {
            border-color: var(--ama);
            background: rgba(253, 196, 23, .12);
            box-shadow: 0 0 20px rgba(253, 196, 23, .55);
            cursor: grabbing;
            z-index: 30;
        }

        .logo-graphic-wrap {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.05s ease-out;
            pointer-events: auto;
            cursor: grab;
        }

        .placed-logo-item.active .logo-graphic-wrap {
            cursor: grabbing;
        }

        .placed-logo-item img {
            max-height: 100%;
            max-width: 100%;
            display: block;
            pointer-events: none;
            filter: drop-shadow(0 3px 6px rgba(0,0,0,.45));
        }

        .placed-logo-item .text-badge {
            background: rgba(253, 196, 23, .2);
            border: 1.5px dashed var(--ama);
            color: var(--ama);
            padding: 5px 12px;
            border-radius: 6px;
            font-size: .8rem;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-style: italic;
            white-space: nowrap;
            pointer-events: none;
        }

        /* Barra flotante interactiva de tamaño con círculo deslizante */
        .logo-resize-bar-wrap {
            position: absolute;
            bottom: calc(100% + 12px);
            left: 50%;
            transform: translateX(-50%);
            background: rgba(14, 14, 14, 0.96);
            border: 1.5px solid var(--ama);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.8), 0 0 16px rgba(253, 196, 23, 0.4);
            border-radius: 30px;
            padding: 6px 12px;
            display: none;
            align-items: center;
            gap: 8px;
            z-index: 100;
            pointer-events: auto;
            white-space: nowrap;
            backdrop-filter: blur(10px);
            user-select: none;
            animation: fadeInPop 0.18s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .logo-resize-bar-wrap.placed-bottom {
            bottom: auto;
            top: calc(100% + 12px);
        }

        @keyframes fadeInPop {
            from { opacity: 0; transform: translateX(-50%) scale(0.85); }
            to { opacity: 1; transform: translateX(-50%) scale(1); }
        }

        .placed-logo-item.active .logo-resize-bar-wrap {
            display: flex;
        }

        .logo-resize-header {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 0.72rem;
            font-weight: 700;
            color: #fff;
            font-family: Poppins, sans-serif;
        }

        .logo-resize-pct {
            color: var(--ama);
            font-weight: 800;
            min-width: 38px;
            text-align: right;
            font-size: 0.75rem;
        }

        .logo-slider-track-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .slider-hint {
            color: var(--gcl);
            font-size: 0.85rem;
            font-weight: 800;
            cursor: pointer;
            user-select: none;
            transition: color .15s ease;
        }

        .slider-hint:hover {
            color: #fff;
        }

        /* Barra con círculo interactivo */
        .logo-range-slider {
            -webkit-appearance: none;
            appearance: none;
            width: 105px;
            height: 6px;
            background: rgba(255, 255, 255, 0.22);
            border-radius: 4px;
            outline: none;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .logo-range-slider:hover {
            background: rgba(255, 255, 255, 0.38);
        }

        /* El círculo del control deslizante */
        .logo-range-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #fdc417;
            border: 2px solid #ffffff;
            box-shadow: 0 0 10px rgba(253, 196, 23, 0.95), 0 2px 6px rgba(0, 0, 0, 0.7);
            cursor: grab;
            transition: transform 0.15s ease, background 0.15s ease;
        }

        .logo-range-slider::-webkit-slider-thumb:hover,
        .logo-range-slider::-webkit-slider-thumb:active {
            transform: scale(1.28);
            background: #ffaa00;
            box-shadow: 0 0 16px rgba(253, 196, 23, 1), 0 3px 8px rgba(0, 0, 0, 0.85);
            cursor: grabbing;
        }

        .logo-range-slider::-moz-range-thumb {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: #fdc417;
            border: 2px solid #ffffff;
            box-shadow: 0 0 10px rgba(253, 196, 23, 0.95), 0 2px 6px rgba(0, 0, 0, 0.7);
            cursor: grab;
        }

        .logo-quick-actions {
            display: flex;
            align-items: center;
            gap: 4px;
            margin-left: 2px;
            border-left: 1px solid rgba(255, 255, 255, 0.2);
            padding-left: 6px;
        }

        .btn-logo-action {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #fff;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            font-size: 0.7rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            padding: 0;
        }

        .btn-logo-action:hover {
            background: var(--ama);
            color: #111;
            border-color: var(--ama);
            transform: scale(1.15);
        }

        .btn-logo-action.btn-del:hover {
            background: #ff4d4d;
            border-color: #ff4d4d;
            color: #fff;
        }

        /* ===== TARJETAS INFORMATIVAS DE CONTACTO (4 EN LÍNEA) ===== */
        .contact-cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
            margin: 1.5rem 0 2rem;
            text-align: left;
        }

        @media (max-width: 1024px) {
            .contact-cards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 580px) {
            .contact-cards-grid {
                grid-template-columns: 1fr;
            }
        }

        .contact-info-card {
            background: rgba(24, 24, 22, 0.94);
            border: 1px solid rgba(253, 196, 23, 0.22);
            border-radius: 16px;
            padding: 1.15rem 1rem;
            display: flex;
            flex-direction: column;
            gap: .8rem;
            transition: all .28s cubic-bezier(0.165, 0.84, 0.44, 1);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
            backdrop-filter: blur(10px);
            position: relative;
            overflow: hidden;
        }

        .contact-info-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--ama), transparent);
            opacity: 0.6;
            transition: opacity .25s ease;
        }

        .contact-info-card:hover {
            transform: translateY(-4px);
            border-color: var(--ama);
            box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35), 0 0 20px rgba(253, 196, 23, 0.22);
        }

        .contact-info-card:hover::before {
            opacity: 1;
        }

        .contact-card-header {
            display: flex;
            align-items: center;
            gap: .7rem;
        }

        .contact-card-ico {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(253, 196, 23, 0.12);
            border: 1.5px solid rgba(253, 196, 23, 0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
            box-shadow: 0 4px 12px rgba(0,0,0,.25);
        }

        .contact-card-title {
            font-size: .88rem;
            font-weight: 800;
            color: #fff;
            margin: 0;
            font-style: italic;
            text-transform: uppercase;
            letter-spacing: .5px;
            line-height: 1.2;
        }

        .contact-card-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: .65rem;
        }

        .contact-card-item {
            font-size: .76rem;
            color: var(--gcl);
            line-height: 1.4;
            display: flex;
            flex-direction: column;
            gap: .15rem;
        }

        .contact-card-item strong {
            color: #fff;
            font-size: .78rem;
            display: flex;
            align-items: center;
            gap: .35rem;
        }

        .contact-link {
            color: var(--ama);
            text-decoration: none;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            transition: all .2s ease;
            font-style: normal;
            font-size: .78rem;
        }

        .contact-link:hover {
            color: #fff;
            text-decoration: underline;
            transform: translateX(2px);
        }

        .contact-phone-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: .45rem .65rem;
            border-radius: 8px;
            transition: all .2s ease;
        }

        .contact-phone-row:hover {
            background: rgba(253, 196, 23, 0.09);
            border-color: rgba(253, 196, 23, 0.35);
        }

        .social-chips-list {
            display: flex;
            flex-direction: column;
            gap: .45rem;
        }

        .social-chip-btn {
            display: inline-flex;
            align-items: center;
            justify-content: space-between;
            padding: .45rem .7rem;
            border-radius: 9px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #fff;
            text-decoration: none;
            font-size: .76rem;
            font-weight: 600;
            font-style: normal;
            transition: all .22s ease;
        }

        .social-chip-btn:hover {
            background: rgba(253, 196, 23, 0.16);
            border-color: var(--ama);
            color: var(--ama);
            transform: translateX(3px);
        }

        .contact-badge-pill {
            display: inline-block;
            font-size: .65rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 2px 7px;
            border-radius: 6px;
            background: rgba(253, 196, 23, 0.15);
            border: 1px solid rgba(253, 196, 23, 0.35);
            color: var(--ama);
            margin-top: .2rem;
            width: fit-content;
        }

        .contact-form-box {
            background: rgba(18, 18, 16, 0.95);
            border: 1px solid rgba(253, 196, 23, 0.2);
            border-radius: 22px;
            padding: 2rem 2.2rem;
            box-shadow: 0 12px 35px rgba(0,0,0,0.25);
            max-width: 820px;
            margin: 0 auto;
            color: #fff;
        }

        .contact-form-box h3 {
            color: #ffffff !important;
        }



        /* Barra de herramientas de diseño */
        .diseno-quick-toolbar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            flex-wrap: wrap;
            margin-bottom: .85rem;
        }

        .diseno-quick-btn {
            background: rgba(255, 255, 255, .08);
            border: 1px solid rgba(255, 255, 255, .15);
            color: #fff;
            padding: .4rem .75rem;
            border-radius: 8px;
            font-size: .72rem;
            font-weight: 700;
            font-style: italic;
            cursor: pointer;
            transition: all .2s ease;
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }

        .diseno-quick-btn:hover {
            background: rgba(253, 196, 23, .2);
            border-color: var(--ama);
            color: var(--ama);
            transform: translateY(-1px);
        }

        .diseno-quick-btn.active-flag {
            background: var(--gw);
            color: var(--neg);
            border-color: transparent;
        }

        .diseno-quick-btn.danger:hover {
            background: rgba(255, 82, 82, .2);
            border-color: #ff5252;
            color: #ff7777;
        }

        .uploaded-logo-card {
            display: flex;
            align-items: center;
            gap: .8rem;
            background: #f8f9fa;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: .75rem 1rem;
            margin-top: .8rem;
        }

        .uploaded-logo-thumb {
            width: 48px;
            height: 48px;
            background: repeating-conic-gradient(#eee 0% 25%, transparent 0% 50%) 50% / 12px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            flex-shrink: 0;
        }

        .uploaded-logo-thumb img {
            max-width: 90%;
            max-height: 90%;
            object-fit: contain;
        }

        /* ===== ESTILOS: ORDEN DE COMPRA ===== */
        .oc-top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.4rem;
            margin-bottom: 2.2rem;
            padding: clamp(1.4rem, 3.2vw, 2.2rem);
            background:
                radial-gradient(circle at 92% 0%, rgba(211, 89, 20, .28), transparent 30%),
                linear-gradient(135deg, #171817 0%, #272826 58%, #111211 100%);
            border: 1px solid rgba(253, 196, 23, .28);
            border-radius: 26px;
            box-shadow: 0 20px 50px rgba(20, 22, 22, .2);
            color: #fff;
            position: relative;
            overflow: hidden;
        }

        .oc-top-bar::after {
            content: '';
            position: absolute;
            width: 200px;
            height: 200px;
            right: -90px;
            bottom: -110px;
            border: 1px solid rgba(253, 196, 23, .22);
            border-radius: 50%;
            box-shadow: 0 0 0 18px rgba(253, 196, 23, .04), 0 0 0 38px rgba(253, 196, 23, .03);
            pointer-events: none;
        }

        /* Tarjeta superior corporativa para Contacto & Cotizaciones */
        .contact-header-hub {
            max-width: 1080px;
            margin: 0 auto 2.4rem;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            text-align: left;
            padding: clamp(1.4rem, 3.2vw, 2.3rem);
            border: 1px solid rgba(253, 196, 23, .28);
            border-radius: 28px;
            background:
                radial-gradient(circle at 92% 0%, rgba(211, 89, 20, .28), transparent 30%),
                linear-gradient(135deg, #171817 0%, #272826 58%, #111211 100%);
            box-shadow: 0 24px 55px rgba(20, 22, 22, .2);
            position: relative;
            overflow: hidden;
            color: #fff;
        }

        .contact-header-hub::after {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            right: -100px;
            bottom: -120px;
            border: 1px solid rgba(253, 196, 23, .25);
            border-radius: 50%;
            box-shadow: 0 0 0 20px rgba(253, 196, 23, .04), 0 0 0 42px rgba(253, 196, 23, .03);
            pointer-events: none;
        }

        .contact-hub-header {
            position: relative;
            z-index: 2;
        }

        .contact-hub-tag {
            display: inline-block;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--ama);
            background: rgba(253, 196, 23, .12);
            border: 1px solid rgba(253, 196, 23, .3);
            padding: .35rem .75rem;
            border-radius: 999px;
            margin-bottom: .6rem;
        }

        .contact-hub-title {
            font-size: clamp(1.5rem, 3.2vw, 2.2rem);
            font-weight: 800;
            color: #fff;
            margin: 0 0 .5rem;
            line-height: 1.15;
        }

        .contact-hub-sub {
            font-size: clamp(.84rem, 1.4vw, .95rem);
            color: #bfc2c2;
            margin: 0;
            max-width: 780px;
            line-height: 1.5;
        }

        .contact-hub-pills {
            display: flex;
            flex-wrap: wrap;
            gap: .6rem;
            margin-top: 1.2rem;
            position: relative;
            z-index: 2;
        }

        .contact-hub-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            font-size: .75rem;
            font-weight: 600;
            color: #e5e7eb;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            padding: .32rem .7rem;
            border-radius: 999px;
        }

        /* Tarjeta superior corporativa para Taller de Diseño */
        .diseno-header-hub {
            max-width: 1080px;
            margin: 0 auto 2.4rem;
            display: flex;
            flex-direction: column;
            align-items: stretch;
            text-align: left;
            padding: clamp(1.4rem, 3.2vw, 2.3rem);
            border: 1px solid rgba(253, 196, 23, .28);
            border-radius: 28px;
            background:
                radial-gradient(circle at 92% 0%, rgba(211, 89, 20, .28), transparent 30%),
                linear-gradient(135deg, #171817 0%, #272826 58%, #111211 100%);
            box-shadow: 0 24px 55px rgba(20, 22, 22, .2);
            position: relative;
            overflow: hidden;
            color: #fff;
        }

        .diseno-header-hub::after {
            content: '';
            position: absolute;
            width: 220px;
            height: 220px;
            right: -100px;
            bottom: -120px;
            border: 1px solid rgba(253, 196, 23, .25);
            border-radius: 50%;
            box-shadow: 0 0 0 20px rgba(253, 196, 23, .04), 0 0 0 42px rgba(253, 196, 23, .03);
            pointer-events: none;
        }

        .diseno-hub-header {
            position: relative;
            z-index: 2;
        }

        .diseno-hub-tag {
            display: inline-block;
            font-size: .72rem;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--ama);
            background: rgba(253, 196, 23, .12);
            border: 1px solid rgba(253, 196, 23, .3);
            padding: .35rem .75rem;
            border-radius: 999px;
            margin-bottom: .6rem;
        }

        .diseno-hub-title {
            font-size: clamp(1.5rem, 3.2vw, 2.2rem);
            font-weight: 800;
            color: #fff;
            margin: 0 0 .5rem;
            line-height: 1.15;
        }

        .diseno-hub-sub {
            font-size: clamp(.84rem, 1.4vw, .95rem);
            color: #bfc2c2;
            margin: 0;
            max-width: 780px;
            line-height: 1.5;
        }

        .diseno-hub-pills {
            display: flex;
            flex-wrap: wrap;
            gap: .6rem;
            margin-top: 1.2rem;
            position: relative;
            z-index: 2;
        }

        .diseno-hub-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            font-size: .75rem;
            font-weight: 600;
            color: #e5e7eb;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            padding: .32rem .7rem;
            border-radius: 999px;
        }

        .oc-grid {
            display: grid;
            grid-template-columns: 1.25fr 0.75fr;
            gap: 2rem;
            align-items: start;
        }

        .oc-card {
            background: #fff;
            border-radius: 20px;
            padding: 2.2rem;
            color: var(--neg);
            border: 1px solid #eee;
            box-shadow: 0 10px 30px rgba(0, 0, 0, .04);
        }

        .oc-table {
            width: 100%;
            border-collapse: collapse;
            margin: 1.2rem 0;
            font-size: .83rem;
        }

        .oc-table th {
            text-align: left;
            padding: .65rem;
            border-bottom: 2px solid var(--ama);
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--gri);
            font-style: italic;
        }

        .oc-table td {
            padding: .75rem .65rem;
            border-bottom: 1px solid #eee;
            vertical-align: middle;
            font-style: italic;
        }

        .oc-summary-card {
            background: var(--gd);
            color: #fff;
            border-radius: 20px;
            padding: 2rem;
            position: sticky;
            top: 95px;
            border: 1px solid rgba(253, 196, 23, .25);
            box-shadow: 0 18px 45px rgba(0, 0, 0, .25);
        }

        @media(max-width: 920px) {
            .diseno-grid,
            .oc-grid {
                grid-template-columns: 1fr;
            }

            .diseno-preview-box,
            .oc-summary-card {
                position: static;
            }
        }

        /* ===== SISTEMA DE PESTAÑAS Y DESLIZAMIENTO HORIZONTAL ===== */
        .views-viewport {
            width: 100%;
            overflow-x: hidden;
            position: relative;
            min-height: calc(100vh - 170px);
            background: #fff;
        }

        .tab-view {
            display: none;
            width: 100%;
            min-height: 100%;
        }

        .tab-view.active {
            display: block;
        }

        /* Animaciones de deslizamiento horizontal izquierda/derecha */
        .tab-view.sliding-out-left {
            display: block !important;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1;
            pointer-events: none;
            animation: slideOutToLeft .4s cubic-bezier(.25, 1, .5, 1) forwards;
        }

        .tab-view.sliding-in-right {
            display: block !important;
            width: 100%;
            z-index: 2;
            animation: slideInFromRight .4s cubic-bezier(.25, 1, .5, 1) forwards;
        }

        .tab-view.sliding-out-right {
            display: block !important;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1;
            pointer-events: none;
            animation: slideOutToRight .4s cubic-bezier(.25, 1, .5, 1) forwards;
        }

        .tab-view.sliding-in-left {
            display: block !important;
            width: 100%;
            z-index: 2;
            animation: slideInFromLeft .4s cubic-bezier(.25, 1, .5, 1) forwards;
        }

        .tab-view.sliding-out-left,
        .tab-view.sliding-in-right,
        .tab-view.sliding-out-right,
        .tab-view.sliding-in-left {
            will-change: transform, opacity;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            contain: layout style;
        }

        @keyframes slideInFromRight {
            0% {
                transform: translate3d(100%, 0, 0);
                opacity: .3;
            }

            100% {
                transform: translate3d(0, 0, 0);
                opacity: 1;
            }
        }

        @keyframes slideOutToLeft {
            0% {
                transform: translate3d(0, 0, 0);
                opacity: 1;
            }

            100% {
                transform: translate3d(-100%, 0, 0);
                opacity: .1;
            }
        }

        @keyframes slideInFromLeft {
            0% {
                transform: translate3d(-100%, 0, 0);
                opacity: .3;
            }

            100% {
                transform: translate3d(0, 0, 0);
                opacity: 1;
            }
        }

        @keyframes slideOutToRight {
            0% {
                transform: translate3d(0, 0, 0);
                opacity: 1;
            }

            100% {
                transform: translate3d(100%, 0, 0);
                opacity: .1;
            }
        }

        /* ========================================================
           DRAWER DE CARRITO (DESPLIEGUE DERECHA A IZQUIERDA)
           ======================================================== */
        .cart-drawer-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.76);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            z-index: 2998 !important;
            opacity: 0;
            pointer-events: none;
            transition: opacity .35s ease;
            touch-action: none;
            overscroll-behavior: contain;
        }

        .cart-drawer-overlay.open {
            opacity: 1;
            pointer-events: auto;
        }

        .cart-drawer {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            height: 100vh;
            height: 100dvh;
            width: min(460px, 100vw);
            background: linear-gradient(180deg, #1c1c1a 0%, #121211 100%);
            border-left: 1.5px solid rgba(253, 196, 23, 0.3);
            box-shadow: -15px 0 50px rgba(0, 0, 0, 0.88);
            z-index: 2999 !important;
            transform: translateX(100%);
            transition: transform .36s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            color: #fff;
            overflow: hidden;
            overscroll-behavior: contain;
        }

        .cart-drawer.open {
            transform: translateX(0);
        }

        /* Cabecera del Drawer (Visible y nunca tapada por el Header de navegación) */
        .cart-drawer-header {
            padding: 1.35rem 1.4rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(253, 196, 23, 0.2);
            background: #181816;
            position: sticky;
            top: 0;
            z-index: 10;
            flex-shrink: 0;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        }

        .cart-drawer-title-box {
            display: flex;
            flex-direction: column;
            gap: .25rem;
        }

        .cart-drawer-title {
            font-size: 1.18rem;
            font-weight: 800;
            font-style: italic;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: .5rem;
            margin: 0;
        }

        .cart-drawer-title span.cart-ico {
            color: var(--ama);
            font-size: 1.25rem;
        }

        .cart-count-pill {
            font-size: .68rem;
            background: rgba(253, 196, 23, 0.15);
            color: var(--ama);
            border: 1px solid rgba(253, 196, 23, 0.35);
            border-radius: 999px;
            padding: .15rem .6rem;
            font-weight: 800;
            letter-spacing: 0;
            font-style: normal;
        }

        .cart-drawer-sub {
            font-size: .75rem;
            color: var(--gcl);
            font-style: italic;
            margin: 0;
        }

        /* Botón equis de cerrar - amplio, contrastado y nunca cortado */
        .cart-drawer-close {
            background: rgba(255, 255, 255, 0.12);
            border: 1.5px solid rgba(253, 196, 23, 0.4);
            color: #ffffff;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.15rem;
            font-weight: 800;
            transition: all .2s ease;
            flex-shrink: 0;
            margin-left: .5rem;
        }

        .cart-drawer-close:hover {
            background: var(--nar);
            border-color: var(--nar);
            color: #fff;
            transform: rotate(90deg) scale(1.08);
            box-shadow: 0 4px 14px rgba(211, 89, 20, 0.5);
        }

        /* Cuerpo / Lista de Productos con scroll independiente sin bloquear ni mover el fondo */
        .cart-drawer-body {
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
            overscroll-behavior: contain;
            padding: 1.25rem 1.4rem;
            display: flex;
            flex-direction: column;
            gap: .85rem;
            scrollbar-width: thin;
            scrollbar-color: var(--ama) rgba(255, 255, 255, 0.06);
        }

        .cart-drawer-body::-webkit-scrollbar {
            width: 6px;
        }

        .cart-drawer-body::-webkit-scrollbar-thumb {
            background: var(--ama);
            border-radius: 4px;
        }

        /* Tarjeta de ítem individual dentro del drawer */
        .cart-drawer-item {
            background: #222220;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: .95rem 1rem;
            display: flex;
            flex-direction: column;
            gap: .7rem;
            transition: border-color .2s ease, transform .15s ease;
        }

        .cart-drawer-item:hover {
            border-color: rgba(253, 196, 23, 0.4);
            transform: translateY(-1px);
        }

        .cart-item-top {
            display: flex;
            align-items: center;
            gap: .85rem;
        }

        .cart-item-ico {
            font-size: 2.2rem;
            background: #141412;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 10px;
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .cart-item-info {
            flex: 1;
            min-width: 0;
        }

        .cart-item-name {
            font-size: .88rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: .2rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .cart-item-cat {
            font-size: .7rem;
            color: var(--nar);
            font-weight: 700;
            text-transform: uppercase;
        }

        .cart-item-del-btn {
            background: none;
            border: none;
            color: #ff5252;
            font-size: 1.15rem;
            cursor: pointer;
            padding: .3rem;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all .2s;
        }

        .cart-item-del-btn:hover {
            background: rgba(255, 82, 82, 0.15);
            transform: scale(1.15);
        }

        .cart-item-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            padding-top: .65rem;
        }

        .cart-qty-ctrl {
            display: inline-flex;
            align-items: center;
            background: #151514;
            border: 1px solid rgba(253, 196, 23, 0.3);
            border-radius: 999px;
            padding: .2rem;
            gap: .3rem;
        }

        .cart-qty-btn {
            background: rgba(255, 255, 255, 0.08);
            border: none;
            color: #fff;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            cursor: pointer;
            font-weight: 800;
            font-size: .85rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s;
        }

        .cart-qty-btn:hover {
            background: var(--nar);
            color: #fff;
        }

        .cart-qty-num {
            font-size: .85rem;
            font-weight: 800;
            color: #fff;
            min-width: 26px;
            text-align: center;
        }

        .cart-item-pricing {
            text-align: right;
        }

        .cart-item-unit-price {
            font-size: .72rem;
            color: var(--gcl);
        }

        .cart-item-total-price {
            font-size: .95rem;
            font-weight: 800;
            color: var(--ama);
        }

        /* Estado Vacío dentro del Drawer */
        .cart-drawer-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 3rem 1rem;
            color: var(--gcl);
            margin: auto;
        }

        .cart-drawer-empty-ico {
            font-size: 4rem;
            margin-bottom: 1rem;
            filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.5));
            opacity: .6;
        }

        .cart-drawer-empty h4 {
            font-size: 1.15rem;
            font-weight: 800;
            color: #fff;
            margin-bottom: .4rem;
        }

        .cart-drawer-empty p {
            font-size: .82rem;
            max-width: 280px;
            margin-bottom: 1.5rem;
            color: #aaa;
        }

        /* Pie del Drawer: Totales y Botón de checkout */
        .cart-drawer-footer {
            background: #141413;
            border-top: 1px solid rgba(253, 196, 23, 0.2);
            padding: 1.25rem 1.4rem;
            box-shadow: 0 -10px 25px rgba(0, 0, 0, 0.4);
            flex-shrink: 0;
            position: sticky;
            bottom: 0;
            z-index: 10;
        }

        .cart-drawer-totals-box {
            display: flex;
            flex-direction: column;
            gap: .4rem;
            margin-bottom: 1rem;
        }

        .cart-total-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: .82rem;
            color: var(--gcl);
        }

        .cart-total-row.main-total {
            font-size: 1.25rem;
            font-weight: 800;
            font-style: italic;
            color: #fff;
            padding-top: .6rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: .2rem;
        }

        .cart-total-row.main-total span:last-child {
            color: var(--ama);
            text-shadow: 0 0 12px rgba(253, 196, 23, 0.4);
        }

        .btn-confirmar-compra {
            width: 100%;
            background: var(--gw);
            color: var(--neg);
            border: none;
            border-radius: 999px;
            padding: .95rem;
            font-family: Poppins, sans-serif;
            font-size: .9rem;
            font-weight: 800;
            font-style: italic;
            text-transform: uppercase;
            cursor: pointer;
            transition: all .25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .5rem;
            box-shadow: 0 8px 20px rgba(211, 89, 20, 0.35);
        }

        .btn-confirmar-compra:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(211, 89, 20, 0.55);
        }

        .cart-drawer-actions-sub {
            display: flex;
            gap: .65rem;
            margin-top: .85rem;
        }

        .btn-drawer-sec {
            flex: 1.4;
            padding: .65rem .85rem;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.16);
            color: #e5e7eb;
            font-family: 'Poppins', sans-serif;
            font-size: .78rem;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: all .25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .4rem;
        }

        .btn-drawer-sec:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(253, 196, 23, 0.6);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .btn-drawer-clear {
            flex: 1;
            padding: .65rem .85rem;
            background: rgba(239, 68, 68, 0.06);
            border: 1px solid rgba(239, 68, 68, 0.25);
            color: #fca5a5;
            font-family: 'Poppins', sans-serif;
            font-size: .78rem;
            font-weight: 600;
            border-radius: 10px;
            cursor: pointer;
            transition: all .25s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
        }

        .btn-drawer-clear:hover {
            background: rgba(239, 68, 68, 0.18);
            border-color: #ef4444;
            color: #ffffff;
            transform: translateY(-1px);
        }

        .cart-drawer-b2b-note {
            text-align: center;
            font-size: .68rem;
            color: var(--gcl);
            margin-top: .85rem;
            opacity: .9;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: .35rem;
            line-height: 1.4;
        }

        /* Badge del Carrito en el Menú Superior */
        .nav-cart-badge {
            background: var(--gw);
            color: var(--neg);
            font-size: .65rem;
            font-weight: 800;
            padding: .1rem .4rem;
            border-radius: 999px;
            min-width: 18px;
            height: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
            box-shadow: 0 0 10px rgba(253, 196, 23, 0.6);
            transition: transform .2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            font-style: normal;
        }

        .nav-cart-badge.bump {
            transform: scale(1.35);
        }

        /* Toast flotante de notificación */
        .unifortex-toast {
            position: fixed;
            bottom: 25px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: #1d1d1b;
            color: #fff;
            border: 1px solid var(--ama);
            padding: .75rem 1.4rem;
            border-radius: 999px;
            font-size: .82rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: .6rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            z-index: 1100;
            opacity: 0;
            transition: all .35s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
        }

        .unifortex-toast.show {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }
    </style>
</head>

<body>

    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <linearGradient id="gW" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#FDC417" />
                <stop offset="1" stop-color="#D35914" />
            </linearGradient>
            <linearGradient id="gD" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#1D1D1B" />
                <stop offset="1" stop-color="#323231" />
            </linearGradient>
        </defs>
    </svg>

    <header id="mainHeader">
        <!-- Fila 1: Escudo a la izquierda y Logo oficial con iluminación blanca al ras -->
        <div class="nav-brand-row">
            <!-- 1. Marca en estado inicial (centrada) -->
            <a href="#inicio" class="brand brand-center" onclick="navigateToTab('inicio'); return false;" title="Grupo Unifortex - Volver al inicio">
                <img src="imagenes pasantias/escudo.png" alt="Escudo Unifortex" class="brand-escudo-img">
                <img src="imagenes pasantias/logo.png" alt="Grupo Unifortex" class="brand-logo-img">
            </a>

            <!-- 2. Marca en estado contraído/scrolled (fijada a la izquierda superior) -->
            <a href="#inicio" class="brand brand-left" onclick="navigateToTab('inicio'); return false;" title="Grupo Unifortex - Volver al inicio">
                <img src="imagenes pasantias/escudo.png" alt="Escudo Unifortex" class="brand-escudo-img">
                <img src="imagenes pasantias/logo.png" alt="Grupo Unifortex" class="brand-logo-img">
            </a>

            <!-- 3. Botón de acceso rápido al carrito en modo contraído -->
            <button class="scrolled-header-cart" onclick="openCartDrawer()" aria-label="Ver carrito" title="Ver carrito">
                🛒 <span>Carrito</span>
                <span class="nav-cart-badge" id="scrolledNavCartBadge" style="display:none">0</span>
            </button>
        </div>

        <!-- Fila 2: Menú de navegación horizontal -->
        <nav class="nav-btns-row" role="navigation" aria-label="Menú principal">
            <a href="#inicio" class="nav-item active" onclick="navigateToTab('inicio'); return false;">Inicio</a>
            <a href="#config" class="nav-item" onclick="navigateToTab('config'); return false;">Catálogo</a>
            <a href="#diseno" class="nav-item" onclick="navigateToTab('diseno'); return false;">Diseño Personalizado</a>
            <a href="#orden-compra" class="nav-item" onclick="navigateToTab('orden-compra'); return false;">Orden de Compra</a>
            <a href="#cotiza" class="nav-item" onclick="navigateToTab('cotiza'); return false;">Contacto</a>
            <button class="nav-item nav-item-cart" onclick="openCartDrawer()"
                aria-label="Carrito de compras" style="display:inline-flex;align-items:center;gap:.35rem">
                🛒 <span class="nav-cart-text">Carrito</span>
                <span class="nav-cart-badge" id="navCartBadge" style="display:none">0</span>
            </button>
        </nav>
    </header>
    <div class="header-spacer" aria-hidden="true"></div>

    <!-- ===== CONTENEDOR PRINCIPAL DE PESTAÑAS HORIZONTALES ===== -->
    <main class="views-viewport" id="viewsViewport">

        <!-- ===== VISTA 0: INICIO ===== -->
        <div class="tab-view active" id="view-inicio">
            <div class="hero-wrapper" id="inicio">
                <div class="hero-card" id="heroCard">

                    <!-- Carrusel de 3 fondos dentro de la tarjeta -->
                    <div class="hero-carousel" id="heroCarousel">
                        <div class="hero-slide active slide-photo"></div>
                        <div class="hero-slide slide-black"></div>
                        <div class="hero-slide slide-gold"></div>
                        <div class="hero-overlay"></div>
                    </div>

                    <!-- Contenido centrado sobre el fondo oscuro -->
                    <div class="hero-card-body">

                        <!-- Insignia de bienvenida -->
                        <span class="hero-badge">🛡️ GRUPO UNIFORTEX &middot; EPP &amp; Dotación Corporativa</span>

                        <!-- Titular principal -->
                        <h1>Tu seguridad,<br><span class="gold">nuestra misión</span></h1>

                        <!-- Descripción breve de los servicios -->
                        <p class="hero-desc">
                            Equipamos a tu equipo con <b>EPP certificado</b> bajo normas ANSI y ASTM, y confeccionamos
                            <b>uniformes industriales y corporativos</b> a la medida de tu empresa.
                            Un solo proveedor, todas tus soluciones.
                        </p>

                        <!-- Estadísticas rápidas -->
                        <div class="hero-stats">
                            <div class="hstat"><b>+40</b><small>Años de experiencia</small></div>
                            <div class="hstat"><b>500+</b><small>Clientes activos</small></div>
                            <div class="hstat"><b>100%</b><small>Cobertura EPP</small></div>
                        </div>

                        <!-- Tres botones de acción: borde dorado, fondo negro -->
                        <div class="hero-btns">
                            <a href="#config" class="btn btn-o" onclick="navigateToTab('config'); return false;">🛒 Catálogo</a>
                            <a href="#diseno" class="btn btn-o" onclick="navigateToTab('diseno'); return false;">🎨 Diseño Personalizado</a>
                            <a href="#orden-compra" class="btn btn-o" onclick="navigateToTab('orden-compra'); return false;">📋 Orden de Compra</a>
                        </div>

                    </div><!-- /hero-card-body -->

                    <!-- Indicadores del carrusel -->
                    <div class="carousel-dots" id="carouselDots">
                        <button class="carousel-dot active" onclick="goToSlide(0)" aria-label="Foto UNIFORTEX"></button>
                        <button class="carousel-dot" onclick="goToSlide(1)" aria-label="Fondo Negro"></button>
                        <button class="carousel-dot" onclick="goToSlide(2)" aria-label="Fondo Dorado"></button>
                    </div>

                </div><!-- /hero-card -->
            </div><!-- /hero-wrapper -->
        </div><!-- /view-inicio -->

        <!-- ===== VISTA 1: CATÁLOGO DE PRODUCTOS (INTERACTIVO ESTILO MOTOS TORO) ===== -->
        <div class="tab-view" id="view-config">
            <section id="config" style="padding-top:2rem;padding-bottom:4rem;background:#fbfbfa;min-height:85vh">
                <div class="catalog-container">

                    <!-- HUB CENTRALIZADO DE BÚSQUEDA Y FILTRADO (MENOS SATURADO Y MÁS CENTRADO) -->
                    <div class="catalog-filter-hub">
                        <div class="catalog-hub-header">
                            <span class="catalog-hub-tag">🛡️ DOTACIONES &amp; EPP CERTIFICADO</span>
                            <h2 class="catalog-hub-title">Catálogo <span style="color:var(--nar)">UNIFORTEX</span></h2>
                            <p class="catalog-hub-sub">Encuentra rápidamente uniformes y equipos de protección para tu empresa</p>
                        </div>

                        <!-- Barra de Búsqueda Centralizada con Filtro Integrado -->
                        <div class="catalog-central-search-card">
                            <div class="catalog-search-input-group">
                                <span class="search-ico">🔍</span>
                                <input type="text" id="catalogSearchInput" 
                                    placeholder="Buscar por código, prenda, material o norma (ej: Blue Jeans, Nitrilo, BS01)..." 
                                    oninput="buscarEnCatalogo(this.value)"
                                    autocomplete="off">
                                <button id="clearSearchBtn" onclick="limpiarBusquedaCatalogo()" title="Limpiar búsqueda">✕</button>
                            </div>
                            <div class="catalog-cat-select-group">
                                <span class="cat-select-ico">🏷️</span>
                                <select id="catalogCategorySelect" onchange="seleccionarCategoriaDesdeSelect(this.value)" aria-label="Filtrar por categoría">
                                    <option value="Todos">Todas las categorías (60)</option>
                                    <option value="Pantalones & Jeans">👖 Pantalones &amp; Jeans</option>
                                    <option value="Camisas & Chemises">👕 Camisas &amp; Chemises</option>
                                    <option value="Bragas & Batas">🦺 Bragas &amp; Batas</option>
                                    <option value="Delantales">🎽 Delantales</option>
                                    <option value="Calzado">🥾 Calzado de Seguridad</option>
                                    <option value="Protección Visual">🥽 Protección Visual</option>
                                    <option value="Protección Auditiva">🎧 Protección Auditiva</option>
                                    <option value="Guantes">🧤 Guantes de Protección</option>
                                    <option value="Protección General">⛑️ Protección General &amp; Altura</option>
                                    <option value="Respiratoria">😷 Protección Respiratoria</option>
                                    <option value="Impermeables & Vial">🌧️ Impermeables &amp; Vial</option>
                                </select>
                            </div>
                        </div>

                        <div class="catalog-search-hint">
                            <span>Busca por nombre, código, material o categoría.</span>
                            <span><strong>Tip:</strong> usa las flechas para explorar todas las categorías</span>
                        </div>

                        <!-- Panel de categorías desplazable -->
                        <div class="cat-pills-wrapper">
                            <button class="cat-scroll-btn" type="button" onclick="desplazarCategorias(-1)" aria-label="Mostrar categorías anteriores">‹</button>
                            <div class="cat-pills-scroll" id="catPillsList">
                                <button class="cat-pill active" onclick="filtrarCatalogo('Todos', this)">Todos</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Pantalones & Jeans', this)">👖 Pantalones</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Camisas & Chemises', this)">👕 Camisas</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Bragas & Batas', this)">🦺 Bragas</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Delantales', this)">🎽 Delantales</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Calzado', this)">🥾 Calzado</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Protección Visual', this)">🥽 Visual</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Protección Auditiva', this)">🎧 Auditiva</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Guantes', this)">🧤 Guantes</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Protección General', this)">⛑️ General</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Respiratoria', this)">😷 Respiratoria</button>
                                <button class="cat-pill" onclick="filtrarCatalogo('Impermeables & Vial', this)">🌧️ Impermeables</button>
                            </div>
                            <button class="cat-scroll-btn" type="button" onclick="desplazarCategorias(1)" aria-label="Mostrar más categorías">›</button>
                        </div>

                        <!-- Barra de Estado Compacta y Centrada -->
                        <div class="catalog-status-bar">
                            <span class="catalog-status-count">Mostrando <b id="catalogCounterTxt">60</b> modelos</span>
                            <span class="catalog-status-divider">•</span>
                            <span class="catalog-status-filter">Categoría: <b id="catalogActiveFilterTxt">Todos</b></span>
                            <button id="catalogResetBtn" class="catalog-reset-link" onclick="limpiarBusquedaCatalogo()" style="display:none;">Restablecer filtro</button>
                        </div>
                    </div>

                    <!-- Cuadrícula de Tarjetas de Productos -->
                    <div class="catalog-grid-motos" id="productGrid">
                        <!-- Se renderizan dinámicamente las 60 tarjetas interactivas -->
                    </div>

                </div>
            </section>
        </div><!-- /view-config -->

        <!-- ===== VISTA 2: DISEÑO PERSONALIZADO ===== -->
        <div class="tab-view" id="view-diseno">
            <section id="diseno" style="background:#fbfbfa;padding:2rem 0 4.5rem;min-height:85vh">
        <div class="container">
            <!-- TARJETA SUPERIOR CON LOS COLORES CORPORATIVOS -->
            <div class="diseno-header-hub">
                <div class="diseno-hub-header">
                    <span class="diseno-hub-tag">🎨 TALLER DE PERSONALIZACIÓN &amp; BORDADOS</span>
                    <h2 class="diseno-hub-title">Diseño &amp; <span style="color:var(--nar)">Bordados</span> <span class="gold">Corporativos</span></h2>
                    <p class="diseno-hub-sub">
                        Personaliza uniformes, camisas industriales y cascos de protección con el logotipo corporativo y colores de tu empresa. Confección bajo norma COVENIN y acabados de alta resistencia.
                    </p>
                </div>
                <div class="diseno-hub-pills">
                    <span class="diseno-hub-badge">🧵 Bordado Computarizado HD</span>
                    <span class="diseno-hub-badge">🖨️ Serigrafía / Estampado Textil</span>
                    <span class="diseno-hub-badge">🎨 Selección de Colores Corporativos</span>
                    <span class="diseno-hub-badge">🛡️ Normas COVENIN &amp; OSHA</span>
                </div>
            </div>

            <div class="diseno-grid">
                <!-- Panel de Configuración -->
                <div class="diseno-panel">
                    <!-- 1. Tipo de prenda (Camisa, Chemise, Franela, etc.) -->
                    <div class="opt-group">
                        <span class="opt-label">1. Prenda a Personalizar</span>
                        <div class="opt-chips" id="chipsPrenda">
                            <button class="opt-chip active"
                                onclick="setDisenoPrenda('camisa', '👔', 'Camisa Industrial Reforzada', 22.0, this)">
                                👔 Camisa Industrial
                            </button>
                            <button class="opt-chip"
                                onclick="setDisenoPrenda('chemise', '👕', 'Chemise Corporativa Institucional', 18.5, this)">
                                👕 Chemise
                            </button>
                            <button class="opt-chip"
                                onclick="setDisenoPrenda('franela', '👕', 'Franela de Algodón Cuello Redondo', 9.5, this)">
                                👕 Franela
                            </button>
                            <button class="opt-chip"
                                onclick="setDisenoPrenda('chaleco', '🦺', 'Chaleco Reflectivo Alta Visibilidad', 12.4, this)">
                                🦺 Chaleco Reflectivo
                            </button>
                            <button class="opt-chip"
                                onclick="setDisenoPrenda('jean', '👖', 'Pantalón Jean 3 Costuras', 28.5, this)">
                                👖 Jean de Trabajo
                            </button>
                            <button class="opt-chip"
                                onclick="setDisenoPrenda('casco', '⛑️', 'Casco Dieléctrico de Seguridad', 18.5, this)">
                                ⛑️ Casco Seguridad
                            </button>
                        </div>
                    </div>

                    <!-- 2. Ángulos del Boceto (Frente, Espalda, Manga Izquierda, Manga Derecha) -->
                    <div class="opt-group">
                        <span class="opt-label">2. Ángulo de Visualización del Boceto</span>
                        <div class="opt-chips" id="chipsAngulo">
                            <button class="opt-chip active" onclick="setDisenoAngulo('frente', this)">👕 Frente</button>
                            <button class="opt-chip" onclick="setDisenoAngulo('espalda', this)">🔄 Espalda</button>
                            <button class="opt-chip" onclick="setDisenoAngulo('manga-izq', this)">👈 Manga Izquierda</button>
                            <button class="opt-chip" onclick="setDisenoAngulo('manga-der', this)">👉 Manga Derecha</button>
                        </div>
                    </div>

                    <!-- 3. Color Corporativo de la Prenda -->
                    <div class="opt-group">
                        <span class="opt-label">3. Color de Tela de la Prenda</span>
                        <div class="swatches-bar">
                            <div class="swatch-circle active" style="background:#0a192f"
                                onclick="setDisenoColor('#0a192f', 'Azul Marino', this)" title="Azul Marino"></div>
                            <div class="swatch-circle" style="background:#1d1d1b"
                                onclick="setDisenoColor('#1d1d1b', 'Negro Industrial', this)" title="Negro Industrial"></div>
                            <div class="swatch-circle" style="background:#f4f5f7;border:1px solid #ccc"
                                onclick="setDisenoColor('#f4f5f7', 'Blanco Puro', this)" title="Blanco Puro"></div>
                            <div class="swatch-circle" style="background:#1565c0"
                                onclick="setDisenoColor('#1565c0', 'Azul Rey', this)" title="Azul Rey"></div>
                            <div class="swatch-circle" style="background:#c62828"
                                onclick="setDisenoColor('#c62828', 'Rojo Industrial', this)" title="Rojo Industrial"></div>
                            <div class="swatch-circle" style="background:#2e4732"
                                onclick="setDisenoColor('#2e4732', 'Verde Militar', this)" title="Verde Militar"></div>
                            <div class="swatch-circle" style="background:#d35914"
                                onclick="setDisenoColor('#d35914', 'Naranja de Seguridad', this)" title="Naranja Seguridad"></div>
                            <div class="swatch-circle" style="background:#4a5568"
                                onclick="setDisenoColor('#4a5568', 'Gris Plomo', this)" title="Gris Plomo"></div>
                            <div class="swatch-circle" style="background:#c2a649"
                                onclick="setDisenoColor('#c2a649', 'Caqui / Beige', this)" title="Caqui"></div>
                            <div class="swatch-circle" style="background:#fdc417"
                                onclick="setDisenoColor('#fdc417', 'Amarillo Vial', this)" title="Amarillo Vial"></div>
                            <span id="disenoColorLabel"
                                style="font-size:.78rem;font-style:italic;color:var(--gri);font-weight:700">Azul Marino</span>
                        </div>
                    </div>

                    <!-- 4. Técnica de Personalización -->
                    <div class="opt-group">
                        <span class="opt-label">4. Técnica de Aplicación</span>
                        <div class="opt-chips" id="chipsTecnica">
                            <button class="opt-chip active"
                                onclick="setDisenoTecnica('Bordado Computarizado', 3.5, this)">🧵 Bordado Computarizado (+$3.50)</button>
                            <button class="opt-chip"
                                onclick="setDisenoTecnica('Serigrafía Textil HD', 2.0, this)">🎨 Serigrafía Industrial (+$2.00)</button>
                            <button class="opt-chip"
                                onclick="setDisenoTecnica('Vinil Textil Reflectivo', 3.0, this)">✨ Vinil Reflectivo (+$3.00)</button>
                            <button class="opt-chip"
                                onclick="setDisenoTecnica('Parche Vulcanizado', 4.0, this)">🛡️ Parche Vulcanizado (+$4.00)</button>
                        </div>
                    </div>

                    <!-- 5. Carga de Logo, Quitar Fondo y Duplicar -->
                    <div class="opt-group" style="margin-bottom:0">
                        <span class="opt-label">5. Logotipo Corporativo (Sube tu imagen)</span>
                        <div style="display:flex;gap:.6rem;align-items:center;flex-wrap:wrap">
                            <button class="btn btn-w" style="padding:.65rem 1.1rem;font-size:.78rem"
                                onclick="document.getElementById('logoFileInput').click()">
                                📁 Subir Imagen de Logo
                            </button>
                            <input type="file" id="logoFileInput" accept="image/*" style="display:none"
                                onchange="cargarLogoSimulado(event)">
                            <button class="btn btn-o" id="btnSideToggleBg" style="padding:.65rem 1rem;font-size:.75rem"
                                onclick="toggleQuitarFondo()">
                                ✨ Quitar fondo automático
                            </button>
                            <button class="btn btn-o" style="padding:.65rem 1rem;font-size:.75rem"
                                onclick="duplicarLogo()">
                                ➕ Duplicar Logo
                            </button>
                        </div>

                        <div style="margin-top:.75rem;display:flex;gap:.5rem;align-items:center">
                            <input id="disenoLogoTexto" type="text" placeholder="O ingresa texto si no tienes imagen..."
                                value="TU LOGO AQUÍ" oninput="actualizarTextoLogo(this.value)"
                                style="flex:1;padding:.6rem .85rem;border:1.5px solid #ddd;border-radius:8px;font-family:Poppins;font-style:italic;font-size:.8rem">
                            <button class="btn btn-o" style="padding:.6rem .9rem;font-size:.75rem"
                                onclick="agregarLogoTexto(disenoState.logoTexto)">
                                Añadir Texto
                            </button>
                        </div>

                        <div id="uploadedLogoCard" class="uploaded-logo-card" style="display:none">
                            <div class="uploaded-logo-thumb">
                                <img id="uploadedLogoThumbImg" src="" alt="Thumbnail Logo">
                            </div>
                            <div style="flex:1">
                                <div style="font-size:.78rem;font-weight:700;color:#222" id="uploadedLogoFilename">Logo cargado</div>
                                <div style="font-size:.7rem;color:#666" id="uploadedLogoStatus">Fondo transparente aplicado</div>
                            </div>
                            <button class="btn btn-o" style="padding:.35rem .7rem;font-size:.7rem;border-color:#ff5252;color:#ff5252"
                                onclick="eliminarLogoActivo()">
                                🗑️ Quitar
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Preview y Estimación en Vivo (Estudio Mockup Interactivo) -->
                <div class="diseno-preview-box">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.5rem">
                        <div>
                            <h3 style="color:var(--ama);margin:0;font-size:1.15rem">Estudio de Mockup</h3>
                            <p style="color:var(--gcl);font-size:.75rem;margin:0">Boceto interactivo 3D con arrastre libre</p>
                        </div>
                        <span id="previewAnguloBadge" style="background:rgba(253,196,23,.18);border:1px solid var(--ama);color:var(--ama);padding:.25rem .65rem;border-radius:999px;font-size:.7rem;font-weight:800">
                            FRENTE
                        </span>
                    </div>

                    <!-- Botones de Ángulo sobre el Boceto -->
                    <div class="diseno-angle-nav" id="previewAngleNav">
                        <button class="diseno-angle-btn active" onclick="setDisenoAngulo('frente')">👕 Frente</button>
                        <button class="diseno-angle-btn" onclick="setDisenoAngulo('espalda')">🔄 Espalda</button>
                        <button class="diseno-angle-btn" onclick="setDisenoAngulo('manga-izq')">👈 Manga Izq.</button>
                        <button class="diseno-angle-btn" onclick="setDisenoAngulo('manga-der')">👉 Manga Der.</button>
                    </div>

                    <!-- Escenario del Boceto con SVG Realista y Capa Drag-and-Drop -->
                    <div class="preview-stage" id="previewStage">
                        <div class="stage-lighting"></div>
                        
                        <!-- SVG vectorial de la prenda en alta resolución -->
                        <div class="mockup-svg-wrap" id="mockupSvgWrap">
                            <!-- Inyectado dinámicamente según prenda y ángulo -->
                        </div>

                        <!-- Capa de logos arrastrables libremente -->
                        <div class="diseno-drag-layer" id="disenoDragLayer">
                            <!-- Los logos colocados se renderizan aquí y pueden moverse libremente -->
                        </div>
                    </div>

                    <!-- Barra Rápida de Herramientas de Logo -->
                    <div class="diseno-quick-toolbar">
                        <button class="diseno-quick-btn" onclick="document.getElementById('logoFileInput').click()" title="Subir logo">
                            📁 Subir
                        </button>
                        <button class="diseno-quick-btn" id="btnToolbarBg" onclick="toggleQuitarFondo()" title="Quitar o restaurar fondo">
                            ✨ Sin fondo
                        </button>
                        <button class="diseno-quick-btn" onclick="duplicarLogo()" title="Duplicar logo cuantas veces quieras">
                            ➕ Duplicar Logo
                        </button>
                        <button class="diseno-quick-btn" onclick="ajustarEscalaLogo(0.15)" title="Agrandar">
                            🔍 +
                        </button>
                        <button class="diseno-quick-btn" onclick="ajustarEscalaLogo(-0.15)" title="Reducir">
                            🔍 -
                        </button>
                        <button class="diseno-quick-btn danger" onclick="eliminarLogoActivo()" title="Eliminar logo">
                            🗑️ Borrar
                        </button>
                        <button class="diseno-quick-btn" onclick="limpiarLogosAngulo()" title="Limpiar ángulo actual">
                            🧹 Limpiar
                        </button>
                    </div>

                    <div style="text-align:center;font-size:.7rem;color:var(--gcl);margin-bottom:.85rem;line-height:1.3">
                        💡 <b>Arrastra el logo libremente</b> sobre la prenda. Puedes duplicarlo cuantas veces quieras y colocarlo en el frente, espalda o mangas.
                    </div>

                    <div style="border-top:1px solid rgba(255,255,255,.1);padding-top:.85rem;margin-bottom:1rem">
                        <div style="display:flex;justify-content:space-between;margin-bottom:.35rem;font-size:.82rem">
                            <span style="color:var(--gcl)" id="prevPrendaNombre">Camisa Industrial Reforzada:</span>
                            <b id="prevPrendaPrecio">$22.00</b>
                        </div>
                        <div style="display:flex;justify-content:space-between;margin-bottom:.35rem;font-size:.82rem">
                            <span style="color:var(--gcl)" id="prevTecnicaNombre">Técnica (Bordado):</span>
                            <b id="prevTecnicaPrecio">+$3.50</b>
                        </div>
                        <div style="display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:.65rem">
                            <span style="color:var(--gcl)">Logos colocados:</span>
                            <b id="prevTotalLogosCount" style="color:var(--ama)">1 en Frente</b>
                        </div>
                        <div class="total"
                            style="padding:.7rem 0;border-top:1px solid rgba(253,196,23,.3);border-bottom:1px solid rgba(253,196,23,.3);margin-bottom:.85rem">
                            <span style="font-size:1.02rem">COSTO ESTIMADO / UD</span>
                            <span style="color:var(--ama);font-size:1.35rem" id="disenoPrecioTotal">$25.50</span>
                        </div>
                        <p style="font-size:.68rem;color:var(--gcl);margin-bottom:1rem;line-height:1.3">
                            * Precios por unidad para lotes corporativos a partir de 24 piezas. Incluye digitalización de matriz.
                        </p>
                    </div>

                    <button class="btn btn-w" style="width:100%;justify-content:center" onclick="solicitarMuestraDiseno()">
                        🎨 Solicitar Cotización de este Diseño
                    </button>
                </div>
            </div>
        </div>
    </section>
        </div><!-- /view-diseno -->

        <!-- ===== VISTA 3: ORDEN DE COMPRA ===== -->
        <div class="tab-view" id="view-orden-compra">
            <section id="orden-compra" style="background:#fbfbfa;color:var(--neg);padding:2rem 0 4.5rem;min-height:85vh">
        <div class="container">
            <!-- TARJETA SUPERIOR CON LOS COLORES CORPORATIVOS -->
            <div class="oc-top-bar">
                <div style="position:relative;z-index:2">
                    <span class="hero-badge" style="margin-bottom:.5rem;background:rgba(253,196,23,.12);border-color:rgba(253,196,23,.3);color:var(--ama)">📋 Portal Corporativo B2B</span>
                    <h2 style="font-size:clamp(1.4rem,3vw,2rem);margin:0;color:#fff">Orden de <span class="gold"
                            style="background:var(--gw);-webkit-background-clip:text;background-clip:text;color:transparent">Compra
                            Empresarial</span></h2>
                    <p style="margin:.45rem 0 0;font-size:.85rem;color:#bfc2c2;max-width:620px;line-height:1.5">
                        Genera tu orden formal con desglose de ítems, cálculo automático de IVA y cotización lista para emitir o descargar en PDF.
                    </p>
                </div>
                <div style="display:flex;gap:.8rem;align-items:center;flex-wrap:wrap;position:relative;z-index:2">
                    <span
                        style="background:rgba(253,196,23,.15);border:1px solid var(--ama);color:var(--ama);padding:.45rem 1rem;border-radius:999px;font-size:.74rem;font-weight:700;letter-spacing:.03em"
                        id="ocNumeroDisplay">
                        O.C. Nº: UF-2026-4820
                    </span>
                    <button class="btn btn-w" style="padding:.55rem 1.2rem;font-size:.74rem" onclick="importarKitAOrden()">
                        📥 Cargar Productos del Kit
                    </button>
                </div>
            </div>

            <div class="oc-grid">
                <!-- Formulario y Detalle de la Orden -->
                <div class="oc-card">
                    <h3 style="color:var(--neg);margin-bottom:1.2rem;font-size:1.1rem;display:flex;align-items:center;gap:.5rem">
                        🏢 Datos Comerciales de Facturación
                    </h3>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:1.2rem"
                        class="oc-inputs-grid">
                        <div>
                            <label
                                style="display:block;font-size:.7rem;text-transform:uppercase;font-weight:700;color:var(--gri);margin-bottom:.3rem">Razón
                                Social *</label>
                            <input id="ocEmpresa" required placeholder="Ej. Constructora Andina C.A."
                                value="Constructora Andina C.A."
                                style="width:100%;padding:.75rem;border:1.5px solid #ddd;border-radius:10px;font-family:Poppins;font-style:italic;font-size:.82rem">
                        </div>
                        <div>
                            <label
                                style="display:block;font-size:.7rem;text-transform:uppercase;font-weight:700;color:var(--gri);margin-bottom:.3rem">RIF
                                Fiscal *</label>
                            <input id="ocRif" required placeholder="J-00000000-0" value="J-31048921-4"
                                style="width:100%;padding:.75rem;border:1.5px solid #ddd;border-radius:10px;font-family:Poppins;font-style:italic;font-size:.82rem">
                        </div>
                        <div>
                            <label
                                style="display:block;font-size:.7rem;text-transform:uppercase;font-weight:700;color:var(--gri);margin-bottom:.3rem">Contacto
                                / Dpto. Compras *</label>
                            <input id="ocContacto" required placeholder="Nombre del solicitante"
                                value="Ing. Marcos Benítez"
                                style="width:100%;padding:.75rem;border:1.5px solid #ddd;border-radius:10px;font-family:Poppins;font-style:italic;font-size:.82rem">
                        </div>
                        <div>
                            <label
                                style="display:block;font-size:.7rem;text-transform:uppercase;font-weight:700;color:var(--gri);margin-bottom:.3rem">Correo
                                para Enviar O.C. *</label>
                            <input id="ocEmail" required type="email" placeholder="compras@empresa.com"
                                value="compras@constructoraandina.com"
                                style="width:100%;padding:.75rem;border:1.5px solid #ddd;border-radius:10px;font-family:Poppins;font-style:italic;font-size:.82rem">
                        </div>
                    </div>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin-bottom:1.5rem">
                        <div>
                            <label
                                style="display:block;font-size:.7rem;text-transform:uppercase;font-weight:700;color:var(--gri);margin-bottom:.3rem">Condición
                                de Pago Acordada</label>
                            <select id="ocCondicionPago" onchange="calcularTotalesOC()"
                                style="width:100%;padding:.75rem;border:1.5px solid #ddd;border-radius:10px;font-family:Poppins;font-style:italic;font-size:.82rem">
                                <option value="contado">Contado / Transferencia (5% Descuento B2B)</option>
                                <option value="credito15" selected>Crédito Comercial a 15 días</option>
                                <option value="credito30">Crédito Comercial a 30 días</option>
                                <option value="anticipo">50% Anticipo / 50% Contra Entrega</option>
                            </select>
                        </div>
                        <div>
                            <label
                                style="display:block;font-size:.7rem;text-transform:uppercase;font-weight:700;color:var(--gri);margin-bottom:.3rem">Dirección
                                de Despacho / Almacén</label>
                            <input id="ocDespacho" placeholder="Zona Industrial, Almacén Central"
                                value="Zona Ind. El Recreo, Galpón 4"
                                style="width:100%;padding:.75rem;border:1.5px solid #ddd;border-radius:10px;font-family:Poppins;font-style:italic;font-size:.82rem">
                        </div>
                    </div>

                    <h4
                        style="color:var(--neg);font-size:.9rem;border-top:1px solid #eee;padding-top:1.2rem;margin-bottom:.5rem;display:flex;justify-content:space-between;align-items:center">
                        <span>📦 Ítems Incluidos en la Orden</span>
                        <button class="btn btn-o" style="padding:.35rem .8rem;font-size:.68rem"
                            onclick="agregarItemManualOC()">+ Añadir Ítem</button>
                    </h4>

                    <div style="overflow-x:auto">
                        <table class="oc-table">
                            <thead>
                                <tr>
                                    <th>Descripción</th>
                                    <th style="width:90px;text-align:center">Cant.</th>
                                    <th style="width:100px;text-align:right">P. Unit</th>
                                    <th style="width:110px;text-align:right">Subtotal</th>
                                    <th style="width:40px;text-align:center"></th>
                                </tr>
                            </thead>
                            <tbody id="ocItemsBody">
                                <!-- Filas dinámicas -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Resumen Financiero y Validación -->
                <div class="oc-summary-card">
                    <h3 style="color:var(--ama);margin-bottom:.4rem">Resumen Financiero</h3>
                    <p style="color:var(--gcl);font-size:.75rem;margin-bottom:1.2rem">Facturación fiscal con soporte legal</p>

                    <div
                        style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:.85rem">
                        <span style="color:var(--gcl)">Subtotal Mercancía:</span>
                        <b id="ocSubtotalTxt">$0.00</b>
                    </div>
                    <div
                        style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:.85rem">
                        <span style="color:var(--gcl)">Descuento Comercial:</span>
                        <b style="color:var(--ama)" id="ocDescuentoTxt">-$0.00</b>
                    </div>
                    <div
                        style="display:flex;justify-content:space-between;padding:.5rem 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:.85rem">
                        <span style="color:var(--gcl)">IVA Estimado (16%):</span>
                        <b id="ocIvaTxt">$0.00</b>
                    </div>

                    <div class="total" style="padding:1rem 0;margin:1rem 0;border-top:2px solid var(--ama)">
                        <span style="font-size:1.1rem">TOTAL ORDEN</span>
                        <span id="ocTotalTxt" style="color:var(--ama);font-size:1.5rem">$0.00</span>
                    </div>

                    <div style="display:grid;gap:.7rem">
                        <button class="btn btn-w" style="width:100%;justify-content:center"
                            onclick="procesarOrdenCompraOficial()">
                            🚀 Emitir y Procesar Orden de Compra
                        </button>
                        <button class="btn btn-o"
                            style="width:100%;justify-content:center;border-color:#777;color:#fff"
                            onclick="descargarResumenOC()">
                            📄 Descargar / Imprimir O.C. (PDF)
                        </button>
                    </div>

                    <div
                        style="margin-top:1.2rem;padding:.8rem;background:rgba(255,255,255,.05);border-radius:10px;font-size:.7rem;color:var(--gcl);line-height:1.4">
                        🛡️ <b>Garantía UNIFORTEX:</b> Despacho asegurado, certificados de calidad por lote y soporte
                        post-venta permanente.
                    </div>
                </div>
            </div>
        </div>
    </section>
        </div><!-- /view-orden-compra -->

