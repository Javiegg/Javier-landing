    <!-- Overlay y Drawer del Carrito (Despliegue de derecha a izquierda) -->
    <div class="cart-drawer-overlay" id="cartDrawerOverlay" onclick="closeCartDrawer()"></div>
    <aside class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-label="Carrito de compras">
        <div class="cart-drawer-header">
            <div class="cart-drawer-title-box">
                <div class="cart-drawer-title">
                    <span class="cart-ico">🛒</span> Carrito de Compras
                    <span class="cart-count-pill" id="drawerCountPill">0 ítems</span>
                </div>
                <div class="cart-drawer-sub">Pedido actual del catálogo industrial</div>
            </div>
            <button class="cart-drawer-close" onclick="closeCartDrawer()" aria-label="Cerrar carrito">✕</button>
        </div>

        <div class="cart-drawer-body" id="drawerCartBody">
            <!-- Se llena dinámicamente con las tarjetas de los productos -->
            <div id="drawerCartList" style="display:flex;flex-direction:column;gap:.85rem"></div>

            <!-- Estado Vacío -->
            <div class="cart-drawer-empty" id="drawerEmpty" style="display:none">
                <div class="cart-drawer-empty-ico">🛒</div>
                <h4>Tu carrito está vacío</h4>
                <p>Agrega productos desde el catálogo para armar la dotación o equipamiento de tu empresa.</p>
                <button class="btn btn-w" style="font-size:.78rem;padding:.7rem 1.4rem" onclick="closeCartDrawer(); navigateToTab('config');">
                    Explorar Catálogo
                </button>
            </div>
        </div>

        <div class="cart-drawer-footer" id="drawerFooter">
            <div class="cart-drawer-totals-box">
                <div class="cart-total-row">
                    <span>Subtotal:</span>
                    <strong id="drawerSubtotal">$0.00</strong>
                </div>
                <div class="cart-total-row">
                    <span>IVA Estimado (16%):</span>
                    <strong id="drawerIva">$0.00</strong>
                </div>
                <div class="cart-total-row main-total">
                    <span>TOTAL ESTIMADO:</span>
                    <span id="drawerTotal">$0.00</span>
                </div>
            </div>

            <button class="btn-confirmar-compra" id="btnConfirmarCompraDrawer" onclick="confirmarCompraDesdeDrawer()">
                <span>✓</span> Confirmar Compra
            </button>

            <div class="cart-drawer-actions-sub">
                <button type="button" class="btn-drawer-sec" onclick="closeCartDrawer()" title="Cerrar carrito y seguir explorando el catálogo">
                    <span>🛍️</span> Seguir explorando
                </button>
                <button type="button" class="btn-drawer-clear" onclick="clearCart()" title="Vaciar todos los productos del carrito">
                    <span>🗑️</span> Vaciar carrito
                </button>
            </div>

            <div class="cart-drawer-b2b-note">
                <span>🛡️</span> Facturación fiscal oficial · Procesa tu Orden de Compra B2B
            </div>
        </div>
    </aside>

