                cat: 'Impermeables & Vial',
                price: 5.20,
                mat: 'Malla de poliéster fluorescente con cintas reflectantes de 2 pulgadas',
                matShort: 'Malla Fluorescente c/ Cintas 2"',
                sizes: 'Estándar ajustable con cierre mágico',
                sizeShort: 'Ajustable Universal',
                ico: '🦺'
            },
            {
                id: 60,
                code: 'COD - GP19',
                name: 'Protección General - Chaleco Tipo Arnés',
                cat: 'Impermeables & Vial',
                price: 6.00,
                mat: 'Bandas elásticas de alta tensión y cintas reflectantes cruzadas en X',
                matShort: 'Bandas Elásticas Reflectivas en X',
                sizes: 'Ajustable en cintura y hombros',
                sizeShort: 'Ajustable Multitalla',
                ico: '🦺'
            }
        ];

        let cart = {};
        let currentCatalogFilter = 'Todos';
        let currentCatalogSearch = '';
        let currentModalProduct = null;
        let modalQty = 1;
        let catalogSearchTimer = null;

        function normalizarTextoCatalogo(value) {
            return String(value || '')
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .trim();
        }

        /* ---------- RENDERIZADO DEL CATÁLOGO UNIFORTEX ---------- */
        function renderCatalog(filter = 'Todos', search = '') {
            currentCatalogFilter = filter;
            currentCatalogSearch = search;
            const grid = document.getElementById('productGrid');
            const counterTxt = document.getElementById('catalogCounterTxt');
            if (!grid) return;

            const q = normalizarTextoCatalogo(search);
            const terms = q ? q.split(/\s+/).filter(Boolean) : [];

            let filtered = PRODUCTS.filter(p => {
                const matchesCat = (filter === 'Todos') || (p.cat === filter);
                const searchableText = normalizarTextoCatalogo([
                    p.name, p.code, p.mat, p.matShort, p.sizes, p.sizeShort, p.cat
                ].join(' '));
                const matchesSearch = !terms.length || terms.every(term => searchableText.includes(term));
                return matchesCat && matchesSearch;
            });

            if (counterTxt) counterTxt.textContent = filtered.length;

            if (!filtered.length) {
                grid.innerHTML = `
                    <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 1rem; color: #777;">
                        <div style="font-size: 3.5rem; margin-bottom: 1rem;">🔍</div>
                        <h3 style="color: #222; font-size: 1.2rem; margin-bottom: .5rem;">No encontramos modelos que coincidan</h3>
                        <p style="font-size: .85rem; max-width: 420px; margin: 0 auto 1.5rem;">Intenta con otro término de búsqueda o selecciona la categoría "Todos".</p>
                        <button class="btn btn-w" onclick="limpiarBusquedaCatalogo()">Ver todos los productos</button>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(p => `
                <div class="prod-card-moto">
                    <span class="card-moto-badge">🏷️ ${p.code}</span>
                    <div class="card-moto-media" onclick="abrirDetalleProducto(${p.id})" title="Click para ver especificaciones de ${p.name}">
                        <div class="card-moto-emoji">${p.ico}</div>
                    </div>
                    <div class="card-moto-brand">UNIFORTEX · ${p.cat}</div>
                    <h3 class="card-moto-title" onclick="abrirDetalleProducto(${p.id})" title="${p.name}">${p.name}</h3>
                    <div class="card-moto-specs">
                        <div title="${p.mat}">🧵 <span>${p.matShort}</span></div>
                        <div title="${p.sizes}">📏 <span>${p.sizeShort}</span></div>
                    </div>
                    <div class="card-moto-price-row">
                        <div class="card-moto-price">
                            <b>$${p.price.toFixed(2)}</b>
                            <span>USD</span>
                        </div>
                        <div class="card-moto-bulk">Lotes (+50): $${(p.price * 0.88).toFixed(2)}</div>
                    </div>
                    <div class="card-moto-actions">
                        <button class="btn-moto-details" onclick="abrirDetalleProducto(${p.id})">
                            Ver detalles ➔
                        </button>
                        <button class="btn-moto-cart" onclick="addCart(${p.id})" title="Añadir al carrito">
                            🛒
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function actualizarEstadoFiltrosCatalogo(cat, search) {
            const filterTxt = document.getElementById('catalogActiveFilterTxt');
            if (filterTxt) filterTxt.textContent = cat || 'Todos';

            const resetBtn = document.getElementById('catalogResetBtn');
            if (resetBtn) {
                const isDefault = (cat === 'Todos' && (!search || !search.trim()));
                resetBtn.style.display = isDefault ? 'none' : 'inline-block';
            }
        }

        function seleccionarCategoriaDesdeSelect(cat) {
            document.querySelectorAll('#catPillsList .cat-pill').forEach(b => {
                b.classList.remove('active');
                const onclickAttr = b.getAttribute('onclick') || '';
                if (cat === 'Todos' && onclickAttr.includes("'Todos'")) {
                    b.classList.add('active');
                    b.scrollIntoView?.({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                } else if (cat !== 'Todos' && onclickAttr.includes(`'${cat}'`)) {
                    b.classList.add('active');
                    b.scrollIntoView?.({ behavior: 'smooth', inline: 'center', block: 'nearest' });
                }
            });

            actualizarEstadoFiltrosCatalogo(cat, currentCatalogSearch);
            renderCatalog(cat, currentCatalogSearch);
        }

        function filtrarCatalogo(cat, btn) {
            document.querySelectorAll('#catPillsList .cat-pill').forEach(b => b.classList.remove('active'));
            if (btn) {
                btn.classList.add('active');
                btn.scrollIntoView?.({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            }

            const sel = document.getElementById('catalogCategorySelect');
            if (sel) sel.value = cat;

            actualizarEstadoFiltrosCatalogo(cat, currentCatalogSearch);
            renderCatalog(cat, currentCatalogSearch);
        }

        function buscarEnCatalogo(val) {
            const clearBtn = document.getElementById('clearSearchBtn');
            if (clearBtn) clearBtn.style.display = val.trim() ? 'block' : 'none';
            clearTimeout(catalogSearchTimer);
            catalogSearchTimer = setTimeout(() => {
                actualizarEstadoFiltrosCatalogo(currentCatalogFilter, val);
                renderCatalog(currentCatalogFilter, val);
            }, 120);
        }

        function desplazarCategorias(direction) {
            const list = document.getElementById('catPillsList');
            if (!list) return;
            list.scrollBy({ left: direction * Math.max(220, list.clientWidth * .65), behavior: 'smooth' });
        }

        function limpiarBusquedaCatalogo() {
            const input = document.getElementById('catalogSearchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            const sel = document.getElementById('catalogCategorySelect');
            if (input) input.value = '';
            if (clearBtn) clearBtn.style.display = 'none';
            if (sel) sel.value = 'Todos';
            clearTimeout(catalogSearchTimer);

            document.querySelectorAll('#catPillsList .cat-pill').forEach(b => {
                b.classList.toggle('active', (b.getAttribute('onclick') || '').includes("'Todos'"));
            });

            actualizarEstadoFiltrosCatalogo('Todos', '');
            renderCatalog('Todos', '');
        }

        /* ---------- MODAL FICHA TÉCNICA (PESTAÑAS DETALLADO VS MAYORISTA, TALLAS Y ENTRADA CONTINUA) ---------- */
        const DETAL_MAX_QTY = 11; // Límite de venta al detal (de 12 en adelante es Mayorista)
        let currentModalTier = 'detal'; // 'detal' | 'mayor'
        let modalSelectedSize = '';
        let cartSizes = {}; // Guarda la talla elegida para cada producto del carrito

        function parseProductSizes(sizesStr) {
            if (!sizesStr) return ['Única'];
            const s = String(sizesStr).trim();
            if (s.includes(' - ')) {
                return s.split(' - ').map(x => x.trim()).filter(Boolean);
            }
            if (s.includes('-')) {
                return s.split('-').map(x => x.trim()).filter(Boolean);
            }
            const rangeMatch = s.match(/(\d+)\s+al\s+(\d+)/i);
            if (rangeMatch) {
                const start = parseInt(rangeMatch[1], 10);
                const end = parseInt(rangeMatch[2], 10);
                const isFootwear = start >= 35 && end <= 46;
                const step = (start % 2 === 0 && end % 2 === 0 && (end - start) > 8) ? 2 : 1;
                const list = [];
                for (let n = start; n <= end; n += step) {
                    list.push(String(n));
                }
                if (list.length) return list;
            }
            if (s.toLowerCase().includes('única') || s.toLowerCase().includes('unica')) {
                return ['Talla Única'];
            }
            if (s.toLowerCase().includes('ajustable') || s.toLowerCase().includes('universal') || s.toLowerCase().includes('estándar') || s.toLowerCase().includes('estandar')) {
                return ['Ajustable Universal'];
            }
            return [s];
        }

        function getProductPrice(p, qty = 1) {
            if (!p) return 0;
            // A partir de 12 unidades (límite mayorista), aplicar automáticamente tarifa mayorista B2B (18% dto)
            if (qty >= 12) {
                return +(p.price * 0.82).toFixed(2);
            }
            return p.price;
        }

        function abrirDetalleProducto(id) {
            const p = PRODUCTS.find(x => x.id == id);
            if (!p) return;
            currentModalProduct = p;
            modalQty = 1;
            currentModalTier = 'detal';

            // Inicializar talla seleccionada con la primera disponible
            const sizesArr = parseProductSizes(p.sizes);
            modalSelectedSize = sizesArr[0] || 'Única';

            renderModalFullContent();
            openModal('productDetailModal');
        }

        function cerrarDetalleProducto() {
            closeModal('productDetailModal');
        }

        function seleccionarTallaModal(size) {
            modalSelectedSize = size;
            const disp = document.getElementById('modalSelectedSizeDisplay');
            if (disp) disp.textContent = size;

            const allBtns = document.querySelectorAll('#modalSizesContainer .modal-size-btn');
            allBtns.forEach(b => {
                const isThis = b.getAttribute('data-size') === size;
                b.classList.toggle('active-size', isThis);
            });
        }

        function cambiarTierModal(tier) {
            if (!currentModalProduct) return;
            currentModalTier = tier;

            // Ajuste de cantidad al cambiar manualmente de pestaña
            if (tier === 'mayor' && modalQty <= DETAL_MAX_QTY) {
                modalQty = 12; // Mínimo mayorista
            } else if (tier === 'detal' && modalQty > DETAL_MAX_QTY) {
                modalQty = 1; // Volver a detal
            }

            const input = document.getElementById('modalQtyInput');
            if (input) input.value = modalQty;

            actualizarTierVisualmente(tier === 'mayor');
        }

        // ENTRADA CONTINUA: NO destruye el input en el DOM para NO perder el foco ni el cursor al borrar o escribir
        function onModalQtyInput(val) {
            if (val === '' || isNaN(val)) return;
            const num = parseInt(val, 10);
            if (num <= 0) return;
            modalQty = num;

            const previousTier = currentModalTier;
            const isMayorNow = modalQty > DETAL_MAX_QTY;
            currentModalTier = isMayorNow ? 'mayor' : 'detal';

            if (previousTier !== currentModalTier) {
                // Se cruzó el límite entre detal y mayorista: actualiza colores, precios y textos sin tocar el input
                actualizarTierVisualmente(isMayorNow);
            } else {
                actualizarCalculosModal();
            }
        }

        function onModalQtyBlur(val) {
            let num = parseInt(val, 10);
            if (isNaN(num) || num < 1) num = 1;
            modalQty = num;

            const input = document.getElementById('modalQtyInput');
            if (input) input.value = modalQty;

            const isMayorNow = modalQty > DETAL_MAX_QTY;
            currentModalTier = isMayorNow ? 'mayor' : 'detal';
            actualizarTierVisualmente(isMayorNow);
        }

        function modModalQty(delta) {
            const newQty = Math.max(1, modalQty + delta);
            modalQty = newQty;

            const input = document.getElementById('modalQtyInput');
            if (input) input.value = modalQty;

            const isMayorNow = modalQty > DETAL_MAX_QTY;
            currentModalTier = isMayorNow ? 'mayor' : 'detal';
            actualizarTierVisualmente(isMayorNow);
        }

        function actualizarCalculosModal() {
            if (!currentModalProduct) return;
            const p = currentModalProduct;
            const isMayor = currentModalTier === 'mayor';
            const unitPrice = isMayor ? +(p.price * 0.82).toFixed(2) : p.price;
            const subtotal = unitPrice * modalQty;
            const ahorroTotal = isMayor ? ((p.price - unitPrice) * modalQty) : 0;

            const subCalc = document.getElementById('modalSubtotalCalc');
            if (subCalc) {
                subCalc.textContent = '$' + subtotal.toFixed(2);
                subCalc.style.color = isMayor ? 'var(--ama)' : '#ffffff';
            }

            const ahorroTxt = document.getElementById('modalAhorroTxt');
            if (ahorroTxt) {
                if (isMayor && ahorroTotal > 0) {
                    ahorroTxt.style.display = 'block';
                    ahorroTxt.textContent = 'Tarifa mayorista aplicada ($' + unitPrice.toFixed(2) + ' c/u)';
                } else {
                    ahorroTxt.style.display = 'none';
                }
            }
        }

        // Actualiza el aspecto de la ficha técnica al cambiar entre Detal y Mayorista SIN destruir el DOM del input
        function actualizarTierVisualmente(isMayor) {
            const p = currentModalProduct;
            if (!p) return;
            const unitPrice = isMayor ? +(p.price * 0.82).toFixed(2) : p.price;

            // 1. Pestañas
            const tabDetal = document.getElementById('tabDetalBtn');
            const tabMayor = document.getElementById('tabMayorBtn');
            if (tabDetal) {
                tabDetal.className = 'modal-tab-btn ' + (!isMayor ? 'active-detal' : '');
            }
            if (tabMayor) {
                tabMayor.className = 'modal-tab-btn ' + (isMayor ? 'active-mayor' : '');
                const badgeMayor = tabMayor.querySelector('span:last-child');
                if (badgeMayor) {
                    badgeMayor.style.background = isMayor ? '#111' : '#fdc417';
                    badgeMayor.style.color = isMayor ? '#fdc417' : '#111';
                }
            }

            // 2. Indicador superior
            const indBadge = document.getElementById('modalTierIndicatorBadge');
            if (indBadge) {
                indBadge.textContent = isMayor ? '⭐ Tarifa Mayorista' : '🛍️ Tarifa Detallado';
                indBadge.style.cssText = 'font-size:.72rem;padding:.2rem .65rem;border-radius:20px;font-weight:700;display:inline-flex;align-items:center;gap:.3rem;' +
                    (isMayor ? 'background:rgba(253,196,23,.2);color:var(--ama);border:1px solid rgba(253,196,23,.4)' : 'background:rgba(148,163,184,.15);color:#cbd5e1;border:1px solid rgba(148,163,184,.3)');
            }

            // 3. Tarjeta de producto izquierda
            const mediaCard = document.getElementById('modalMediaCard');
            if (mediaCard) {
                mediaCard.style.cssText = 'display:flex;flex-direction:column;align-items:center;border-radius:14px;padding:1rem .9rem;justify-content:center;text-align:center;transition:all .25s ease;' +
                    (isMayor ? 'background:linear-gradient(180deg, rgba(253,196,23,0.12) 0%, #151410 100%);border:1px solid rgba(253,196,23,0.5);box-shadow:0 4px 16px rgba(253,196,23,0.15)' : 'background:linear-gradient(180deg, #181d26 0%, #0f1217 100%);border:1px solid rgba(148,163,184,0.3);box-shadow:0 4px 16px rgba(0,0,0,0.3)');
            }

            // 4. Bloque de precios (aclarando directamente el valor de ser mayorista)
            const priceBlock = document.getElementById('modalPriceBlock');
            if (priceBlock) {
                priceBlock.innerHTML = isMayor ? `
                    <div style="font-size:.78rem;color:#9ca3af;text-decoration:line-through;margin-bottom:2px">$${p.price.toFixed(2)} USD</div>
                    <div style="font-size:1.55rem;font-weight:900;color:var(--ama);line-height:1.15">$${unitPrice.toFixed(2)} <span style="font-size:.75rem;color:#e5e7eb">USD/u</span></div>
                    <div style="display:inline-block;font-size:.7rem;color:var(--ama);font-weight:800;background:rgba(253,196,23,.15);border:1px solid rgba(253,196,23,.35);padding:.18rem .5rem;border-radius:6px;margin-top:.3rem">
                        🏭 Tarifa Mayorista
                    </div>
                ` : `
                    <div style="font-size:1.55rem;font-weight:900;color:#ffffff;line-height:1.15">$${p.price.toFixed(2)} <span style="font-size:.75rem;color:#9ca3af">USD/u</span></div>
                    <div style="display:inline-block;font-size:.7rem;color:#94a3b8;font-weight:700;background:rgba(148,163,184,.15);border:1px solid rgba(148,163,184,.3);padding:.18rem .5rem;border-radius:6px;margin-top:.3rem">
                        🛍️ Tarifa Detallado
                    </div>
                `;
            }

            // 5. Hint de límite izquierdo
            const hintBox = document.getElementById('modalTierHintBox');
            if (hintBox) {
                hintBox.innerHTML = isMayor ? `
                    <span style="color:#fef08a">Al ser pedido mayorista (≥ 12 unid.) el valor unitario es de <b>$${unitPrice.toFixed(2)} USD</b>.</span>
                ` : `
                    <span style="color:var(--gcl)">Compras de 1 a 11 unidades ($${p.price.toFixed(2)} USD/u).</span>
                `;
            }

            // 6. Tarjeta informativa derecha (mensaje claro y sobrio)
            const noticeBox = document.getElementById('modalTierNoticeBox');
            if (noticeBox) {
                noticeBox.style.cssText = 'border-radius:9px;padding:.5rem .8rem;margin-bottom:.55rem;font-size:.77rem;line-height:1.35;display:flex;align-items:center;gap:.6rem;' +
                    (isMayor ? 'background:linear-gradient(135deg, rgba(253,196,23,0.12) 0%, rgba(226,30,44,0.08) 100%);border:1px solid rgba(253,196,23,0.35);color:#fef08a' : 'background:#161d27;border:1px solid rgba(148,163,184,0.22);color:#cbd5e1');
                noticeBox.innerHTML = `
                    <span style="font-size:1.15rem">${isMayor ? '🏭' : '🛍️'}</span>
                    <div>
                        ${isMayor ? `
                            <b>Tarifa Mayorista (≥ 12 unid.):</b> Al ser compra mayorista cuenta con una tarifa de <b>$${unitPrice.toFixed(2)} USD</b> por unidad.
                        ` : `
                            <b>Tarifa Detallado:</b> Valor unitario de <b>$${p.price.toFixed(2)} USD</b> para compras de 1 a 11 unidades.
                        `}
                    </div>
                `;
            }

            // 7. Borde del input de cantidad
            const qtyCtrl = document.getElementById('modalQtyCtrlBox');
            if (qtyCtrl) {
                qtyCtrl.style.borderColor = isMayor ? 'var(--ama)' : 'rgba(148,163,184,.35)';
            }

            // 8. Mensaje de límite inferior
            const limitHint = document.getElementById('modalLimitHint');
            if (limitHint) {
                limitHint.textContent = isMayor ? 'Tarifa Mayorista activa (≥ 12 unidades). Al bajar a 11 o menos volverá a Detal.' : 'Tarifa Detal (1 a 11 unidades). Al ingresar 12 o más unidades cambiará automáticamente a Mayorista.';
                if (limitHint.parentElement && limitHint.parentElement.style) limitHint.parentElement.style.color = isMayor ? 'var(--ama)' : '#94a3b8';
            }

            // 9. Recalcular subtotal
            actualizarCalculosModal();
        }

        function renderModalFullContent() {
            const p = currentModalProduct;
            if (!p) return;
            const content = document.getElementById('productDetailContent');
            if (!content) return;

            const isMayor = currentModalTier === 'mayor';
            const unitPrice = isMayor ? +(p.price * 0.82).toFixed(2) : p.price;
            const subtotal = unitPrice * modalQty;
            const ahorroTotal = isMayor ? ((p.price - unitPrice) * modalQty) : 0;
            const sizesArr = parseProductSizes(p.sizes);

            content.innerHTML = `
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.55rem;flex-wrap:wrap;gap:.4rem">
                    <div style="display:flex;align-items:center;gap:.45rem;flex-wrap:wrap">
                        <span class="card-moto-badge" style="position:static">🏷️ ${p.code}</span>
                        <span style="font-size:.72rem;background:rgba(253,196,23,.15);color:var(--ama);border:1px solid rgba(253,196,23,.3);padding:.18rem .55rem;border-radius:999px;font-weight:700">
                            ${p.cat}
                        </span>
                    </div>
                    <div id="modalTierIndicatorBadge" style="font-size:.72rem;padding:.2rem .65rem;border-radius:20px;font-weight:700;display:inline-flex;align-items:center;gap:.3rem;${isMayor ? 'background:rgba(253,196,23,.2);color:var(--ama);border:1px solid rgba(253,196,23,.4)' : 'background:rgba(148,163,184,.15);color:#cbd5e1;border:1px solid rgba(148,163,184,.3)'}">
                        ${isMayor ? '⭐ Tarifa Mayorista' : '🛍️ Tarifa Detallado'}
                    </div>
                </div>

                <!-- PESTAÑAS DETALLADO VS MAYORISTA -->
                <div class="prod-modal-tabs">
                    <button type="button" id="tabDetalBtn" class="modal-tab-btn ${!isMayor ? 'active-detal' : ''}" onclick="cambiarTierModal('detal')">
                        <span>🛍️ Venta al Detal</span>
                        <span style="font-size:.72rem;opacity:.85;font-weight:500">(1 a 11 unid.)</span>
                    </button>
                    <button type="button" id="tabMayorBtn" class="modal-tab-btn ${isMayor ? 'active-mayor' : ''}" onclick="cambiarTierModal('mayor')">
                        <span>🏭 Venta al Mayor</span>
                        <span style="font-size:.7rem;background:${isMayor ? '#111' : '#fdc417'};color:${isMayor ? '#fdc417' : '#111'};padding:1px 6px;border-radius:4px;font-weight:800">Tarifa B2B (≥12)</span>
                    </button>
                </div>

                <div class="prod-modal-grid">
                    <!-- COLUMNA IZQUIERDA: TARJETA DE PRODUCTO Y PRECIO -->
                    <div id="modalMediaCard" style="display:flex;flex-direction:column;align-items:center;border-radius:14px;padding:1rem .9rem;justify-content:center;text-align:center;transition:all .25s ease;${isMayor ? 'background:linear-gradient(180deg, rgba(253,196,23,0.12) 0%, #151410 100%);border:1px solid rgba(253,196,23,0.5);box-shadow:0 4px 16px rgba(253,196,23,0.15)' : 'background:linear-gradient(180deg, #181d26 0%, #0f1217 100%);border:1px solid rgba(148,163,184,0.3);box-shadow:0 4px 16px rgba(0,0,0,0.3)'}">
                        <span style="font-size:3.8rem;filter:drop-shadow(0 8px 16px rgba(0,0,0,.6));line-height:1">${p.ico}</span>
                        
                        <div id="modalPriceBlock" style="margin-top:.7rem;width:100%">
                            ${isMayor ? `
                                <div style="font-size:.78rem;color:#9ca3af;text-decoration:line-through;margin-bottom:2px">$${p.price.toFixed(2)} USD</div>
                                <div style="font-size:1.55rem;font-weight:900;color:var(--ama);line-height:1.15">$${unitPrice.toFixed(2)} <span style="font-size:.75rem;color:#e5e7eb">USD/u</span></div>
                                <div style="display:inline-block;font-size:.7rem;color:var(--ama);font-weight:800;background:rgba(253,196,23,.15);border:1px solid rgba(253,196,23,.35);padding:.18rem .5rem;border-radius:6px;margin-top:.3rem">
                                    🏭 Tarifa Mayorista
                                </div>
                            ` : `
                                <div style="font-size:1.55rem;font-weight:900;color:#ffffff;line-height:1.15">$${p.price.toFixed(2)} <span style="font-size:.75rem;color:#9ca3af">USD/u</span></div>
                                <div style="display:inline-block;font-size:.7rem;color:#94a3b8;font-weight:700;background:rgba(148,163,184,.15);border:1px solid rgba(148,163,184,.3);padding:.18rem .5rem;border-radius:6px;margin-top:.3rem">
                                    🛍️ Tarifa Detallado
                                </div>
                            `}
                        </div>

                        <div id="modalTierHintBox" style="margin-top:.6rem;font-size:.72rem;line-height:1.35;width:100%;padding-top:.55rem;border-top:1px solid rgba(255,255,255,0.08)">
                            ${isMayor ? `
                                <span style="color:#fef08a">Al ser pedido mayorista (≥ 12 unid.) el valor unitario es de <b>$${unitPrice.toFixed(2)} USD</b>.</span>
                            ` : `
                                <span style="color:var(--gcl)">Compras de 1 a 11 unidades ($${p.price.toFixed(2)} USD/u).</span>
                            `}
                        </div>
                    </div>

                    <!-- COLUMNA DERECHA: ESPECIFICACIONES, TALLAS INTERACTIVAS Y CANTIDAD -->
                    <div>
                        <h3 style="font-size:1.15rem;font-weight:800;color:#fff;margin-bottom:.4rem;line-height:1.25">${p.name}</h3>

                        <!-- Tarjeta de condición directa sin justificaciones -->
                        <div id="modalTierNoticeBox" style="border-radius:9px;padding:.5rem .8rem;margin-bottom:.55rem;font-size:.77rem;line-height:1.35;display:flex;align-items:center;gap:.6rem;${isMayor ? 'background:linear-gradient(135deg, rgba(253,196,23,0.12) 0%, rgba(226,30,44,0.08) 100%);border:1px solid rgba(253,196,23,0.35);color:#fef08a' : 'background:#161d27;border:1px solid rgba(148,163,184,0.22);color:#cbd5e1'}">
                            <span style="font-size:1.15rem">${isMayor ? '🏭' : '🛍️'}</span>
                            <div>
                                ${isMayor ? `
                                    <b>Tarifa Mayorista (≥ 12 unid.):</b> Al ser compra mayorista cuenta con una tarifa de <b>$${unitPrice.toFixed(2)} USD</b> por unidad.
                                ` : `
                                    <b>Tarifa Detallado:</b> Valor unitario de <b>$${p.price.toFixed(2)} USD</b> para compras de 1 a 11 unidades.
                                `}
                            </div>
                        </div>

                        <!-- Ficha de materiales y especificaciones técnicas compactas -->
                        <div style="background:#20211f;border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:.55rem .8rem;margin-bottom:.55rem;display:flex;flex-direction:column;gap:.35rem;font-size:.76rem">
                            <div><b style="color:var(--ama)">🧵 Material / Tela:</b> <span style="color:#ddd">${p.mat}</span></div>
                            <div><b style="color:var(--ama)">🛡️ Certificación:</b> <span style="color:#ccc">Normas COVENIN / OSHA Industrial con costuras de alta tenacidad.</span></div>
                        </div>

                        <!-- SELECTOR INTERACTIVO DE TALLAS CON BOTONES -->
                        <div style="margin-bottom:.6rem;background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:.5rem .75rem">
                            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.35rem">
                                <span style="font-size:.76rem;font-weight:700;color:var(--gcl)">Selecciona la Talla:</span>
                                <span style="font-size:.73rem;color:#cbd5e1">Elegida: <b id="modalSelectedSizeDisplay" style="color:var(--ama);font-weight:800">${modalSelectedSize}</b></span>
                            </div>
                            <div id="modalSizesContainer" style="display:flex;flex-wrap:wrap;gap:.35rem;max-height:65px;overflow-y:auto;padding:2px 0">
                                ${sizesArr.map(s => `
                                    <button type="button" class="modal-size-btn ${s === modalSelectedSize ? 'active-size' : ''}"
                                        onmouseenter="seleccionarTallaModal('${s}')"
                                        onclick="seleccionarTallaModal('${s}')"
                                        data-size="${s}">
                                        ${s}
                                    </button>
                                `).join('')}
                            </div>
                        </div>

                        <!-- SELECTOR DE CANTIDAD CON ENTRADA NUMÉRICA LIBRE -->
                        <div style="background:rgba(0,0,0,0.25);border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:.55rem .85rem;margin-bottom:.75rem">
                            <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.6rem;margin-bottom:.35rem">
                                <div style="display:flex;align-items:center;gap:.65rem">
                                    <label for="modalQtyInput" style="font-size:.8rem;color:var(--gcl);font-weight:700">Cantidad:</label>
                                    
                                    <!-- Control con input numérico editable libremente SIN interrupciones -->
                                    <div id="modalQtyCtrlBox" class="cart-qty-ctrl" style="background:#121211;border:1px solid ${isMayor ? 'var(--ama)' : 'rgba(148,163,184,.35)'};padding:.15rem .35rem;display:flex;align-items:center;border-radius:8px;gap:2px">
                                        <button type="button" class="cart-qty-btn" style="width:28px;height:28px;cursor:pointer" onclick="modModalQty(-1)" title="Disminuir">−</button>
                                        <input type="number" id="modalQtyInput" min="1" max="9999" value="${modalQty}"
                                            style="width:58px;text-align:center;background:transparent;border:none;color:#fff;font-family:Poppins,sans-serif;font-weight:800;font-size:.98rem;outline:none;-moz-appearance:textfield"
                                            oninput="onModalQtyInput(this.value)"
                                            onchange="onModalQtyBlur(this.value)"
                                            title="Escribe directamente la cantidad deseada">
                                        <button type="button" class="cart-qty-btn" style="width:28px;height:28px;cursor:pointer" onclick="modModalQty(1)" title="Aumentar">+</button>
                                    </div>
                                </div>

                                <div style="text-align:right">
                                    <div style="font-size:.68rem;color:var(--gcl);text-transform:uppercase;letter-spacing:.04em">Subtotal Estimado</div>
                                    <div style="display:flex;align-items:baseline;justify-content:flex-end;gap:.3rem">
                                        <b id="modalSubtotalCalc" style="color:${isMayor ? 'var(--ama)' : '#ffffff'};font-size:1.2rem">$${subtotal.toFixed(2)}</b>
                                        <span style="font-size:.72rem;color:#9ca3af">USD</span>
                                    </div>
                                    <div id="modalAhorroTxt" style="font-size:.7rem;color:var(--ama);font-weight:700;display:${isMayor && ahorroTotal > 0 ? 'block' : 'none'}">
                                        Tarifa mayorista ($${unitPrice.toFixed(2)} c/u)
                                    </div>
                                </div>
                            </div>

                            <!-- Mensaje orientador del límite automático -->
                            <div style="font-size:.72rem;color:${isMayor ? 'var(--ama)' : '#94a3b8'};display:flex;align-items:center;gap:.35rem;padding-top:.35rem;border-top:1px dashed rgba(255,255,255,0.08)">
                                <span>${isMayor ? '⚡' : 'ℹ️'}</span>
                                <span id="modalLimitHint">
                                    ${isMayor ? 'Tarifa Mayorista activa (≥ 12 unidades). Al bajar a 11 o menos volverá a Detal.' : 'Tarifa Detal (1 a 11 unidades). Al ingresar 12 o más unidades cambiará automáticamente a Mayorista.'}
                                </span>
                            </div>
                        </div>

                        <div style="display:flex;gap:.65rem">
                            <button class="btn btn-w" style="flex:1;justify-content:center;padding:.75rem 1.1rem;font-size:.84rem;box-shadow:0 4px 15px ${isMayor ? 'rgba(253,196,23,0.35)' : 'rgba(226,30,44,0.35)'};cursor:pointer" onclick="addCartFromModal(${p.id})">
                                🛒 Añadir a mi Pedido
                            </button>
                            <button class="btn btn-o" style="padding:.75rem 1.1rem;color:#ccc;border-color:#555;cursor:pointer" onclick="cerrarDetalleProducto()">
                                Cerrar
                            </button>
                        </div>
                    </div>
                </div>
            `;
        }

        function addCartFromModal(id) {
            const size = modalSelectedSize || '';
            addCart(id, modalQty, size);
            cerrarDetalleProducto();
        }


        /* ---------- GESTIÓN DEL CARRITO & DRAWER ---------- */
        let toastTimer = null;
        function mostrarToast(msg) {
            const toast = document.getElementById('unifortexToast');
            if (!toast) return;
            toast.innerHTML = msg;
            toast.classList.add('show');
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.remove('show');
            }, 2800);
        }

        function openCartDrawer() {
            const drawer = document.getElementById('cartDrawer');
            const overlay = document.getElementById('cartDrawerOverlay');
            if (drawer) drawer.classList.add('open');
            if (overlay) overlay.classList.add('open');

            // Bloquear scroll de la página de fondo de forma inmediata y confiable
            document.documentElement.style.overflow = 'hidden';
            document.body.style.overflow = 'hidden';
            document.body.style.touchAction = 'none';

            renderCart();
        }

        function closeCartDrawer() {
            const drawer = document.getElementById('cartDrawer');
            const overlay = document.getElementById('cartDrawerOverlay');
            if (drawer) drawer.classList.remove('open');
            if (overlay) overlay.classList.remove('open');

            // Restaurar scroll de la página de fondo
            document.documentElement.style.overflow = '';
            document.body.style.overflow = '';
            document.body.style.touchAction = '';
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeCartDrawer();
        });

        // Prevenir que el overlay propague eventos de rueda hacia el fondo difuminado
        window.addEventListener('DOMContentLoaded', () => {
            const overlay = document.getElementById('cartDrawerOverlay');
            if (overlay) {
                overlay.addEventListener('wheel', (e) => e.preventDefault(), { passive: false });
                overlay.addEventListener('touchmove', (e) => e.preventDefault(), { passive: false });
            }
        });

        function addCart(id, qty = 1, size = '') {
            const addQty = parseInt(qty) || 1;
            cart[id] = (cart[id] || 0) + addQty;
            if (size) {
                cartSizes[id] = size;
            } else if (!cartSizes[id]) {
                const p = PRODUCTS.find(x => x.id == id);
                const sizesArr = parseProductSizes(p ? p.sizes : '');
                cartSizes[id] = sizesArr[0] || 'Única';
            }
            renderCart();
            openCartDrawer();
            const p = PRODUCTS.find(x => x.id == id);
            const extra = addQty > 1 ? ` (×${addQty})` : '';
            const esMayorista = cart[id] >= 12;
            const extraMayor = esMayorista ? ' <span style="color:var(--ama);font-weight:700">[Mayorista]</span>' : '';
            const sizeNote = cartSizes[id] ? ` [Talla: ${cartSizes[id]}]` : '';
            mostrarToast(`🛒 <b>${p ? p.name : 'Producto'}</b>${extra}${sizeNote}${extraMayor} añadido al carrito`);
        }

        function modCart(id, delta) {
            if (!cart[id]) return;
            cart[id] += delta;
            if (cart[id] <= 0) {
                delete cart[id];
            }
            renderCart();
        }

        function delCart(id) {
            const p = PRODUCTS.find(x => x.id == id);
            delete cart[id];
            renderCart();
            if (p) mostrarToast(`🗑️ ${p.name} eliminado del carrito`);
        }

        function clearCart() {
            cart = {};
            renderCart();
            mostrarToast('🧹 Carrito vaciado');
        }

        function renderCart() {
            const list = document.getElementById('cartList');
            const cartTotal = document.getElementById('cartTotal');
            const drawerList = document.getElementById('drawerCartList');
            const drawerEmpty = document.getElementById('drawerEmpty');
            const drawerSubtotal = document.getElementById('drawerSubtotal');
            const drawerIva = document.getElementById('drawerIva');
            const drawerTotal = document.getElementById('drawerTotal');
            const drawerCountPill = document.getElementById('drawerCountPill');
            const btnConfirm = document.getElementById('btnConfirmarCompraDrawer');
            const navBadge = document.getElementById('navCartBadge');

            const ids = Object.keys(cart);
            let totalQty = 0;
            let subtotal = 0;

            ids.forEach(id => {
                const q = cart[id];
                totalQty += q;
                const p = PRODUCTS.find(x => x.id == id);
                if (p) {
                    const unitPrice = getProductPrice(p, q);
                    subtotal += unitPrice * q;
                }
            });

            const iva = subtotal * 0.16;
            const total = subtotal + iva;

            // Actualizar badge en menú de navegación (normal y modo contraído)
            [navBadge, document.getElementById('scrolledNavCartBadge')].forEach(badge => {
                if (badge) {
                    if (totalQty > 0) {
                        badge.style.display = 'inline-flex';
                        badge.textContent = totalQty;
                        badge.classList.add('bump');
                        setTimeout(() => badge.classList.remove('bump'), 220);
                    } else {
                        badge.style.display = 'none';
                        badge.textContent = '0';
                    }
                }
            });

            // Actualizar pill contador en cabecera del drawer
            if (drawerCountPill) {
                drawerCountPill.textContent = `${totalQty} ${totalQty === 1 ? 'ítem' : 'ítems'}`;
            }

            // 1. Renderizar lista en panel lateral de Catálogo (Tu Kit)
            if (list && cartTotal) {
                if (!ids.length) {
                    list.innerHTML = '<li style="border:none;color:var(--gcl)">Aún no hay productos…</li>';
                    cartTotal.textContent = '$0.00';
                } else {
                    list.innerHTML = ids.map(id => {
                        const p = PRODUCTS.find(x => x.id == id);
                        const q = cart[id];
                        const unitPrice = getProductPrice(p, q);
                        return `<li><span>${p.ico} ${p.name} <b style="color:var(--ama)">×${q}</b></span><span>$${(unitPrice * q).toFixed(2)} <button style="background:none;border:none;color:#f66;cursor:pointer;font-size:1rem" onclick="delCart(${id})" title="Eliminar">✕</button></span></li>`;
                    }).join('');
                    cartTotal.textContent = '$' + subtotal.toFixed(2);
                }
            }

            // 2. Renderizar lista en el Drawer Desplegable
            if (drawerList && drawerEmpty) {
                if (!ids.length) {
                    drawerList.style.display = 'none';
                    drawerList.innerHTML = '';
                    drawerEmpty.style.display = 'flex';
                    if (btnConfirm) {
                        btnConfirm.disabled = true;
                        btnConfirm.style.opacity = '0.45';
                        btnConfirm.style.cursor = 'not-allowed';
                    }
                } else {
                    drawerEmpty.style.display = 'none';
                    drawerList.style.display = 'flex';
                    if (btnConfirm) {
                        btnConfirm.disabled = false;
                        btnConfirm.style.opacity = '1';
                        btnConfirm.style.cursor = 'pointer';
                    }
                    drawerList.innerHTML = ids.map(id => {
                        const p = PRODUCTS.find(x => x.id == id);
                        if (!p) return '';
                        const q = cart[id];
                        const unitPrice = getProductPrice(p, q);
                        const itemSub = unitPrice * q;
                        return `
                        <div class="cart-drawer-item">
                            <div class="cart-item-top">
                                <div class="cart-item-ico">${p.ico}</div>
                                <div class="cart-item-info">
                                    <div class="cart-item-cat">${p.cat}</div>
                                    <div class="cart-item-name" title="${p.name}">${p.name}</div>
                                    <div style="font-size:.72rem;color:var(--ama);font-weight:700;margin-top:2px">
                                        Talla: <span style="color:#fff">${cartSizes[id] || 'Estándar'}</span>
                                    </div>
                                    <div class="cart-item-unit-price">$${unitPrice.toFixed(2)} c/u ${q >= 12 ? '<span style="color:var(--ama);font-weight:700;font-size:.7rem">(Mayorista)</span>' : ''}</div>
                                </div>
                                <button class="cart-item-del-btn" onclick="delCart(${id})" aria-label="Eliminar ${p.name}" title="Quitar del carrito">✕</button>
                            </div>
                            <div class="cart-item-bottom">
                                <div class="cart-qty-ctrl">
                                    <button class="cart-qty-btn" onclick="modCart(${id}, -1)" title="Disminuir">−</button>
                                    <span class="cart-qty-num">${q}</span>
                                    <button class="cart-qty-btn" onclick="modCart(${id}, 1)" title="Aumentar">+</button>
                                </div>
                                <div class="cart-item-subtotal">$${itemSub.toFixed(2)}</div>
                            </div>
                        </div>`;
                    }).join('');
                }
            }

            // 3. Totales en el Drawer
            if (drawerSubtotal) drawerSubtotal.textContent = '$' + subtotal.toFixed(2);
            if (drawerIva) drawerIva.textContent = '$' + iva.toFixed(2);
            if (drawerTotal) drawerTotal.textContent = '$' + total.toFixed(2);

            // Actualizar banner de cotización en vista de Contacto/Cotiza
            actualizarBannerCotizacionCarrito();
        }

        function confirmarCompraDesdeDrawer() {
            const ids = Object.keys(cart);
            if (!ids.length) {
                alert('Tu carrito está vacío. Agrega productos desde el catálogo para continuar.');
                return;
            }
            ocItems = [];
            ids.forEach(id => {
                const p = PRODUCTS.find(x => x.id == id);
                if (p) {
                    const q = cart[id] || 1;
                    const sizeTxt = cartSizes[id] ? ` (Talla: ${cartSizes[id]})` : '';
                    ocItems.push({
                        nombre: `${p.ico} ${p.name}${sizeTxt}`,
                        cant: q,
                        precio: getProductPrice(p, q)
                    });
                }
            });
            renderOCTable();
            closeCartDrawer();
            navigateToTab('orden-compra');
            mostrarToast('✅ ¡Pedido cargado a tu Orden de Compra!');
        }

        function enviarCotizacion() {
            if (!Object.keys(cart).length) { alert('Añade al menos un producto a tu kit.'); return; }
            navigateToTab('cotiza');
        }

        /* ---------- CHATBOT ASISTENTE PROACTIVO DE VENTAS ---------- */
        const chatBox = document.getElementById('chatBox');
        const chatLog = document.getElementById('chatLog');
        const chatOpts = document.getElementById('chatOpts');
        const chatInput = document.getElementById('chatInput');
        const chatGreetingBubble = document.getElementById('chatGreetingBubble');
        const chatNotifDot = document.getElementById('chatNotifDot');

        let chatStep = 'idle';
        let chatProfile = {};
        let chatHistory = [];
        let greetingDismissed = false;
        let chatOpened = false;

        const SECTORS = {
            'Construcción': { items: ['⛑️ Casco c/ Rachet', '🦺 Chaleco Reflectivo', '🥾 Botas Punta Acero', '🧤 Guantes Anticorte'], ids: [44, 59, 22, 35] },
            'Industria': { items: ['🕶️ Lentes Avispa', '🧤 Guantes Nitrilo', '⛑️ Casco', '👕 Camisa Ignífuga'], ids: [26, 38, 44, 10] },
            'Salud': { items: ['😷 Mascarilla KN95', '🧤 Guantes Desechables', '🥼 Bata Manga Larga', '🧴 Protección'], ids: [54, 43, 12, 53] },
            'Alimentos': { items: ['🧤 Guantes Nitrilo', '😷 Mascarilla', '🥼 Delantal PVC', '👢 Botas PVC Blancas'], ids: [43, 53, 21, 24] },
            'Logística': { items: ['🦺 Chaleco Reflectivo', '⛑️ Casco', '🥾 Botas Seguridad', '🧤 Guantes'], ids: [59, 44, 22, 35] },
            'Minería': { items: ['⛑️ Casco c/ Rachet', '🥽 Monolente', '🧤 Guantes Carnaza', '🥾 Botas'], ids: [44, 28, 41, 22] },
            'Corporativo': { items: ['👔 Camisa Formal', '👚 Blusa Ejecutiva', '👕 Chemise Corporativo', '🧥 Chaqueta'], ids: [7, 8, 4, 55] }
        };

        const QUICK_ACTIONS = [
            { label: '🛒 Cotizar productos', action: 'cotizar' },
            { label: '📋 Ver Catálogo', action: 'catalogo' },
            { label: '🎨 Diseño Personalizado', action: 'diseno' },
            { label: '📍 Ver Sedes', action: 'sedes' },
            { label: '📞 Hablar con Asesor', action: 'asesor' }
        ];

        function getTimeStr() {
            const now = new Date();
            return now.getHours().toString().padStart(2,'0') + ':' + now.getMinutes().toString().padStart(2,'0');
        }

        function toggleChat() {
            const isOpen = chatBox.classList.toggle('open');
            const btn = document.getElementById('chatBtn');
            if (btn) btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            if (isOpen) {
                chatOpened = true;
                dismissGreeting();
                if (!chatLog.children.length) {
                    startConversation();
                } else {
                    chatLog.scrollTop = chatLog.scrollHeight;
                }
                setTimeout(() => chatInput && chatInput.focus(), 350);
            }
        }

        function openChat() {
            if (!chatBox.classList.contains('open')) {
                chatBox.classList.add('open');
                const btn = document.getElementById('chatBtn');
                if (btn) btn.setAttribute('aria-expanded', 'true');
                chatOpened = true;
                dismissGreeting();
                if (!chatLog.children.length) {
                    startConversation();
                } else {
                    chatLog.scrollTop = chatLog.scrollHeight;
                }
                setTimeout(() => chatInput && chatInput.focus(), 350);
            }
        }

        function closeChat() {
            if (chatBox.classList.contains('open')) {
                chatBox.classList.remove('open');
                const btn = document.getElementById('chatBtn');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
        }

        function restoreChatHistory() {
            if (!chatHistory || !chatHistory.length) return;
            chatLog.innerHTML = '';
            chatHistory.forEach(item => {
                const d = document.createElement('div');
                d.className = 'msg ' + (item.who === 'bot' ? 'bot' : 'usr');
                const timeHtml = item.time ? `<span class="msg-time">${item.time}</span>` : '';
                d.innerHTML = item.text + timeHtml;
                chatLog.appendChild(d);
            });
            chatLog.scrollTop = chatLog.scrollHeight;
            restoreChatOptions();
        }

        function restoreChatOptions() {
            if (chatStep === 'welcome' || chatStep === 'idle') {
                setOpts(QUICK_ACTIONS);
            } else if (chatStep === 'sector') {
                setOpts(Object.keys(SECTORS));
            } else if (chatStep === 'qty') {
                setOpts(['1-10', '11-50', '51-200', '+200']);
            } else if (chatStep === 'confirm_kit') {
                setOpts([
                    { label: '✅ Sí, cárgalo', action: 'cargar_kit' },
                    { label: '📋 Prefiero elegir yo', action: 'catalogo' },
                    { label: '📞 Quiero asesoría humana', action: 'asesor' }
                ]);
            } else {
                setOpts(QUICK_ACTIONS);
            }
        }

        function restartChat(confirmFirst = true) {
            if (confirmFirst && chatHistory.length > 0) {
                if (!confirm('¿Deseas reiniciar la conversación con el Asesor Virtual?\n(Se iniciará una nueva consulta sin modificar tu carrito ni pedidos)')) return;
            }
            chatHistory = [];
            chatProfile = {};
            chatStep = 'welcome';
            chatLog.innerHTML = '';
            chatOpts.innerHTML = '';
            localStorage.removeItem('uf_chatHistory');
            localStorage.removeItem('uf_chatStep');
            localStorage.removeItem('uf_chatProfile');
            saveState();
            startConversation();
        }

        function dismissGreeting() {
            greetingDismissed = true;
            if (chatGreetingBubble) chatGreetingBubble.style.display = 'none';
            if (chatNotifDot) chatNotifDot.style.display = 'none';
            localStorage.setItem('uf_greetingDismissed', 'true');
        }

        function showTyping() {
            const indicator = document.createElement('div');
            indicator.className = 'typing-indicator';
            indicator.id = 'typingIndicator';
            indicator.innerHTML = '<span></span><span></span><span></span>';
            chatLog.appendChild(indicator);
            chatLog.scrollTop = chatLog.scrollHeight;
        }

        function hideTyping() {
            const el = document.getElementById('typingIndicator');
            if (el) el.remove();
        }

        function botSay(text, delay = 600) {
            return new Promise(resolve => {
                showTyping();
                setTimeout(() => {
                    hideTyping();
                    const d = document.createElement('div');
                    d.className = 'msg bot';
                    d.innerHTML = text + `<span class="msg-time">${getTimeStr()}</span>`;
                    chatLog.appendChild(d);
                    chatLog.scrollTop = chatLog.scrollHeight;
                    chatHistory.push({ who: 'bot', text, time: getTimeStr() });
                    saveState();
                    resolve();
                }, delay);
            });
        }

        function addMsg(text, who) {
            const d = document.createElement('div');
            d.className = 'msg ' + who;
            d.innerHTML = text + `<span class="msg-time">${getTimeStr()}</span>`;
            chatLog.appendChild(d);
            chatLog.scrollTop = chatLog.scrollHeight;
            chatHistory.push({ who, text, time: getTimeStr() });
            saveState();
        }

        function setOpts(arr) {
            chatOpts.innerHTML = '';
            arr.forEach(o => {
                const b = document.createElement('button');
                b.textContent = typeof o === 'string' ? o : o.label;
                b.onclick = () => {
                    const val = typeof o === 'string' ? o : o.label;
                    const act = typeof o === 'string' ? null : o.action;
                    addMsg(val, 'usr');
                    if (act) handleAction(act);
                    else handleResponse(val);
                };
                chatOpts.appendChild(b);
            });
        }

        function sendMsg() {
            const v = chatInput.value.trim();
            if (!v) return;
            addMsg(v, 'usr');
            chatInput.value = '';
            handleResponse(v);
        }

        // Inicio de conversación proactiva
        async function startConversation() {
            chatStep = 'welcome';
            await botSay('¡Hola! 👋 Soy el <b>Asesor Virtual de UNIFORTEX</b>, tu aliado en equipos de protección personal y uniformes corporativos.', 400);
            await botSay('¿En qué puedo ayudarte hoy?', 500);
            setOpts(QUICK_ACTIONS);
        }

        // Manejar acciones rápidas
        async function handleAction(action) {
            setOpts([]);
            switch(action) {
                case 'cotizar':
                    chatStep = 'sector';
                    await botSay('¡Perfecto! Para darte la mejor recomendación, cuéntame: <b>¿en qué sector opera tu empresa?</b>');
                    setOpts(Object.keys(SECTORS).map(s => s));
                    break;

                case 'catalogo':
                    await botSay('📋 Te llevo directo al <b>catálogo completo</b> con más de 60 productos. ¡Explora todas las categorías!');
                    setTimeout(() => navigateToTab('config'), 800);
                    await botSay('¿Necesitas algo más?', 1200);
                    setOpts([
                        { label: '🛒 Sí, cotizar', action: 'cotizar' },
                        { label: '🎨 Diseñar uniforme', action: 'diseno' },
                        { label: '❌ No, gracias', action: 'despedir' }
                    ]);
                    break;

                case 'diseno':
                    await botSay('🎨 ¡Excelente! En nuestro <b>Estudio de Diseño</b> puedes personalizar camisas, chemises y franelas con tu logo. ¡Sube tu imagen y posiciónala donde quieras!');
                    setTimeout(() => navigateToTab('diseno'), 800);
                    await botSay('¿Quieres que te ayude con algo más?', 1200);
                    setOpts([
                        { label: '🛒 Cotizar EPP', action: 'cotizar' },
                        { label: '📞 Contactar asesor', action: 'asesor' },
                        { label: '❌ Estoy bien', action: 'despedir' }
                    ]);
                    break;

                case 'sedes':
                    await botSay('📍 <b>Nuestras sedes:</b><br><br>🏢 <b>Maracay:</b> CC Ciudad Jardín, Local 20<br>⏰ Lun-Vie 8:00am - 5:00pm<br><br>🏢 <b>Caracas:</b> Av. Libertador, Edif. Fertec, Piso 4');
                    await botSay('📱 <b>Teléfonos:</b><br>• +58 414-4938316<br>• +58 424-3409898<br>• +58 424-3056068<br><br>📧 grupounifortexventas@gmail.com', 800);
                    await botSay('¿Te gustaría algo más?', 1000);
                    setOpts([
                        { label: '🛒 Cotizar productos', action: 'cotizar' },
                        { label: '📋 Ver catálogo', action: 'catalogo' },
                        { label: '❌ Eso es todo', action: 'despedir' }
                    ]);
                    break;

                case 'asesor':
                    await botSay('📞 ¡Con gusto! Un asesor comercial estará encantado de atenderte.');
                    await botSay('Puedes contactarnos directamente:<br>📱 <b>WhatsApp:</b> +58 414-4938316<br>📧 <b>Email:</b> grupounifortexventas@gmail.com<br><br>O llena el formulario en <b>Contacto</b> y te respondemos en menos de 24h.', 800);
                    setTimeout(() => navigateToTab('cotiza'), 1200);
                    await botSay('¿Necesitas algo más?', 1400);
                    setOpts([
                        { label: '🛒 Cotizar ahora', action: 'cotizar' },
                        { label: '❌ Eso es todo', action: 'despedir' }
                    ]);
                    break;

                case 'despedir':
                    await botSay('¡Gracias por visitarnos! 🛡️ Recuerda que estamos aquí siempre que necesites equipar a tu equipo. ¡Proteger es prevenir! 💪');
                    chatStep = 'idle';
                    setTimeout(() => {
                        setOpts([{ label: '🔄 Iniciar nueva consulta', action: 'reiniciar' }]);
                    }, 800);
                    break;

                case 'reiniciar':
                    chatStep = 'welcome';
                    await botSay('¡Perfecto! ¿En qué más puedo ayudarte?', 300);
                    setOpts(QUICK_ACTIONS);
                    break;

                case 'cargar_kit':
                    const sectorData = SECTORS[chatProfile.sector];
                    if (sectorData) {
                        const qty = chatProfile.qty || 1;
                        sectorData.ids.forEach(id => {
                            cart[id] = (cart[id] || 0) + qty;
                        });
                        renderCart();
                        saveState();
                        await botSay(`✅ ¡Kit de <b>${chatProfile.sector}</b> cargado! (${sectorData.ids.length} productos × ${qty} unidades). Revisa tu carrito y ajusta cantidades.`);
                    }
                    await botSay('¿Algo más?', 600);
                    setOpts([
                        { label: '📋 Ver mi carrito', action: 'ver_carrito' },
                        { label: '📄 Generar Orden', action: 'orden' },
                        { label: '❌ Eso es todo', action: 'despedir' }
                    ]);
                    break;

                case 'ver_carrito':
                    openCartDrawer();
                    await botSay('🛒 He abierto tu carrito. Revisa los productos y ajusta las cantidades.', 400);
                    setOpts([
                        { label: '📄 Generar Orden de Compra', action: 'orden' },
                        { label: '🔄 Nueva consulta', action: 'reiniciar' }
                    ]);
                    break;

                case 'orden':
                    await botSay('📄 Te llevo a la <b>Orden de Compra</b> para que formalices tu pedido con todos los detalles fiscales.');
                    setTimeout(() => {
                        if (Object.keys(cart).length) confirmarCompraDesdeDrawer();
                        else navigateToTab('orden-compra');
                    }, 800);
                    await botSay('¿Necesitas algo más?', 1400);
                    setOpts([{ label: '🔄 Sí, otra consulta', action: 'reiniciar' }, { label: '❌ No, gracias', action: 'despedir' }]);
                    break;
            }
        }

        // Manejar respuestas de texto
        async function handleResponse(v) {
            const vl = v.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            setOpts([]);

            // --- Flujo de cotización por sector ---
            if (chatStep === 'sector') {
                const sectorKey = Object.keys(SECTORS).find(k => k.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '') === vl) || detectSector(vl);

                if (sectorKey) {
                    chatProfile.sector = sectorKey;
                    chatStep = 'qty';
                    const s = SECTORS[sectorKey];
                    await botSay(`Excelente 🎯 Para <b>${sectorKey}</b> recomendamos:<br>${s.items.map(x => '• ' + x).join('<br>')}`);
                    await botSay('¿Cuántos trabajadores necesitan equiparse?', 700);
                    setOpts(['1-10', '11-50', '51-200', '+200']);
                } else {
                    await botSay('No reconocí ese sector. ¿Podrías seleccionar uno de la lista?');
                    setOpts(Object.keys(SECTORS).map(s => s));
                }
                return;
            }

            if (chatStep === 'qty') {
                chatProfile.qtyLabel = v;
                const numMatch = v.match(/\d+/);
                chatProfile.qty = numMatch ? Math.min(parseInt(numMatch[0]), 200) : 10;
                chatStep = 'confirm_kit';
                const discount = chatProfile.qty >= 50 ? ' 🎁 ¡Aplicas para <b>descuento por volumen del 12%</b>!' : chatProfile.qty >= 10 ? ' 🎁 ¡Precio especial por <b>lote corporativo</b>!' : '';
                await botSay(`Perfecto. Con <b>${v}</b> trabajadores${discount}`);
                await botSay('¿Quieres que cargue un <b>kit sugerido</b> en tu carrito con los productos recomendados?', 700);
                setOpts([
                    { label: '✅ Sí, cárgalo', action: 'cargar_kit' },
                    { label: '📋 Prefiero elegir yo', action: 'catalogo' },
                    { label: '📞 Quiero asesoría humana', action: 'asesor' }
                ]);
                return;
            }

            // --- Detección inteligente de intención ---
            if (containsAny(vl, ['precio', 'cuanto cuesta', 'costo', 'vale'])) {
                chatStep = 'idle';
                await botSay('💰 Nuestros precios dependen del producto y la cantidad. Te invito a explorar el <b>catálogo</b> donde verás precios unitarios y por lote.');
                await botSay('¿Te gustaría que te ayude a armar un <b>kit personalizado</b> según tu sector?', 600);
                setOpts([
                    { label: '🛒 Sí, cotizar', action: 'cotizar' },
                    { label: '📋 Ver catálogo', action: 'catalogo' }
                ]);
                return;
            }

            if (containsAny(vl, ['envio', 'delivery', 'entregan', 'despacho'])) {
                await botSay('🚚 Realizamos <b>despachos a nivel nacional</b> por MRW, TEALCA y Zoom. Para Caracas y Maracay ofrecemos entrega directa. Contáctanos para coordinar.');
                setOpts([
                    { label: '📍 Ver sedes', action: 'sedes' },
                    { label: '📞 Contactar asesor', action: 'asesor' },
                    { label: '🔄 Otra consulta', action: 'reiniciar' }
                ]);
                return;
            }

            if (containsAny(vl, ['pago', 'transferencia', 'dolares', 'bolivares', 'efectivo', 'zelle'])) {
                await botSay('💳 Aceptamos múltiples formas de pago:<br>• Transferencia bancaria (Bs/USD)<br>• Pago móvil<br>• Zelle<br>• Efectivo en sedes<br>• Crédito a 15/30 días (empresas con RIF)');
                setOpts([
                    { label: '🛒 Cotizar ahora', action: 'cotizar' },
                    { label: '📞 Más detalles', action: 'asesor' },
                    { label: '🔄 Otra consulta', action: 'reiniciar' }
                ]);
                return;
            }

            if (containsAny(vl, ['gracias', 'ok', 'listo', 'chao', 'bye', 'adios'])) {
                await handleAction('despedir');
                return;
            }

            if (containsAny(vl, ['hola', 'buenos dias', 'buenas', 'hey', 'saludos'])) {
                await botSay('¡Hola! 😊 Me alegra que estés aquí. ¿En qué puedo ayudarte?');
                setOpts(QUICK_ACTIONS);
                return;
            }

            if (containsAny(vl, ['catalogo', 'productos', 'que venden', 'que tienen'])) {
                await handleAction('catalogo');
                return;
            }

            if (containsAny(vl, ['diseno', 'personalizar', 'logo', 'bordar', 'estampar'])) {
                await handleAction('diseno');
                return;
            }

            if (containsAny(vl, ['ubicacion', 'donde', 'direccion', 'sede', 'tienda'])) {
                await handleAction('sedes');
                return;
            }

            if (containsAny(vl, ['humano', 'persona', 'vendedor', 'asesor', 'llamar', 'telefono', 'whatsapp'])) {
                await handleAction('asesor');
                return;
            }

            // Respuesta genérica inteligente
            await botSay('Entiendo 🤔 No estoy seguro de cómo ayudarte con eso, pero puedo conectarte con un asesor humano o ayudarte con estas opciones:');
            setOpts(QUICK_ACTIONS);
        }

        // Utilidades
        function containsAny(text, keywords) {
            return keywords.some(k => text.includes(k));
        }

        function detectSector(text) {
            const map = {
                'constru': 'Construcción', 'obra': 'Construcción', 'albañ': 'Construcción',
                'industr': 'Industria', 'fabrica': 'Industria', 'manufact': 'Industria',
                'salud': 'Salud', 'hospital': 'Salud', 'clinic': 'Salud', 'medic': 'Salud',
                'aliment': 'Alimentos', 'comida': 'Alimentos', 'restaurant': 'Alimentos', 'cocina': 'Alimentos',
                'logist': 'Logística', 'transpo': 'Logística', 'almacen': 'Logística',
                'miner': 'Minería', 'petrol': 'Minería', 'perfor': 'Minería',
                'oficin': 'Corporativo', 'corpor': 'Corporativo', 'empres': 'Corporativo'
            };
            for (const [key, sector] of Object.entries(map)) {
                if (text.includes(key)) return sector;
            }
            return null;
        }

        // Saludo proactivo (aparece tras 4 segundos si no se ha cerrado antes)
        function initProactiveGreeting() {
            if (localStorage.getItem('uf_greetingDismissed') === 'true') return;
            setTimeout(() => {
                if (!chatOpened && !greetingDismissed) {
                    if (chatGreetingBubble) chatGreetingBubble.style.display = 'block';
                    if (chatNotifDot) chatNotifDot.style.display = 'block';
                }
            }, 4000);
        }

        initProactiveGreeting();

        /* ---------- PERSISTENCIA LOCAL (localStorage) ---------- */
        function saveState() {
            try {
                localStorage.setItem('uf_cart', JSON.stringify(cart));
                localStorage.setItem('uf_cartSizes', JSON.stringify(cartSizes));
                localStorage.setItem('uf_ocItems', JSON.stringify(ocItems));
                localStorage.setItem('uf_chatHistory', JSON.stringify(chatHistory));
                localStorage.setItem('uf_chatStep', chatStep);
                localStorage.setItem('uf_chatProfile', JSON.stringify(chatProfile));
                // disenoLogos se guarda sin imágenes binarias (solo logos de texto)
                const logosClean = {};
                for (const [ang, arr] of Object.entries(disenoLogos)) {
                    logosClean[ang] = arr.filter(l => l.type === 'text').map(l => ({...l}));
                }
                localStorage.setItem('uf_disenoLogos', JSON.stringify(logosClean));
                localStorage.setItem('uf_disenoState', JSON.stringify(disenoState));
            } catch(e) { /* localStorage lleno o no disponible */ }
        }

        function loadState() {
            try {
                const savedCart = localStorage.getItem('uf_cart');
                const savedCartSizes = localStorage.getItem('uf_cartSizes');
                if (savedCartSizes) { try { cartSizes = JSON.parse(savedCartSizes); } catch(e){} }
                if (savedCart) { cart = JSON.parse(savedCart); renderCart(); }

                const savedOC = localStorage.getItem('uf_ocItems');
                if (savedOC) { ocItems = JSON.parse(savedOC); renderOCTable(); }

                const savedLogos = localStorage.getItem('uf_disenoLogos');
                if (savedLogos) {
                    const parsed = JSON.parse(savedLogos);
                    for (const [ang, arr] of Object.entries(parsed)) {
                        if (disenoLogos[ang]) disenoLogos[ang] = arr;
                    }
                }

                const savedDisenoState = localStorage.getItem('uf_disenoState');
                if (savedDisenoState) {
                    const parsed = JSON.parse(savedDisenoState);
                    Object.assign(disenoState, parsed);
                }

                const savedChatHistory = localStorage.getItem('uf_chatHistory');
                if (savedChatHistory) {
                    chatHistory = JSON.parse(savedChatHistory);
                }

                const savedChatStep = localStorage.getItem('uf_chatStep');
                if (savedChatStep) chatStep = savedChatStep;

                const savedChatProfile = localStorage.getItem('uf_chatProfile');
                if (savedChatProfile) chatProfile = JSON.parse(savedChatProfile);

                if (chatHistory && chatHistory.length) {
                    restoreChatHistory();
                }
            } catch(e) { /* ignorar errores de parseo */ }
        }

        // Auto-guardado en cada modificación de carrito / OC
        const _origAddCart = addCart;
        addCart = function(id, qty, size) { _origAddCart(id, qty, size); saveState(); };
        const _origModCart = modCart;
        modCart = function(id, delta) { _origModCart(id, delta); saveState(); };
        const _origDelCart = delCart;
        delCart = function(id) { if (cartSizes[id]) delete cartSizes[id]; _origDelCart(id); saveState(); };
        const _origClearCart = clearCart;
        clearCart = function() { cartSizes = {}; _origClearCart(); saveState(); };
        const _origCambiarCantOC = cambiarCantOC;
        cambiarCantOC = function(idx, d) { _origCambiarCantOC(idx, d); saveState(); };
        const _origEliminarItemOC = eliminarItemOC;
        eliminarItemOC = function(idx) { _origEliminarItemOC(idx); saveState(); };
        const _origAgregarItemManualOC = agregarItemManualOC;
        agregarItemManualOC = function() { _origAgregarItemManualOC(); saveState(); };

        // Cargar estado guardado
        loadState();

        // Cerrar chat con Escape (minimizar)
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && chatBox && chatBox.classList.contains('open')) {
                closeChat();
            }
        });

        /* ---------- MODALES ---------- */
        function openModal(id) { document.getElementById(id).classList.add('open'); }
        function closeModal(id) { document.getElementById(id).classList.remove('open'); }
        function loginClient() {
            const e = document.getElementById('cliEmail').value || 'cliente@empresa.com';
            document.getElementById('cliName').textContent = e;
            document.getElementById('loginView').style.display = 'none';
            document.getElementById('dashView').style.display = 'block';
        }
        document.querySelectorAll('.modal').forEach(m => m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open') }));

        /* ---------- RESPONSIVE CFG ---------- */
        function fixCfg() { const g = document.querySelector('.cfg-grid'); if (!g) return; g.style.gridTemplateColumns = window.innerWidth < 900 ? '1fr' : '1fr 340px'; }
        fixCfg(); window.addEventListener('resize', fixCfg);

        /* ---------- CARRUSEL HERO ---------- */
        let curSlide = 0, slideTimer = null;
        const heroSlides = document.querySelectorAll('.hero-slide');
        const heroDots = document.querySelectorAll('.carousel-dot');
        function goToSlide(n) {
            heroSlides.forEach((s, i) => s.classList.toggle('active', i === n));
            heroDots.forEach((d, i) => d.classList.toggle('active', i === n));
            curSlide = n;
            if (slideTimer) clearInterval(slideTimer);
            slideTimer = setInterval(() => { goToSlide((curSlide + 1) % heroSlides.length); }, 5500);
        }
        if (heroSlides.length) slideTimer = setInterval(() => { goToSlide((curSlide + 1) % heroSlides.length); }, 5500);

        /* ---------- DISEÑO PERSONALIZADO INTERACTIVO (ESTUDIO PROFESIONAL) ---------- */
        let disenoState = {
            prendaKey: 'camisa',
            prendaIco: '👔',
            prendaNombre: 'Camisa Industrial Reforzada',
            prendaPrecio: 22.0,
            tecnica: 'Bordado Computarizado',
            tecnicaPrecio: 3.5,
            angulo: 'frente',
            color: '#0a192f',
            colorNombre: 'Azul Marino',
            logoTexto: 'TU LOGO AQUÍ'
        };

        // Almacén de logos colocados por cada ángulo (Frente, Espalda, Manga Izq, Manga Der)
        let disenoLogos = {
            'frente': [
                { id: 'logo_def_1', type: 'text', text: 'TU LOGO', x: 130, y: 155, scale: 1.0, width: 90, height: 42 }
            ],
            'espalda': [],
            'manga-izq': [],
            'manga-der': []
        };

        let activeLogoId = 'logo_def_1';
        let rawUploadedLogo = null;
        let noBgUploadedLogo = null;
        let isBgRemoved = false;

        // Selección de prenda
        function setDisenoPrenda(key, ico, nombre, precio, btn) {
            disenoState.prendaKey = key;
            disenoState.prendaIco = ico;
            disenoState.prendaNombre = nombre;
            disenoState.prendaPrecio = precio;

            if (btn) {
                document.querySelectorAll('#chipsPrenda .opt-chip').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }
            renderDisenoStudio();
        }

        // Selección de ángulo (Frente, Espalda, Manga Izquierda, Manga Derecha)
        function setDisenoAngulo(anguloKey, btn) {
            disenoState.angulo = anguloKey;

            // Actualizar botones en panel lateral
            document.querySelectorAll('#chipsAngulo .opt-chip').forEach(b => {
                const clickAttr = b.getAttribute('onclick') || '';
                b.classList.toggle('active', clickAttr.includes(`'${anguloKey}'`));
            });

            // Actualizar botones en barra sobre el boceto
            document.querySelectorAll('#previewAngleNav .diseno-angle-btn').forEach(b => {
                const clickAttr = b.getAttribute('onclick') || '';
                b.classList.toggle('active', clickAttr.includes(`'${anguloKey}'`));
            });

            // Badge indicador
            const badge = document.getElementById('previewAnguloBadge');
            if (badge) {
                const labels = {
                    'frente': 'FRENTE',
                    'espalda': 'ESPALDA',
                    'manga-izq': 'MANGA IZQUIERDA',
                    'manga-der': 'MANGA DERECHA'
                };
                badge.textContent = labels[anguloKey] || anguloKey.toUpperCase();
            }

            // Seleccionar primer logo de este ángulo si existe
            const list = disenoLogos[anguloKey] || [];
            activeLogoId = list.length ? list[list.length - 1].id : null;

            renderDisenoStudio();
        }

        // Selección de color de tela
        function setDisenoColor(color, nombre, elem) {
            disenoState.color = color;
            disenoState.colorNombre = nombre;
            document.querySelectorAll('.swatches-bar .swatch-circle').forEach(s => s.classList.remove('active'));
            if (elem) elem.classList.add('active');
            const lbl = document.getElementById('disenoColorLabel');
            if (lbl) lbl.textContent = nombre;
            renderDisenoStudio();
        }

        // Selección de técnica
        function setDisenoTecnica(nombre, precio, btn) {
            disenoState.tecnica = nombre;
            disenoState.tecnicaPrecio = precio;
            if (btn) {
                document.querySelectorAll('#chipsTecnica .opt-chip').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
            }
            renderDisenoStudio();
        }

        function actualizarTextoLogo(val) {
            disenoState.logoTexto = val.trim() || 'TU LOGO';
            const list = disenoLogos[disenoState.angulo];
            const active = list.find(l => l.id === activeLogoId && l.type === 'text');
            if (active) {
                active.text = disenoState.logoTexto;
                renderPlacedLogos();
            }
        }

        // Función de eliminación inteligente de fondo mediante Canvas HTML5
        function removeImageBackground(img, tolerance = 40) {
            const canvas = document.createElement('canvas');
            const w = img.naturalWidth || img.width || 300;
            const h = img.naturalHeight || img.height || 300;
            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);

            const imgData = ctx.getImageData(0, 0, w, h);
            const data = imgData.data;

            // Muestreo de las esquinas para determinar el color de fondo predominante
            const samplePoints = [
                [2, 2], [w - 3, 2], [2, h - 3], [w - 3, h - 3],
                [Math.floor(w / 2), 2], [2, Math.floor(h / 2)], [w - 3, Math.floor(h / 2)]
            ];

            let rSum = 0, gSum = 0, bSum = 0, count = 0;
            samplePoints.forEach(([x, y]) => {
                if (x >= 0 && x < w && y >= 0 && y < h) {
                    const idx = (y * w + x) * 4;
                    if (data[idx + 3] > 20) {
                        rSum += data[idx];
                        gSum += data[idx + 1];
                        bSum += data[idx + 2];
                        count++;
                    }
                }
            });

            const bgR = count ? (rSum / count) : 255;
            const bgG = count ? (gSum / count) : 255;
            const bgB = count ? (bSum / count) : 255;

            for (let i = 0; i < data.length; i += 4) {
                const r = data[i];
                const g = data[i + 1];
                const b = data[i + 2];
                const a = data[i + 3];

                if (a === 0) continue;

                // Distancia euclidiana respecto al color de fondo
                const dist = Math.sqrt(
                    Math.pow(r - bgR, 2) +
                    Math.pow(g - bgG, 2) +
                    Math.pow(b - bgB, 2)
                );

                const isWhiteLike = (r > 236 && g > 236 && b > 236 && bgR > 215 && bgG > 215 && bgB > 215);

                if (dist <= tolerance || isWhiteLike) {
                    data[i + 3] = 0; // Transparente
                } else if (dist < tolerance + 16) {
                    const alphaFactor = (dist - tolerance) / 16;
                    data[i + 3] = Math.round(a * alphaFactor);
                }
            }

            ctx.putImageData(imgData, 0, 0);
            return canvas.toDataURL('image/png');
        }

        // Carga y procesamiento del logo subido por el usuario
        function cargarLogoSimulado(e) {
            const file = e.target.files && e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (evt) {
                const dataUrl = evt.target.result;
                rawUploadedLogo = dataUrl;

                const img = new Image();
                img.crossOrigin = 'anonymous';
                img.onload = function () {
                    // Generar versión sin fondo automáticamente
                    try {
                        noBgUploadedLogo = removeImageBackground(img, 42);
                        isBgRemoved = true;
                    } catch (err) {
                        noBgUploadedLogo = rawUploadedLogo;
                        isBgRemoved = false;
                    }

                    // Colocar logo en el ángulo actual
                    agregarNuevoLogo(isBgRemoved ? noBgUploadedLogo : rawUploadedLogo, 'image');

                    // Actualizar tarjeta de thumbnail en el panel
                    const card = document.getElementById('uploadedLogoCard');
                    const thumb = document.getElementById('uploadedLogoThumbImg');
                    const fname = document.getElementById('uploadedLogoFilename');
                    const fstatus = document.getElementById('uploadedLogoStatus');

                    if (card) card.style.display = 'flex';
                    if (thumb) thumb.src = isBgRemoved ? noBgUploadedLogo : rawUploadedLogo;
                    if (fname) fname.textContent = file.name || 'Logotipo cargado';
                    if (fstatus) fstatus.textContent = isBgRemoved ? '✨ Fondo transparente automático' : 'Fondo original';

                    actualizarBotonesBgUI();
                    mostrarToast('✨ ¡Logo cargado y colocado en el boceto!');
                };
                img.src = dataUrl;
            };
            reader.readAsDataURL(file);
        }

        // Alternar entre quitar fondo o restaurar fondo original
        function toggleQuitarFondo() {
            if (!rawUploadedLogo) {
                alert('Primero sube una imagen de logo usando el botón "Subir Imagen de Logo".');
                return;
            }

            isBgRemoved = !isBgRemoved;
            const activeSrc = (isBgRemoved && noBgUploadedLogo) ? noBgUploadedLogo : rawUploadedLogo;

            // Actualizar todos los logos de tipo imagen en todos los ángulos
            Object.keys(disenoLogos).forEach(ang => {
                disenoLogos[ang].forEach(l => {
                    if (l.type === 'image') l.src = activeSrc;
                });
            });

            // Actualizar miniatura
            const thumb = document.getElementById('uploadedLogoThumbImg');
            const fstatus = document.getElementById('uploadedLogoStatus');
            if (thumb) thumb.src = activeSrc;
            if (fstatus) fstatus.textContent = isBgRemoved ? '✨ Fondo transparente automático' : 'Fondo original conservado';

            actualizarBotonesBgUI();
            renderPlacedLogos();
            mostrarToast(isBgRemoved ? '✨ Fondo de logo removido' : '🖼️ Fondo original restaurado');
        }

        function actualizarBotonesBgUI() {
            const b1 = document.getElementById('btnToolbarBg');
            const b2 = document.getElementById('btnSideToggleBg');
            const txt = isBgRemoved ? '🖼️ Fondo original' : '✨ Sin fondo';
            if (b1) {
                b1.innerHTML = txt;
                b1.classList.toggle('active-flag', isBgRemoved);
            }
            if (b2) {
                b2.innerHTML = isBgRemoved ? '🖼️ Restaurar fondo original' : '✨ Quitar fondo automático';
            }
        }

        // Añadir nuevo logo a la prenda
        function agregarNuevoLogo(src, type = 'image', text = '') {
            const list = disenoLogos[disenoState.angulo];
            // Posición por defecto según ángulo
            let defX = 145, defY = 150;
            if (disenoState.angulo === 'manga-izq' || disenoState.angulo === 'manga-der') {
                defX = 155;
                defY = 160;
            } else if (disenoState.angulo === 'espalda') {
                defX = 140;
                defY = 150;
            }

            const item = {
                id: 'logo_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
                type: type,
                src: src,
                text: text || disenoState.logoTexto,
                x: defX,
                y: defY,
                scale: 1.0,
                width: type === 'image' ? 92 : 88,
                height: type === 'image' ? 92 : 44
            };
            list.push(item);
            activeLogoId = item.id;
            renderPlacedLogos();
        }

        function agregarLogoTexto(txt) {
            const val = (txt || disenoState.logoTexto || 'TU LOGO').trim();
            agregarNuevoLogo('', 'text', val);
            mostrarToast('🏷️ Texto añadido al boceto');
        }

        // Duplicar el logo cuantas veces sea pedido por el usuario
        function duplicarLogo() {
            const list = disenoLogos[disenoState.angulo];
            let source = list.find(l => l.id === activeLogoId);
            if (!source && list.length > 0) source = list[list.length - 1];

            if (!source) {
                if (rawUploadedLogo) {
                    agregarNuevoLogo(isBgRemoved && noBgUploadedLogo ? noBgUploadedLogo : rawUploadedLogo, 'image');
                } else {
                    agregarLogoTexto(disenoState.logoTexto);
                }
                return;
            }

            // Crear clon con desplazamiento de +22px
            const cloned = {
                id: 'logo_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
                type: source.type,
                src: source.src,
                text: source.text,
                x: Math.min(Math.max(20, source.x + 22), 260),
                y: Math.min(Math.max(40, source.y + 22), 300),
                scale: source.scale || 1.0,
                width: source.width || 90,
                height: source.height || 90
            };

            list.push(cloned);
            activeLogoId = cloned.id;
            renderPlacedLogos();
            mostrarToast('➕ ¡Logo duplicado con éxito! Muévelo libremente.');
        }

        // Ajustar escala del logo seleccionado
        function ajustarEscalaLogo(delta) {
            const list = disenoLogos[disenoState.angulo];
            let item = list.find(l => l.id === activeLogoId);
            if (!item && list.length > 0) item = list[list.length - 1];
            if (!item) return;

            item.scale = Math.max(0.4, Math.min(2.4, (item.scale || 1.0) + delta));
            renderPlacedLogos();
        }

        // Eliminar logo seleccionado
        function eliminarLogoActivo() {
            const list = disenoLogos[disenoState.angulo];
            const idx = list.findIndex(l => l.id === activeLogoId);
            if (idx !== -1) {
                list.splice(idx, 1);
                activeLogoId = list.length ? list[list.length - 1].id : null;
                renderPlacedLogos();
                mostrarToast('🗑️ Logo eliminado del boceto');
            } else if (list.length > 0) {
                list.pop();
                activeLogoId = list.length ? list[list.length - 1].id : null;
                renderPlacedLogos();
            }
        }

        // Limpiar todos los logos del ángulo actual
        function limpiarLogosAngulo() {
            disenoLogos[disenoState.angulo] = [];
            activeLogoId = null;
            renderPlacedLogos();
            mostrarToast('🧹 Ángulo limpiado');
        }

        // Comprobación de brillo para contraste de costuras y líneas
        function isHexColorDark(hex) {
            const c = (hex || '#000').replace('#', '');
            const r = parseInt(c.substr(0, 2) || '0', 16);
            const g = parseInt(c.substr(2, 2) || '0', 16);
            const b = parseInt(c.substr(4, 2) || '0', 16);
            return ((r * 299 + g * 587 + b * 114) / 1000) < 130;
        }

        // Generador vectorial SVG de las prendas en alta definición para cada ángulo
        function getGarmentSvg(prenda, angulo, color) {
            const isDark = isHexColorDark(color);
            const seamColor = isDark ? 'rgba(255, 255, 255, 0.22)' : 'rgba(0, 0, 0, 0.22)';
            const seamDark = isDark ? 'rgba(0, 0, 0, 0.35)' : 'rgba(0, 0, 0, 0.12)';
            const stitchColor = isDark ? 'rgba(255, 255, 255, 0.35)' : 'rgba(0, 0, 0, 0.32)';
            const buttonFill = isDark ? '#ffffff' : '#f0f0f0';
            const buttonBorder = isDark ? '#aaaaaa' : '#888888';

            // 1. FRANELA (T-SHIRT)
            if (prenda === 'franela') {
                if (angulo === 'frente') {
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="tshShadeF" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.18"/>
                                <stop offset="35%" stop-color="#fff" stop-opacity="0.08"/>
                                <stop offset="65%" stop-color="#fff" stop-opacity="0.08"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.18"/>
                            </linearGradient>
                        </defs>
                        <!-- Cuerpo y mangas -->
                        <path d="M 145,55 L 75,102 L 40,165 L 85,190 L 108,155 L 112,365 Q 200,375 288,365 L 292,155 L 315,190 L 360,165 L 325,102 L 255,55 C 228,88 172,88 145,55 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <!-- Sombra volumétrica -->
                        <path d="M 145,55 L 75,102 L 40,165 L 85,190 L 108,155 L 112,365 Q 200,375 288,365 L 292,155 L 315,190 L 360,165 L 325,102 L 255,55 Z" 
                              fill="url(#tshShadeF)"/>
                        <!-- Cuello interior oscuro -->
                        <path d="M 152,53 C 176,68 224,68 248,53 C 238,44 162,44 152,53 Z" fill="#000" opacity="0.38"/>
                        <!-- Cuello acanalado frontal -->
                        <path d="M 145,55 C 172,88 228,88 255,55 C 245,46 155,46 145,55 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8"/>
                        <path d="M 147,57 C 173,85 227,85 253,57" stroke="${stitchColor}" stroke-width="1.2" stroke-dasharray="2.5,2" fill="none"/>
                        <!-- Costuras de mangas -->
                        <line x1="75" y1="102" x2="108" y2="155" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                        <line x1="325" y1="102" x2="292" y2="155" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                        <!-- Ruedo inferior -->
                        <path d="M 112,356 Q 200,366 288,356" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2" fill="none"/>
                    </svg>`;
                } else if (angulo === 'espalda') {
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <path d="M 145,55 L 75,102 L 40,165 L 85,190 L 108,155 L 112,365 Q 200,375 288,365 L 292,155 L 315,190 L 360,165 L 325,102 L 255,55 C 228,66 172,66 145,55 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <!-- Cuello posterior alto -->
                        <path d="M 145,55 C 172,66 228,66 255,55" stroke="${seamColor}" stroke-width="2.2" fill="none"/>
                        <path d="M 146,57 C 173,68 227,68 254,57" stroke="${stitchColor}" stroke-width="1.2" stroke-dasharray="2.5,2" fill="none"/>
                        <!-- Costura canesú hombros -->
                        <path d="M 108,98 Q 200,108 292,98" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2" fill="none"/>
                        <!-- Ruedo inferior -->
                        <path d="M 112,356 Q 200,366 288,356" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2" fill="none"/>
                    </svg>`;
                } else if (angulo === 'manga-izq') {
                    // Vista lateral izquierda (de costado)
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="tshLatShadeL" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.25"/>
                                <stop offset="25%" stop-color="#fff" stop-opacity="0.08"/>
                                <stop offset="70%" stop-color="#fff" stop-opacity="0.04"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.28"/>
                            </linearGradient>
                            <linearGradient id="torsoBgShadeL" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.32"/>
                                <stop offset="40%" stop-color="#fff" stop-opacity="0.06"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.22"/>
                            </linearGradient>
                        </defs>
                        <!-- Torso en perspectiva lateral (espalda a la izquierda, pecho a la derecha) -->
                        <path d="M 155,54 C 140,76 128,125 126,190 L 130,285 L 134,365 Q 200,374 266,365 L 268,285 C 274,210 278,145 274,115 C 270,90 258,78 244,74 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 155,54 C 140,76 128,125 126,190 L 130,285 L 134,365 Q 200,374 266,365 L 268,285 C 274,210 278,145 274,115 C 270,90 258,78 244,74 Z" 
                              fill="url(#torsoBgShadeL)"/>
                        <!-- Cuello en perfil lateral -->
                        <path d="M 155,54 C 185,68 220,74 244,74" stroke="${seamColor}" stroke-width="3" fill="none"/>
                        <path d="M 157,56 C 186,70 219,75 242,75" stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="2.5,2" fill="none"/>
                        <!-- Costura lateral del torso -->
                        <line x1="200" y1="148" x2="200" y2="365" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                        <path d="M 134,358 Q 200,366 266,358" stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="3,2" fill="none"/>
                        <!-- Manga principal vista 100% de costado / perfil -->
                        <ellipse cx="199" cy="232" rx="46" ry="11" fill="#000" opacity="0.35"/>
                        <!-- Cuerpo de la manga cilíndrica -->
                        <path d="M 148,136 L 153,232 Q 199,244 245,232 L 248,136 C 240,82 220,58 198,58 C 176,58 156,82 148,136 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 148,136 L 153,232 Q 199,244 245,232 L 248,136 C 240,82 220,58 198,58 C 176,58 156,82 148,136 Z" 
                              fill="url(#tshLatShadeL)"/>
                        <!-- Sisa de unión de la manga al hombro -->
                        <path d="M 148,136 C 156,82 176,58 198,58 C 220,58 240,82 248,136 Q 198,148 148,136 Z" 
                              stroke="${seamColor}" stroke-width="1.8" fill="none"/>
                        <path d="M 152,132 C 160,84 178,62 198,62 C 218,62 236,84 244,132" 
                              stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="3,2" fill="none"/>
                        <!-- Dobladillo con costura pespunte doble de franela -->
                        <path d="M 153,232 Q 199,244 245,232" stroke="${seamColor}" stroke-width="2.4" fill="none"/>
                        <path d="M 154,224 Q 199,236 244,224" stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="3,2" fill="none"/>
                        <path d="M 155,221 Q 199,233 243,221" stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="3,2" fill="none"/>
                    </svg>`;
                } else { // manga-der: Vista lateral derecha (de costado simétrica)
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="tshLatShadeR" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.28"/>
                                <stop offset="30%" stop-color="#fff" stop-opacity="0.04"/>
                                <stop offset="75%" stop-color="#fff" stop-opacity="0.08"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.25"/>
                            </linearGradient>
                            <linearGradient id="torsoBgShadeR" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.22"/>
                                <stop offset="60%" stop-color="#fff" stop-opacity="0.06"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.32"/>
                            </linearGradient>
                        </defs>
                        <!-- Torso en perspectiva lateral (pecho a la izquierda, espalda a la derecha) -->
                        <path d="M 245,54 C 260,76 272,125 274,190 L 270,285 L 266,365 Q 200,374 134,365 L 132,285 C 126,210 122,145 126,115 C 130,90 142,78 156,74 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 245,54 C 260,76 272,125 274,190 L 270,285 L 266,365 Q 200,374 134,365 L 132,285 C 126,210 122,145 126,115 C 130,90 142,78 156,74 Z" 
                              fill="url(#torsoBgShadeR)"/>
                        <!-- Cuello en perfil lateral -->
                        <path d="M 245,54 C 215,68 180,74 156,74" stroke="${seamColor}" stroke-width="3" fill="none"/>
                        <path d="M 243,56 C 214,70 181,75 158,75" stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="2.5,2" fill="none"/>
                        <!-- Costura lateral del torso -->
                        <line x1="200" y1="148" x2="200" y2="365" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                        <path d="M 266,358 Q 200,366 134,358" stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="3,2" fill="none"/>
                        <!-- Manga principal vista 100% de costado / perfil -->
                        <ellipse cx="201" cy="232" rx="46" ry="11" fill="#000" opacity="0.35"/>
                        <!-- Cuerpo de la manga cilíndrica -->
                        <path d="M 252,136 L 247,232 Q 201,244 155,232 L 152,136 C 160,82 180,58 202,58 C 224,58 244,82 252,136 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 252,136 L 247,232 Q 201,244 155,232 L 152,136 C 160,82 180,58 202,58 C 224,58 244,82 252,136 Z" 
                              fill="url(#tshLatShadeR)"/>
                        <!-- Sisa de unión de la manga al hombro -->
                        <path d="M 252,136 C 244,82 224,58 202,58 C 180,58 160,82 152,136 Q 202,148 252,136 Z" 
                              stroke="${seamColor}" stroke-width="1.8" fill="none"/>
                        <path d="M 248,132 C 240,84 222,62 202,62 C 182,62 164,84 156,132" 
                              stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="3,2" fill="none"/>
                        <!-- Dobladillo con costura pespunte doble de franela -->
                        <path d="M 247,232 Q 201,244 155,232" stroke="${seamColor}" stroke-width="2.4" fill="none"/>
                        <path d="M 246,224 Q 201,236 156,224" stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="3,2" fill="none"/>
                        <path d="M 245,221 Q 201,233 157,221" stroke="${stitchColor}" stroke-width="1.3" stroke-dasharray="3,2" fill="none"/>
                    </svg>`;
                }
            }

            // 2. CHEMISE (POLO CORPORATIVO)
            if (prenda === 'chemise') {
                if (angulo === 'frente') {
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <!-- Cuerpo Polo -->
                        <path d="M 148,58 L 75,104 L 40,165 L 88,190 L 108,155 L 112,365 L 288,365 L 292,155 L 312,190 L 360,165 L 325,104 L 252,58 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <!-- Tapeta frontal de 3 botones -->
                        <rect x="187" y="92" width="26" height="102" rx="2" fill="${color}" stroke="${seamColor}" stroke-width="1.5"/>
                        <line x1="187" y1="194" x2="213" y2="194" stroke="${seamColor}" stroke-width="1.5"/>
                        <!-- 3 Botones perlados -->
                        <circle cx="200" cy="112" r="3.8" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.8"/>
                        <circle cx="200" cy="142" r="3.8" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.8"/>
                        <circle cx="200" cy="172" r="3.8" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.8"/>
                        <!-- Cuello tipo Polo con alas dobladas -->
                        <polygon points="146,56 178,105 200,96 182,60" fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <polygon points="254,56 222,105 200,96 218,60" fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <path d="M 182,60 Q 200,66 218,60" stroke="${seamColor}" stroke-width="1.8" fill="none"/>
                        <!-- Puños acanalados en mangas -->
                        <polygon points="40,165 52,148 94,172 88,190" fill="${color}" stroke="${seamColor}" stroke-width="1.5"/>
                        <polygon points="360,165 348,148 306,172 312,190" fill="${color}" stroke="${seamColor}" stroke-width="1.5"/>
                        <!-- Aberturas laterales inferiores -->
                        <line x1="112" y1="350" x2="112" y2="365" stroke="${seamColor}" stroke-width="2.5"/>
                        <line x1="288" y1="350" x2="288" y2="365" stroke="${seamColor}" stroke-width="2.5"/>
                    </svg>`;
                } else if (angulo === 'espalda') {
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <path d="M 148,58 L 75,104 L 40,165 L 88,190 L 108,155 L 112,365 L 288,365 L 292,155 L 312,190 L 360,165 L 325,104 L 252,58 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <!-- Cuello polo posterior -->
                        <path d="M 148,58 Q 200,68 252,58 L 244,48 Q 200,56 156,48 Z" fill="${color}" stroke="${seamColor}" stroke-width="1.8"/>
                        <!-- Canesú posterior con media luna -->
                        <path d="M 175,64 Q 200,82 225,64" stroke="${stitchColor}" stroke-width="1.5" fill="none"/>
                        <line x1="108" y1="105" x2="292" y2="105" stroke="${stitchColor}" stroke-width="1.4" stroke-dasharray="3,2"/>
                    </svg>`;
                } else if (angulo === 'manga-izq') {
                    // Vista lateral izquierda Chemise (de costado)
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="poloLatShadeL" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.26"/>
                                <stop offset="28%" stop-color="#fff" stop-opacity="0.08"/>
                                <stop offset="72%" stop-color="#fff" stop-opacity="0.04"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.28"/>
                            </linearGradient>
                            <linearGradient id="poloTorsoShadeL" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.30"/>
                                <stop offset="42%" stop-color="#fff" stop-opacity="0.06"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.22"/>
                            </linearGradient>
                        </defs>
                        <!-- Torso en perfil lateral -->
                        <path d="M 152,52 C 138,76 128,125 126,190 L 130,285 L 134,365 L 266,365 L 268,285 C 274,210 278,145 274,115 C 270,90 258,78 244,72 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 152,52 C 138,76 128,125 126,190 L 130,285 L 134,365 L 266,365 L 268,285 C 274,210 278,145 274,115 C 270,90 258,78 244,72 Z" 
                              fill="url(#poloTorsoShadeL)"/>
                        <!-- Cuello Polo doblado visto de perfil con ala hacia el pecho -->
                        <path d="M 152,50 C 185,64 220,70 244,72" stroke="${seamColor}" stroke-width="3" fill="none"/>
                        <polygon points="244,72 265,102 248,96 236,70" fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <!-- Abertura lateral de respiración inferior con remate -->
                        <line x1="200" y1="345" x2="200" y2="365" stroke="${seamColor}" stroke-width="2.5"/>
                        <line x1="195" y1="345" x2="205" y2="345" stroke="${seamColor}" stroke-width="2"/>
                        <line x1="200" y1="148" x2="200" y2="345" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                        <!-- Manga Polo lateral -->
                        <ellipse cx="199" cy="232" rx="46" ry="11" fill="#000" opacity="0.35"/>
                        <!-- Cuerpo de la manga cilíndrica -->
                        <path d="M 148,136 L 153,232 Q 199,244 245,232 L 248,136 C 240,82 220,58 198,58 C 176,58 156,82 148,136 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 148,136 L 153,232 Q 199,244 245,232 L 248,136 C 240,82 220,58 198,58 C 176,58 156,82 148,136 Z" 
                              fill="url(#poloLatShadeL)"/>
                        <!-- Sisa de unión al hombro -->
                        <path d="M 148,136 C 156,82 176,58 198,58 C 220,58 240,82 248,136 Q 198,148 148,136 Z" 
                              stroke="${seamColor}" stroke-width="1.8" fill="none"/>
                        <!-- Puño tejido acanalado en rib de Polo -->
                        <path d="M 153,214 L 153,232 Q 199,244 245,232 L 245,214 Q 199,226 153,214 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <path d="M 153,214 Q 199,226 245,214" stroke="${stitchColor}" stroke-width="1.4" stroke-dasharray="3,2" fill="none"/>
                        <!-- Texturas de canalé en el puño -->
                        <line x1="172" y1="219" x2="172" y2="236" stroke="${seamDark}" stroke-width="1"/>
                        <line x1="186" y1="222" x2="186" y2="240" stroke="${seamDark}" stroke-width="1"/>
                        <line x1="200" y1="224" x2="200" y2="242" stroke="${seamDark}" stroke-width="1"/>
                        <line x1="214" y1="222" x2="214" y2="240" stroke="${seamDark}" stroke-width="1"/>
                        <line x1="228" y1="219" x2="228" y2="236" stroke="${seamDark}" stroke-width="1"/>
                    </svg>`;
                } else { // manga-der: Vista lateral derecha Chemise (de costado)
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="poloLatShadeR" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.28"/>
                                <stop offset="28%" stop-color="#fff" stop-opacity="0.04"/>
                                <stop offset="72%" stop-color="#fff" stop-opacity="0.08"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.26"/>
                            </linearGradient>
                            <linearGradient id="poloTorsoShadeR" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.22"/>
                                <stop offset="58%" stop-color="#fff" stop-opacity="0.06"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.30"/>
                            </linearGradient>
                        </defs>
                        <!-- Torso en perfil lateral -->
                        <path d="M 248,52 C 262,76 272,125 274,190 L 270,285 L 266,365 L 134,365 L 132,285 C 126,210 122,145 126,115 C 130,90 142,78 156,72 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 248,52 C 262,76 272,125 274,190 L 270,285 L 266,365 L 134,365 L 132,285 C 126,210 122,145 126,115 C 130,90 142,78 156,72 Z" 
                              fill="url(#poloTorsoShadeR)"/>
                        <!-- Cuello Polo doblado visto de perfil con ala hacia el pecho -->
                        <path d="M 248,50 C 215,64 180,70 156,72" stroke="${seamColor}" stroke-width="3" fill="none"/>
                        <polygon points="156,72 135,102 152,96 164,70" fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <!-- Abertura lateral de respiración inferior con remate -->
                        <line x1="200" y1="345" x2="200" y2="365" stroke="${seamColor}" stroke-width="2.5"/>
                        <line x1="195" y1="345" x2="205" y2="345" stroke="${seamColor}" stroke-width="2"/>
                        <line x1="200" y1="148" x2="200" y2="345" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                        <!-- Manga Polo lateral -->
                        <ellipse cx="201" cy="232" rx="46" ry="11" fill="#000" opacity="0.35"/>
                        <!-- Cuerpo de la manga cilíndrica -->
                        <path d="M 252,136 L 247,232 Q 201,244 155,232 L 152,136 C 160,82 180,58 202,58 C 224,58 244,82 252,136 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 252,136 L 247,232 Q 201,244 155,232 L 152,136 C 160,82 180,58 202,58 C 224,58 244,82 252,136 Z" 
                              fill="url(#poloLatShadeR)"/>
                        <!-- Sisa de unión al hombro -->
                        <path d="M 252,136 C 244,82 224,58 202,58 C 180,58 160,82 152,136 Q 202,148 252,136 Z" 
                              stroke="${seamColor}" stroke-width="1.8" fill="none"/>
                        <!-- Puño tejido acanalado en rib de Polo -->
                        <path d="M 247,214 L 247,232 Q 201,244 155,232 L 155,214 Q 201,226 247,214 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <path d="M 247,214 Q 201,226 155,214" stroke="${stitchColor}" stroke-width="1.4" stroke-dasharray="3,2" fill="none"/>
                        <!-- Texturas de canalé en el puño -->
                        <line x1="228" y1="219" x2="228" y2="236" stroke="${seamDark}" stroke-width="1"/>
                        <line x1="214" y1="222" x2="214" y2="240" stroke="${seamDark}" stroke-width="1"/>
                        <line x1="200" y1="224" x2="200" y2="242" stroke="${seamDark}" stroke-width="1"/>
                        <line x1="186" y1="222" x2="186" y2="240" stroke="${seamDark}" stroke-width="1"/>
                        <line x1="172" y1="219" x2="172" y2="236" stroke="${seamDark}" stroke-width="1"/>
                    </svg>`;
                }
            }

            // 3. CAMISA INDUSTRIAL / TRABAJO (DEFAULT)
            if (prenda === 'camisa') {
                if (angulo === 'frente') {
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <!-- Cuerpo Camisa -->
                        <path d="M 148,56 L 75,102 L 35,168 L 85,192 L 108,155 L 112,365 L 288,365 L 292,155 L 315,192 L 365,168 L 325,102 L 252,56 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <!-- Tapeta central con botones completa -->
                        <rect x="188" y="70" width="24" height="295" fill="${color}" stroke="${seamColor}" stroke-width="1.5"/>
                        <!-- Botones industriales a lo largo de la tapeta -->
                        <circle cx="200" cy="90" r="3.5" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.8"/>
                        <circle cx="200" cy="135" r="3.5" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.8"/>
                        <circle cx="200" cy="180" r="3.5" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.8"/>
                        <circle cx="200" cy="225" r="3.5" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.8"/>
                        <circle cx="200" cy="270" r="3.5" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.8"/>
                        <circle cx="200" cy="315" r="3.5" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.8"/>
                        <!-- Cuello camisero estructurado con puntas -->
                        <polygon points="146,55 178,98 200,92 186,60" fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <polygon points="254,55 222,98 200,92 214,60" fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <path d="M 186,60 Q 200,65 214,60" stroke="${seamColor}" stroke-width="1.8" fill="none"/>
                        <!-- Bolsillo Pecho Izquierdo con solapa y botón -->
                        <rect x="125" y="152" width="48" height="54" rx="2" fill="${color}" stroke="${seamColor}" stroke-width="1.4"/>
                        <polygon points="123,152 149,165 175,152" fill="${color}" stroke="${seamColor}" stroke-width="1.4"/>
                        <circle cx="149" cy="158" r="2.8" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.6"/>
                        <!-- Bolsillo Pecho Derecho con solapa y botón -->
                        <rect x="227" y="152" width="48" height="54" rx="2" fill="${color}" stroke="${seamColor}" stroke-width="1.4"/>
                        <polygon points="225,152 251,165 277,152" fill="${color}" stroke="${seamColor}" stroke-width="1.4"/>
                        <circle cx="251" cy="158" r="2.8" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.6"/>
                        <!-- Canesú de hombros reforzado -->
                        <line x1="75" y1="102" x2="108" y2="155" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                        <line x1="325" y1="102" x2="292" y2="155" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                    </svg>`;
                } else if (angulo === 'espalda') {
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <path d="M 148,56 L 75,102 L 35,168 L 85,192 L 108,155 L 112,365 L 288,365 L 292,155 L 315,192 L 365,168 L 325,102 L 252,56 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <!-- Cuello camisero posterior -->
                        <path d="M 148,56 Q 200,68 252,56 L 244,46 Q 200,56 156,46 Z" fill="${color}" stroke="${seamColor}" stroke-width="1.8"/>
                        <!-- Canesú posterior horizontal doble costura -->
                        <line x1="108" y1="112" x2="292" y2="112" stroke="${seamColor}" stroke-width="1.8"/>
                        <line x1="108" y1="116" x2="292" y2="116" stroke="${stitchColor}" stroke-width="1.2" stroke-dasharray="3,2"/>
                        <!-- Tablón / Fuelle central de espalda para movilidad -->
                        <line x1="200" y1="116" x2="200" y2="365" stroke="${seamColor}" stroke-width="1.5"/>
                    </svg>`;
                } else if (angulo === 'manga-izq') {
                    // Vista lateral izquierda Camisa Industrial (de costado)
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="shLatShadeL" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.26"/>
                                <stop offset="26%" stop-color="#fff" stop-opacity="0.08"/>
                                <stop offset="72%" stop-color="#fff" stop-opacity="0.04"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.28"/>
                            </linearGradient>
                            <linearGradient id="shTorsoShadeL" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.30"/>
                                <stop offset="42%" stop-color="#fff" stop-opacity="0.06"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.22"/>
                            </linearGradient>
                        </defs>
                        <!-- Torso Camisa en perfil lateral con ruedo curvado -->
                        <path d="M 150,48 C 138,72 128,125 126,190 L 130,285 L 134,360 Q 200,348 266,360 L 268,285 C 274,210 278,145 274,115 C 270,90 258,74 242,70 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 150,48 C 138,72 128,125 126,190 L 130,285 L 134,360 Q 200,348 266,360 L 268,285 C 274,210 278,145 274,115 C 270,90 258,74 242,70 Z" 
                              fill="url(#shTorsoShadeL)"/>
                        <!-- Cuello camisero estructurado de perfil con pie de cuello y punta -->
                        <path d="M 150,48 C 180,62 216,68 242,70" stroke="${seamColor}" stroke-width="3" fill="none"/>
                        <polygon points="242,70 270,96 252,92 238,68" fill="${color}" stroke="${seamColor}" stroke-width="1.8"/>
                        <circle cx="250" cy="85" r="2.2" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.5"/>
                        <!-- Perfil del bolsillo en pecho derecho -->
                        <polygon points="274,138 279,142 278,185 273,185" fill="${color}" stroke="${seamColor}" stroke-width="1.4"/>
                        <line x1="274" y1="148" x2="279" y2="150" stroke="${stitchColor}" stroke-width="1.5"/>
                        <!-- Costura reforzada de canesú en hombro -->
                        <line x1="168" y1="72" x2="228" y2="72" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                        <line x1="168" y1="75" x2="228" y2="75" stroke="${stitchColor}" stroke-width="1.2" stroke-dasharray="3,2"/>
                        <!-- Costura triple de unión lateral -->
                        <line x1="198" y1="148" x2="198" y2="354" stroke="${stitchColor}" stroke-width="1.2" stroke-dasharray="3,2"/>
                        <line x1="200" y1="148" x2="200" y2="354" stroke="${seamColor}" stroke-width="1.4"/>
                        <line x1="202" y1="148" x2="202" y2="354" stroke="${stitchColor}" stroke-width="1.2" stroke-dasharray="3,2"/>
                        <!-- Manga industrial lateral amplia -->
                        <ellipse cx="199" cy="232" rx="46" ry="11" fill="#000" opacity="0.35"/>
                        <path d="M 148,136 L 153,232 Q 199,244 245,232 L 248,136 C 240,82 220,58 198,58 C 176,58 156,82 148,136 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 148,136 L 153,232 Q 199,244 245,232 L 248,136 C 240,82 220,58 198,58 C 176,58 156,82 148,136 Z" 
                              fill="url(#shLatShadeL)"/>
                        <!-- Sisa reforzada -->
                        <path d="M 148,136 C 156,82 176,58 198,58 C 220,58 240,82 248,136 Q 198,148 148,136 Z" 
                              stroke="${seamColor}" stroke-width="1.8" fill="none"/>
                        <!-- Dobladillo industrial ancho de manga con pespunte doble -->
                        <path d="M 152,212 L 153,232 Q 199,244 245,232 L 246,212 Q 199,224 152,212 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <path d="M 152,212 Q 199,224 246,212" stroke="${stitchColor}" stroke-width="1.4" stroke-dasharray="3,2" fill="none"/>
                        <path d="M 153,232 Q 199,244 245,232" stroke="${seamColor}" stroke-width="2.2" fill="none"/>
                        <path d="M 154,225 Q 199,237 244,225" stroke="${stitchColor}" stroke-width="1.4" stroke-dasharray="3,2" fill="none"/>
                    </svg>`;
                } else { // manga-der: Vista lateral derecha Camisa Industrial (de costado)
                    return `
                    <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <linearGradient id="shLatShadeR" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.28"/>
                                <stop offset="28%" stop-color="#fff" stop-opacity="0.04"/>
                                <stop offset="74%" stop-color="#fff" stop-opacity="0.08"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.26"/>
                            </linearGradient>
                            <linearGradient id="shTorsoShadeR" x1="0" y1="0" x2="1" y2="0">
                                <stop offset="0%" stop-color="#000" stop-opacity="0.22"/>
                                <stop offset="58%" stop-color="#fff" stop-opacity="0.06"/>
                                <stop offset="100%" stop-color="#000" stop-opacity="0.30"/>
                            </linearGradient>
                        </defs>
                        <!-- Torso Camisa en perfil lateral con ruedo curvado -->
                        <path d="M 250,48 C 262,72 272,125 274,190 L 270,285 L 266,360 Q 200,348 134,360 L 132,285 C 126,210 122,145 126,115 C 130,90 142,74 158,70 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 250,48 C 262,72 272,125 274,190 L 270,285 L 266,360 Q 200,348 134,360 L 132,285 C 126,210 122,145 126,115 C 130,90 142,74 158,70 Z" 
                              fill="url(#shTorsoShadeR)"/>
                        <!-- Cuello camisero estructurado de perfil con pie de cuello y punta -->
                        <path d="M 250,48 C 220,62 184,68 158,70" stroke="${seamColor}" stroke-width="3" fill="none"/>
                        <polygon points="158,70 130,96 148,92 162,68" fill="${color}" stroke="${seamColor}" stroke-width="1.8"/>
                        <circle cx="150" cy="85" r="2.2" fill="${buttonFill}" stroke="${buttonBorder}" stroke-width="0.5"/>
                        <!-- Perfil del bolsillo en pecho izquierdo -->
                        <polygon points="126,138 121,142 122,185 127,185" fill="${color}" stroke="${seamColor}" stroke-width="1.4"/>
                        <line x1="126" y1="148" x2="121" y2="150" stroke="${stitchColor}" stroke-width="1.5"/>
                        <!-- Costura reforzada de canesú en hombro -->
                        <line x1="232" y1="72" x2="172" y2="72" stroke="${stitchColor}" stroke-width="1.5" stroke-dasharray="3,2"/>
                        <line x1="232" y1="75" x2="172" y2="75" stroke="${stitchColor}" stroke-width="1.2" stroke-dasharray="3,2"/>
                        <!-- Costura triple de unión lateral -->
                        <line x1="202" y1="148" x2="202" y2="354" stroke="${stitchColor}" stroke-width="1.2" stroke-dasharray="3,2"/>
                        <line x1="200" y1="148" x2="200" y2="354" stroke="${seamColor}" stroke-width="1.4"/>
                        <line x1="198" y1="148" x2="198" y2="354" stroke="${stitchColor}" stroke-width="1.2" stroke-dasharray="3,2"/>
                        <!-- Manga industrial lateral amplia -->
                        <ellipse cx="201" cy="232" rx="46" ry="11" fill="#000" opacity="0.35"/>
                        <path d="M 252,136 L 247,232 Q 201,244 155,232 L 152,136 C 160,82 180,58 202,58 C 224,58 244,82 252,136 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.8" stroke-linejoin="round"/>
                        <path d="M 252,136 L 247,232 Q 201,244 155,232 L 152,136 C 160,82 180,58 202,58 C 224,58 244,82 252,136 Z" 
                              fill="url(#shLatShadeR)"/>
                        <!-- Sisa reforzada -->
                        <path d="M 252,136 C 244,82 224,58 202,58 C 180,58 160,82 152,136 Q 202,148 252,136 Z" 
                              stroke="${seamColor}" stroke-width="1.8" fill="none"/>
                        <!-- Dobladillo industrial ancho de manga con pespunte doble -->
                        <path d="M 248,212 L 247,232 Q 201,244 155,232 L 154,212 Q 201,224 248,212 Z" 
                              fill="${color}" stroke="${seamColor}" stroke-width="1.6"/>
                        <path d="M 248,212 Q 201,224 154,212" stroke="${stitchColor}" stroke-width="1.4" stroke-dasharray="3,2" fill="none"/>
                        <path d="M 247,232 Q 201,244 155,232" stroke="${seamColor}" stroke-width="2.2" fill="none"/>
                        <path d="M 246,225 Q 201,237 156,225" stroke="${stitchColor}" stroke-width="1.4" stroke-dasharray="3,2" fill="none"/>
                    </svg>`;
                }
            }

            // Fallback genérico (Chaleco, Pantalón, Casco)
            return `
            <svg viewBox="0 0 400 420" xmlns="http://www.w3.org/2000/svg">
                <path d="M 140,55 L 85,95 L 60,165 L 105,185 L 115,365 L 285,365 L 295,185 L 340,165 L 315,95 L 260,55 Z" 
                      fill="${color}" stroke="${seamColor}" stroke-width="2"/>
                <text x="200" y="210" text-anchor="middle" fill="${isDark ? '#fff' : '#222'}" font-family="Poppins" font-size="14" font-weight="700">
                    ${prenda.toUpperCase()} (${angulo.toUpperCase()})
                </text>
            </svg>`;
        }

        // Renderizado interactivo del Estudio de Diseño (Boceto + Logos Colocados)
        function renderDisenoStudio() {
            // 1. Renderizar Mockup SVG vectorial
            const svgWrap = document.getElementById('mockupSvgWrap');
            if (svgWrap) {
                svgWrap.innerHTML = getGarmentSvg(disenoState.prendaKey, disenoState.angulo, disenoState.color);
            }

            // 2. Renderizar logos colocados sobre la prenda
            renderPlacedLogos();

            // 3. Actualizar resumen de precios y prendas
            const pNombre = document.getElementById('prevPrendaNombre');
            const pPrecio = document.getElementById('prevPrendaPrecio');
            const tNombre = document.getElementById('prevTecnicaNombre');
            const tPrecio = document.getElementById('prevTecnicaPrecio');
            const total = document.getElementById('disenoPrecioTotal');

            if (pNombre) pNombre.textContent = disenoState.prendaNombre + ':';
            if (pPrecio) pPrecio.textContent = '$' + disenoState.prendaPrecio.toFixed(2);
            if (tNombre) tNombre.textContent = 'Técnica (' + disenoState.tecnica + '):';
            if (tPrecio) tPrecio.textContent = '+$' + disenoState.tecnicaPrecio.toFixed(2);

            const unitTotal = disenoState.prendaPrecio + disenoState.tecnicaPrecio;
            if (total) total.textContent = '$' + unitTotal.toFixed(2);
        }

        // Renderizado y vinculación de arrastre libre de logos
        function renderPlacedLogos() {
            const dragLayer = document.getElementById('disenoDragLayer');
            if (!dragLayer) return;

            const list = disenoLogos[disenoState.angulo] || [];
            dragLayer.innerHTML = '';

            list.forEach(logo => {
                const el = document.createElement('div');
                const isActive = (logo.id === activeLogoId);
                el.className = 'placed-logo-item' + (isActive ? ' active' : '');
                el.id = 'dom_' + logo.id;
                el.style.left = logo.x + 'px';
                el.style.top = logo.y + 'px';

                // Contenedor gráfico del logo que recibe la escala
                const graphicWrap = document.createElement('div');
                graphicWrap.className = 'logo-graphic-wrap';
                graphicWrap.id = 'graphic_' + logo.id;
                graphicWrap.style.transform = `scale(${logo.scale || 1.0})`;
                graphicWrap.style.transformOrigin = 'center center';

                if (logo.type === 'image') {
                    const img = document.createElement('img');
                    img.src = logo.src;
                    img.alt = 'Logo colocado';
                    img.style.width = (logo.width || 88) + 'px';
                    img.style.height = (logo.height || 88) + 'px';
                    img.style.objectFit = 'contain';
                    graphicWrap.appendChild(img);
                } else {
                    const badge = document.createElement('div');
                    badge.className = 'text-badge';
                    badge.textContent = logo.text || disenoState.logoTexto || 'TU LOGO';
                    graphicWrap.appendChild(badge);
                }
                el.appendChild(graphicWrap);

                // Barra flotante interactiva con círculo deslizante para cambiar de tamaño libremente
                const bar = document.createElement('div');
                bar.className = 'logo-resize-bar-wrap' + (logo.y < 55 ? ' placed-bottom' : '');
                bar.id = 'bar_' + logo.id;

                const curPct = Math.round((logo.scale || 1.0) * 100);
                bar.innerHTML = `
                    <div class="logo-resize-header">
                        <span>📏</span>
                        <span class="logo-resize-pct" id="pct_${logo.id}">${curPct}%</span>
                    </div>
                    <div class="logo-slider-track-wrap">
                        <span class="slider-hint" id="hintMinus_${logo.id}" title="Hacer más pequeño">−</span>
                        <input type="range" class="logo-range-slider" id="slider_${logo.id}" 
                               min="0.35" max="2.5" step="0.05" value="${logo.scale || 1.0}" 
                               title="Desplaza el círculo a la derecha para agrandar o a la izquierda para achicar">
                        <span class="slider-hint" id="hintPlus_${logo.id}" title="Hacer más grande">+</span>
                    </div>
                    <div class="logo-quick-actions">
                        <button type="button" class="btn-logo-action" id="btnDup_${logo.id}" title="Duplicar este logo">➕</button>
                        <button type="button" class="btn-logo-action btn-del" id="btnDel_${logo.id}" title="Eliminar este logo">🗑️</button>
                        <button type="button" class="btn-logo-action" id="btnClose_${logo.id}" title="Listo / Cerrar">✓</button>
                    </div>
                `;

                // Conectar eventos del slider circular
                const slider = bar.querySelector(`#slider_${logo.id}`);
                const pctSpan = bar.querySelector(`#pct_${logo.id}`);

                function updateScaleVal(newVal) {
                    newVal = Math.max(0.35, Math.min(2.5, newVal));
                    logo.scale = newVal;
                    if (slider) slider.value = newVal;
                    if (graphicWrap) graphicWrap.style.transform = `scale(${newVal})`;
                    if (pctSpan) pctSpan.textContent = Math.round(newVal * 100) + '%';
                }

                if (slider) {
                    slider.addEventListener('input', (e) => {
                        e.stopPropagation();
                        updateScaleVal(parseFloat(slider.value));
                    });
                    ['pointerdown', 'mousedown', 'touchstart', 'click'].forEach(evt => {
                        slider.addEventListener(evt, (e) => e.stopPropagation());
                    });
                }

                const hintMinus = bar.querySelector(`#hintMinus_${logo.id}`);
                if (hintMinus) {
                    hintMinus.addEventListener('click', (e) => {
                        e.stopPropagation();
                        updateScaleVal((logo.scale || 1.0) - 0.1);
                    });
                }

                const hintPlus = bar.querySelector(`#hintPlus_${logo.id}`);
                if (hintPlus) {
                    hintPlus.addEventListener('click', (e) => {
                        e.stopPropagation();
                        updateScaleVal((logo.scale || 1.0) + 0.1);
                    });
                }

                const btnDup = bar.querySelector(`#btnDup_${logo.id}`);
                if (btnDup) {
                    btnDup.addEventListener('click', (e) => {
                        e.stopPropagation();
                        duplicarLogo();
                    });
                }

                const btnDel = bar.querySelector(`#btnDel_${logo.id}`);
                if (btnDel) {
                    btnDel.addEventListener('click', (e) => {
                        e.stopPropagation();
                        eliminarLogoActivo();
                    });
                }

                const btnClose = bar.querySelector(`#btnClose_${logo.id}`);
                if (btnClose) {
                    btnClose.addEventListener('click', (e) => {
                        e.stopPropagation();
                        activeLogoId = null;
                        document.querySelectorAll('.placed-logo-item').forEach(it => it.classList.remove('active'));
                    });
                }

                ['pointerdown', 'mousedown', 'touchstart', 'click'].forEach(evt => {
                    bar.addEventListener(evt, (e) => e.stopPropagation());
                });

                el.appendChild(bar);

                // Asignar controlador de arrastre libre
                bindLogoDragging(el, logo);
                dragLayer.appendChild(el);
            });

            // Actualizar contador total de logos en la UI
            const totalBadge = document.getElementById('prevTotalLogosCount');
            if (totalBadge) {
                const curCount = list.length;
                let totAll = 0;
                Object.keys(disenoLogos).forEach(k => totAll += disenoLogos[k].length);
                const anguloNames = { 'frente': 'Frente', 'espalda': 'Espalda', 'manga-izq': 'Manga Izq.', 'manga-der': 'Manga Der.' };
                totalBadge.textContent = `${curCount} en ${anguloNames[disenoState.angulo]} (${totAll} en total)`;
            }
        }

        // Movimiento de arrastre libre (Pointer Events) con soporte para mouse y pantallas táctiles
        function bindLogoDragging(element, logoData) {
            let startX = 0, startY = 0, initialX = 0, initialY = 0;
            let isDragging = false;

            element.addEventListener('pointerdown', (e) => {
                // Si hizo click en la barra de control o sus botones, ignorar arrastre del logo
                if (e.target.closest('.logo-resize-bar-wrap')) return;

                isDragging = true;
                activeLogoId = logoData.id;

                // Actualizar estado activo visual SIN reconstruir el DOM para que el puntero no pierda captura
                document.querySelectorAll('.placed-logo-item').forEach(it => {
                    if (it === element) {
                        it.classList.add('active');
                    } else {
                        it.classList.remove('active');
                    }
                });

                startX = e.clientX;
                startY = e.clientY;
                initialX = logoData.x;
                initialY = logoData.y;

                try {
                    element.setPointerCapture(e.pointerId);
                } catch (err) {}

                e.stopPropagation();
            });

            element.addEventListener('pointermove', (e) => {
                if (!isDragging) return;

                const dx = e.clientX - startX;
                const dy = e.clientY - startY;

                const stage = document.getElementById('previewStage');
                const stageRect = stage ? stage.getBoundingClientRect() : { width: 380, height: 420 };

                let newX = initialX + dx;
                let newY = initialY + dy;

                // Libertad total de movimiento sobre toda la silueta de la prenda
                newX = Math.max(-25, Math.min(stageRect.width - 50, newX));
                newY = Math.max(-25, Math.min(stageRect.height - 50, newY));

                logoData.x = newX;
                logoData.y = newY;
                element.style.left = newX + 'px';
                element.style.top = newY + 'px';

                // Ajustar posición de la barra si se acerca al tope superior
                const bar = element.querySelector('.logo-resize-bar-wrap');
                if (bar) {
                    if (newY < 55) {
                        bar.classList.add('placed-bottom');
                    } else {
                        bar.classList.remove('placed-bottom');
                    }
                }
            });

            const stopDrag = (e) => {
                if (isDragging) {
                    isDragging = false;
                    try {
                        element.releasePointerCapture(e.pointerId);
                    } catch (err) {}
                }
            };

            element.addEventListener('pointerup', stopDrag);
            element.addEventListener('pointercancel', stopDrag);
        }

        // Deseleccionar al hacer click fuera en el escenario
        window.addEventListener('DOMContentLoaded', () => {
            const previewStageEl = document.getElementById('previewStage');
            if (previewStageEl) {
                previewStageEl.addEventListener('pointerdown', (e) => {
                    if (!e.target.closest('.placed-logo-item')) {
                        activeLogoId = null;
                        document.querySelectorAll('.placed-logo-item').forEach(it => it.classList.remove('active'));
                    }
                });
            }
        });

        function solicitarMuestraDiseno() {
            const unitTotal = disenoState.prendaPrecio + disenoState.tecnicaPrecio;
            let logosResumen = [];
            const angulosLabels = { 'frente': 'Frente', 'espalda': 'Espalda', 'manga-izq': 'Manga Izquierda', 'manga-der': 'Manga Derecha' };

            Object.keys(disenoLogos).forEach(ang => {
                const cant = disenoLogos[ang].length;
                if (cant > 0) {
                    logosResumen.push(`${angulosLabels[ang]}: ${cant} logo(s)`);
                }
            });

            const logosStr = logosResumen.length ? logosResumen.join(', ') : '1 en Frente';

            const detalle = `Solicitud de diseño personalizado:\n- Prenda: ${disenoState.prendaNombre}\n- Color tela: ${disenoState.colorNombre}\n- Técnica: ${disenoState.tecnica}\n- Distribución de logos: ${logosStr}\n- Costo estimado/ud: $${unitTotal.toFixed(2)}`;
            const textarea = document.querySelector('#view-cotiza textarea');
            if (textarea) textarea.value = detalle;
            navigateToTab('cotiza');
            mostrarToast('✅ ¡Diseño transferido al formulario de cotización!');
        }

        const renderDisenoPreview = renderDisenoStudio;

        /* ---------- ORDEN DE COMPRA B2B ---------- */
        let ocItems = [
            { nombre: '⛑️ Casco de Seguridad Dieléctrico', cant: 25, precio: 18.5 },
            { nombre: '🦺 Chaleco Reflectivo Alta Visibilidad', cant: 30, precio: 12.4 },
            { nombre: '👕 Camisa Industrial con Bordado', cant: 40, precio: 25.5 },
            { nombre: '🥾 Botas de Seguridad Dieléctricas', cant: 20, precio: 34.9 }
        ];

        function renderOCTable() {
            const tbody = document.getElementById('ocItemsBody');
            if (!tbody) return;
            if (!ocItems.length) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center;color:var(--gcl);padding:1.5rem">No hay productos en la orden. Importa tu kit o añade ítems.</td></tr>`;
                calcularTotalesOC();
                return;
            }
            tbody.innerHTML = ocItems.map((item, idx) => `
                <tr>
                    <td><b>${item.nombre}</b></td>
                    <td style="text-align:center">
                        <button style="border:none;background:#eee;cursor:pointer;padding:2px 7px;border-radius:4px;font-weight:700" onclick="cambiarCantOC(${idx}, -1)">-</button>
                        <span style="display:inline-block;min-width:24px;text-align:center;font-weight:700">${item.cant}</span>
                        <button style="border:none;background:#eee;cursor:pointer;padding:2px 7px;border-radius:4px;font-weight:700" onclick="cambiarCantOC(${idx}, 1)">+</button>
                    </td>
                    <td style="text-align:right">$${item.precio.toFixed(2)}</td>
                    <td style="text-align:right;font-weight:700;color:var(--nar)">$${(item.precio * item.cant).toFixed(2)}</td>
                    <td style="text-align:center">
                        <button style="background:none;border:none;color:#f55;cursor:pointer;font-size:1.1rem" onclick="eliminarItemOC(${idx})" title="Eliminar">✕</button>
                    </td>
                </tr>
            `).join('');
            calcularTotalesOC();
        }

        function cambiarCantOC(idx, delta) {
            if (!ocItems[idx]) return;
            ocItems[idx].cant += delta;
            if (ocItems[idx].cant <= 0) ocItems.splice(idx, 1);
            renderOCTable();
        }

        function eliminarItemOC(idx) {
            ocItems.splice(idx, 1);
            renderOCTable();
        }

        function agregarItemManualOC() {
            const prod = prompt('Nombre del producto o dotación:', 'Guantes Anticorte Industriales');
            if (!prod) return;
            const cantStr = prompt('Cantidad requerida:', '15');
            const cant = parseInt(cantStr) || 10;
            const precioStr = prompt('Precio unitario estimado ($):', '9.80');
            const precio = parseFloat(precioStr) || 10.0;
            ocItems.push({ nombre: '📦 ' + prod, cant: cant, precio: precio });
            renderOCTable();
        }

        function calcularTotalesOC() {
            let subtotal = 0;
            ocItems.forEach(i => subtotal += (i.precio * i.cant));
            const cond = document.getElementById('ocCondicionPago') ? document.getElementById('ocCondicionPago').value : 'credito15';
            let descPorcentaje = (cond === 'contado') ? 0.05 : 0;
            let descuento = subtotal * descPorcentaje;
            let base = subtotal - descuento;
            let iva = base * 0.16;
            let total = base + iva;

            const subTxt = document.getElementById('ocSubtotalTxt');
            const descTxt = document.getElementById('ocDescuentoTxt');
            const ivaTxt = document.getElementById('ocIvaTxt');
            const totTxt = document.getElementById('ocTotalTxt');

            if (subTxt) subTxt.textContent = '$' + subtotal.toFixed(2);
            if (descTxt) descTxt.textContent = '-$' + descuento.toFixed(2) + (descPorcentaje > 0 ? ' (5%)' : '');
            if (ivaTxt) ivaTxt.textContent = '$' + iva.toFixed(2);
            if (totTxt) totTxt.textContent = '$' + total.toFixed(2);
        }

        function importarKitAOrden() {
            const ids = Object.keys(cart);
            if (!ids.length) {
                alert('Tu kit del configurador está vacío. Añade productos en el catálogo o usa los ítems precargados.');
                return;
            }
            ocItems = [];
            ids.forEach(id => {
                const p = PRODUCTS.find(x => x.id == id);
                if (p) {
                    ocItems.push({
                        nombre: `${p.ico} ${p.name}`,
                        cant: (cart[id] || 1) * 10,
                        precio: p.price
                    });
                }
            });
            renderOCTable();
            alert('✅ Se importaron ' + ids.length + ' líneas de tu kit al pedido corporativo (lotes de dotación calculados).');
        }

        function pasarKitAOrdenCompra() {
            const ids = Object.keys(cart);
            if (ids.length) {
                importarKitAOrden();
            }
            navigateToTab('orden-compra');
        }

        function procesarOrdenCompraOficial() {
            if (!ocItems.length) {
                alert('Por favor añade al menos un producto a la Orden de Compra.');
                return;
            }
            const empresa = document.getElementById('ocEmpresa').value || 'Empresa';
            const email = document.getElementById('ocEmail').value || 'compras@empresa.com';
            const num = document.getElementById('ocNumeroDisplay') ? document.getElementById('ocNumeroDisplay').textContent.trim() : 'UF-2026';
            const tot = document.getElementById('ocTotalTxt') ? document.getElementById('ocTotalTxt').textContent : '$0.00';

            alert(`🎉 ¡Orden de Compra procesada con éxito!\n\n${num}\nEmpresa: ${empresa}\nTotal: ${tot}\n\nHemos enviado la confirmación y factura proforma a ${email}. Un ejecutivo de cuentas corporativas se comunicará en breve.`);
        }

        function descargarResumenOC() {
            window.print();
        }

        
        /* ---------- INTEGRACIÓN CARRITO Y GENERACIÓN DE COTIZACIÓN EN PDF ---------- */
        function actualizarBannerCotizacionCarrito() {
            const activeBox = document.getElementById('cotizaCartActiveBox');
            const emptyBox = document.getElementById('cotizaCartEmptyBox');
            const countBadge = document.getElementById('cotizaCartCountBadge');
            const totalVal = document.getElementById('cotizaCartTotalVal');
            const chipsList = document.getElementById('cotizaCartChipsList');

            if (!activeBox || !emptyBox) return;

            const ids = Object.keys(cart);
            let totalItems = 0;
            let subtotal = 0;

            ids.forEach(id => {
                const q = cart[id] || 0;
                totalItems += q;
                const p = PRODUCTS.find(x => x.id == id);
                if (p) subtotal += p.price * q;
            });

            const iva = subtotal * 0.16;
            const total = subtotal + iva;

            if (ids.length > 0 && totalItems > 0) {
                activeBox.style.display = 'block';
                emptyBox.style.display = 'none';

                if (countBadge) {
                    countBadge.textContent = '(' + totalItems + ' ' + (totalItems === 1 ? 'prenda' : 'prendas') + ')';
                }
                if (totalVal) {
                    totalVal.textContent = '$' + total.toFixed(2);
                }

                if (chipsList) {
                    chipsList.innerHTML = ids.map(id => {
                        const p = PRODUCTS.find(x => x.id == id);
                        if (!p) return '';
                        const q = cart[id];
                        const itemSub = p.price * q;
                        return '<div style="display:inline-flex;align-items:center;gap:.4rem;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);padding:.3rem .7rem;border-radius:20px;font-size:.76rem;color:#ffffff;white-space:nowrap">' +
                            '<span>' + p.ico + ' ' + p.name + '</span>' +
                            '<b style="color:var(--ama)">×' + q + '</b>' +
                            '<span style="color:var(--gcl);font-size:.72rem">($' + itemSub.toFixed(2) + ')</span>' +
                        '</div>';
                    }).join('');
                }
            } else {
                activeBox.style.display = 'none';
                emptyBox.style.display = 'flex';
            }
        }

        function transferirCarritoAOrdenDesdeCotiza() {
            const ids = Object.keys(cart);
            if (!ids.length) {
                alert('Tu carrito está vacío. Agrega prendas desde el catálogo para continuar.');
                return;
            }
            ocItems = [];
            ids.forEach(id => {
                const p = PRODUCTS.find(x => x.id == id);
                if (p) {
                    const q = cart[id] || 1;
                    const sizeTxt = cartSizes[id] ? ` (Talla: ${cartSizes[id]})` : '';
                    ocItems.push({
                        nombre: p.ico + ' ' + p.name + sizeTxt,
                        cant: q,
                        precio: getProductPrice(p, q)
                    });
                }
            });
            renderOCTable();
            navigateToTab('orden-compra');
            mostrarToast('✅ ¡Material del carrito transferido a tu Orden de Compra B2B!');
        }

        function generarPDFCotizacionCarrito() {
            const ids = Object.keys(cart);
            if (!ids.length) {
                alert('⚠️ Tu carrito está vacío. Por favor selecciona prendas en nuestro catálogo para generar tu cotización formal con membrete en PDF.');
                navigateToTab('diseno');
                return;
            }

            // Datos del formulario de cotización (si fueron ingresados)
            const nombreInput = document.getElementById('cotizaNombre');
            const telInput = document.getElementById('cotizaTelefono');
            const emailInput = document.getElementById('cotizaEmail');
            const comentariosInput = document.getElementById('cotizaComentarios');

            const nombreVal = (nombreInput ? nombreInput.value.trim() : '') || (window.ultimaCotizacionData?.nombre) || 'Cliente Corporativo / Solicitante';
            const telVal = (telInput ? telInput.value.trim() : '') || (window.ultimaCotizacionData?.telefono) || 'A coordinar';
            const emailVal = (emailInput ? emailInput.value.trim() : '') || (window.ultimaCotizacionData?.email) || 'Por confirmar';
            const comentariosVal = (comentariosInput ? comentariosInput.value.trim() : '') || (window.ultimaCotizacionData?.comentarios) || 'Dotación industrial estándar según catálogo Unifortex.';

            // Cálculos de productos
            let subtotal = 0;
            let totalPrendas = 0;
            const itemsDetalle = [];

            ids.forEach((id, index) => {
                const p = PRODUCTS.find(x => x.id == id);
                if (p) {
                    const cant = cart[id] || 1;
                    totalPrendas += cant;
                    const unitPrice = getProductPrice(p, cant);
                    const itemSub = unitPrice * cant;
                    subtotal += itemSub;
                    const esMayor = cant >= 12;
                    itemsDetalle.push({
                        idx: index + 1,
                        ico: p.ico,
                        name: p.name + (cartSizes[id] ? ' [Talla: ' + cartSizes[id] + ']' : '') + (esMayor ? ' [Tarifa Mayorista]' : ''),
                        cat: p.cat || 'Seguridad Industrial',
                        norma: p.norma || p.material || 'COVENIN / OSHA Industrial',
                        cant: cant,
                        precio: unitPrice,
                        subtotal: itemSub
                    });
                }
            });

            const iva = subtotal * 0.16;
            const total = subtotal + iva;
            const cotNum = 'COT-2026-' + Math.floor(1000 + Math.random() * 9000);
            const fechaHoy = new Date().toLocaleDateString('es-VE', { year: 'numeric', month: 'long', day: 'numeric' });

            // Filas de productos
            const rowsHtml = itemsDetalle.map(item => {
                return '<tr>' +
                    '<td style="text-align:center;font-weight:700;color:#6b7280">' + item.idx + '</td>' +
                    '<td><b style="color:#111827">' + item.ico + ' ' + item.name + '</b></td>' +
                    '<td><span style="color:#4b5563;font-size:11px">' + item.cat + ' | ' + item.norma + '</span></td>' +
                    '<td style="text-align:center;font-weight:800;color:#111827">' + item.cant + '</td>' +
                    '<td style="text-align:right;color:#374151">$' + item.precio.toFixed(2) + '</td>' +
                    '<td style="text-align:right;font-weight:800;color:#111827">$' + item.subtotal.toFixed(2) + '</td>' +
                '</tr>';
            }).join('');

            // Construir HTML de la página imprimible
            const printableHtml = '<!DOCTYPE html>' +
