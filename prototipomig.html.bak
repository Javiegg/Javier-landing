    </button>
    <div id="chatBox" role="dialog" aria-modal="false" aria-label="Asistente Virtual UNIFORTEX">
        <div class="chat-head">
            <img src="imagenes pasantias/escudo.png" alt="Escudo UNIFORTEX" class="chat-head-escudo">
            <div class="chat-head-info">
                <b>Asesor UNIFORTEX</b>
                <small>En línea</small>
            </div>
            <div class="chat-head-actions">
                <button type="button" class="chat-head-btn" onclick="restartChat()" aria-label="Reiniciar conversación" title="Reiniciar conversación">🔄</button>
                <button type="button" class="chat-head-btn btn-close" onclick="toggleChat()" aria-label="Cerrar y minimizar chat" title="Cerrar (mantiene tu conversación)">✕</button>
            </div>
        </div>
        <div id="chatLog" aria-live="polite"></div>
        <div class="opts" id="chatOpts"></div>
        <form id="chatForm" onsubmit="event.preventDefault();sendMsg()">
            <input id="chatInput" placeholder="Escribe tu mensaje…" autocomplete="off" aria-label="Mensaje para el asesor">
            <button type="submit" aria-label="Enviar mensaje">➤</button>
        </form>
    </div>

    <!-- Modal Ficha Técnica / Detalle de Producto -->
    <div class="modal" id="productDetailModal">
        <div class="prod-modal-box">
            <button class="close" onclick="cerrarDetalleProducto()">✕</button>
            <div id="productDetailContent">
                <!-- Inyectado dinámicamente por abrirDetalleProducto() -->
            </div>
        </div>
    </div>

    <!-- Modal Panel Cliente -->
    <div class="modal" id="panelModal">
        <div class="modal-box">
            <button class="close" onclick="closeModal('panelModal')">✕</button>
            <h3>Panel de Cliente</h3>
            <div id="loginView">
                <p style="color:var(--gri);margin-bottom:1rem">Accede para ver tus pedidos, kits guardados y alertas de
                    reposición.</p>
                <input id="cliEmail" placeholder="Correo corporativo" value="compras@empresa.com">
                <button class="btn btn-w" style="width:100%;justify-content:center" onclick="loginClient()">Ingresar al
                    panel</button>
            </div>
            <div id="dashView" style="display:none">
                <p style="margin-bottom:1rem"><b id="cliName">compras@empresa.com</b> · Plan Empresarial</p>
                <h4
                    style="font-style:italic;text-transform:uppercase;font-size:.8rem;color:var(--nar);margin:1rem 0 .5rem">
                    Pedidos recientes</h4>
                <div class="dash-row"><span>#UF-1042 · Kit Construcción x25</span><span style="color:#0a0">En
                        tránsito</span></div>
                <div class="dash-row"><span>#UF-1038 · Uniformes x60</span><span style="color:#0a0">Entregado</span>
                </div>
                <div class="dash-row"><span>#UF-1031 · Bioseguridad x120</span><span style="color:#0a0">Entregado</span>
                </div>
                <h4
                    style="font-style:italic;text-transform:uppercase;font-size:.8rem;color:var(--nar);margin:1.5rem 0 .5rem">
                    Alertas de reposición</h4>
                <div class="dash-row"><span>⛑️ Cascos · stock bajo</span><span style="color:var(--nar)">Reordenar</span>
                </div>
                <div class="dash-row"><span>🧤 Guantes · vencen en 15 días</span><span
                        style="color:var(--nar)">Reordenar</span></div>
                <button class="btn btn-d" style="width:100%;justify-content:center;margin-top:1.5rem"
                    onclick="closeModal('panelModal')">Cerrar sesión</button>
            </div>
        </div>
    </div>

