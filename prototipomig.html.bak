                    </div>

                    <!-- FORMULARIO DE COTIZACIÓN RÁPIDA (ENFOQUE PERSONAL) -->
                    <div class="contact-form-box">
                        <h3 style="margin-bottom:.5rem;font-size:1.4rem;color:#ffffff !important">Cotiza en <span style="color:var(--ama)">60 segundos</span></h3>
                        <p style="margin:0 0 1.5rem;color:var(--gcl);font-size:.92rem">
                            Déjanos tus datos de contacto y te enviaremos una propuesta personalizada a tu medida con atención directa e inmediata.
                        </p>

                        
                        <!-- BANNER DINÁMICO DE DETECCIÓN DE CARRITO PARA COTIZACIÓN Y ORDEN DE COMPRA -->
                        <div id="cotizaCartBannerContainer" style="margin-bottom:1.4rem">
                            <!-- Estado A: Cuando el cliente TIENE productos en el carrito -->
                            <div id="cotizaCartActiveBox" style="display:none;background:linear-gradient(135deg, rgba(253,196,23,0.12) 0%, rgba(226,30,44,0.08) 100%);border:1px solid rgba(253,196,23,0.4);border-radius:14px;padding:1.1rem 1.25rem;box-shadow:0 6px 24px rgba(0,0,0,0.22);text-align:left">
                                <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:1rem;margin-bottom:.85rem">
                                    <div style="flex:1;min-width:240px">
                                        <div style="display:inline-flex;align-items:center;gap:.35rem;background:var(--ama);color:#111;font-size:.7rem;font-weight:800;padding:.25rem .6rem;border-radius:6px;text-transform:uppercase;letter-spacing:.04em;margin-bottom:.45rem">
                                            🛒 Material en Carrito Detectado
                                        </div>
                                        <h4 style="margin:0 0 .25rem;font-size:1.08rem;color:#ffffff;display:flex;align-items:center;gap:.5rem">
                                            Prendas listas para cotizar <span id="cotizaCartCountBadge" style="color:var(--ama);font-weight:700">(0 prendas)</span>
                                        </h4>
                                        <p style="margin:0;font-size:.82rem;color:var(--gcl);line-height:1.4">
                                            Detectamos tus prendas seleccionadas. Puedes descargar directamente tu <b>Cotización Oficial en PDF</b> con membrete y precios o transferirlas a tu <b>Orden de Compra</b>.
                                        </p>
                                    </div>

                                    <div style="background:rgba(0,0,0,0.35);border:1px solid rgba(255,255,255,0.12);padding:.6rem .95rem;border-radius:10px;text-align:right;min-width:145px">
                                        <div style="font-size:.68rem;color:var(--gcl);text-transform:uppercase;letter-spacing:.04em">Total Cotización</div>
                                        <div id="cotizaCartTotalVal" style="font-size:1.35rem;font-weight:800;color:var(--ama);line-height:1.15;margin:.15rem 0">$0.00</div>
                                        <div style="font-size:.68rem;color:#9ca3af">IVA (16%) Incluido</div>
                                    </div>
                                </div>

                                <!-- Chips con resumen de prendas del carrito -->
                                <div id="cotizaCartChipsList" style="display:flex;flex-wrap:wrap;gap:.45rem;max-height:115px;overflow-y:auto;padding:.4rem 0;margin-bottom:1rem;border-top:1px solid rgba(255,255,255,0.08);border-bottom:1px solid rgba(255,255,255,0.08)">
                                    <!-- Se inyecta dinámicamente -->
                                </div>

                                <!-- Botones de acción directa -->
                                <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));gap:.75rem">
                                    <button type="button" class="btn btn-w" onclick="generarPDFCotizacionCarrito()"
                                        style="justify-content:center;padding:.8rem 1rem;font-size:.88rem;box-shadow:0 4px 16px rgba(226,30,44,0.35);cursor:pointer">
                                        📄 Descargar Cotización en PDF
                                    </button>
                                    <button type="button" class="btn btn-o" onclick="transferirCarritoAOrdenDesdeCotiza()"
                                        style="justify-content:center;padding:.8rem 1rem;font-size:.88rem;border-color:rgba(253,196,23,0.6);color:var(--ama);cursor:pointer">
                                        📋 Pasar a Orden de Compra B2B ↗
                                    </button>
                                </div>
                            </div>

                            <!-- Estado B: Cuando el carrito está vacío -->
                            <div id="cotizaCartEmptyBox" style="background:rgba(255,255,255,0.04);border:1px dashed rgba(255,255,255,0.2);border-radius:12px;padding:.9rem 1.15rem;text-align:left;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem">
                                <div style="display:flex;align-items:center;gap:.7rem;max-width:440px">
                                    <span style="font-size:1.5rem">💡</span>
                                    <div style="font-size:.82rem;color:var(--gcl);line-height:1.4">
                                        <b style="color:#ffffff">¿Deseas una cotización con prendas específicas?</b><br>
                                        Añade productos a tu carrito desde nuestro catálogo y podrás generar tu cotización formal con membrete en PDF al instante.
                                    </div>
                                </div>
                                <button type="button" onclick="navigateToTab('diseno')" class="btn btn-o"
                                    style="padding:.5rem .95rem;font-size:.8rem;border-color:var(--ama);color:var(--ama);border-radius:8px;cursor:pointer">
                                    🛍️ Explorar Catálogo
                                </button>
                            </div>
                        </div>

                        <!-- Mensaje de aviso amigable y suave si faltan datos obligatorios -->
                        <div id="cotizaFriendlyNotice" style="display:none;background:rgba(253,196,23,0.12);border:1px solid rgba(253,196,23,0.4);color:var(--ama);padding:.85rem 1.1rem;border-radius:12px;font-size:.85rem;margin-bottom:1.2rem;line-height:1.45;transition:all .3s ease"></div>

                        <form id="formCotizaPersonal" onsubmit="return enviarCotizacionPersonal(event)" novalidate style="display:grid;gap:1.1rem;text-align:left">
                            <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(210px, 1fr));gap:1rem">
                                <!-- 1. Nombre Completo (Obligatorio) -->
                                <div>
                                    <label for="cotizaNombre" style="display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--gcl);margin-bottom:.35rem">
                                        Nombre Completo <span style="color:var(--ama)">*</span>
                                    </label>
                                    <input type="text" id="cotizaNombre" placeholder="Ej: Carlos Pérez" required
                                        style="width:100%;padding:.9rem 1rem;border:1px solid rgba(255,255,255,0.15);border-radius:10px;background:rgba(255,255,255,0.06);color:#fff;font-family:Poppins;font-size:.86rem;outline:none;transition:border-color .2s"
                                        onfocus="this.style.borderColor='var(--ama)'" onblur="this.style.borderColor='rgba(255,255,255,0.15)'">
                                </div>

                                <!-- 2. Teléfono / WhatsApp (Obligatorio) -->
                                <div>
                                    <label for="cotizaTelefono" style="display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--gcl);margin-bottom:.35rem">
                                        Teléfono / WhatsApp <span style="color:var(--ama)">*</span>
                                    </label>
                                    <input type="tel" id="cotizaTelefono" placeholder="Ej: +58 412 1234567" required
                                        style="width:100%;padding:.9rem 1rem;border:1px solid rgba(255,255,255,0.15);border-radius:10px;background:rgba(255,255,255,0.06);color:#fff;font-family:Poppins;font-size:.86rem;outline:none;transition:border-color .2s"
                                        onfocus="this.style.borderColor='var(--ama)'" onblur="this.style.borderColor='rgba(255,255,255,0.15)'">
                                </div>

                                <!-- 3. Correo Electrónico (Obligatorio) -->
                                <div>
                                    <label for="cotizaEmail" style="display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--gcl);margin-bottom:.35rem">
                                        Correo Electrónico <span style="color:var(--ama)">*</span>
                                    </label>
                                    <input type="email" id="cotizaEmail" placeholder="tu@correo.com" required
                                        style="width:100%;padding:.9rem 1rem;border:1px solid rgba(255,255,255,0.15);border-radius:10px;background:rgba(255,255,255,0.06);color:#fff;font-family:Poppins;font-size:.86rem;outline:none;transition:border-color .2s"
                                        onfocus="this.style.borderColor='var(--ama)'" onblur="this.style.borderColor='rgba(255,255,255,0.15)'">
                                </div>
                            </div>

                            <!-- 4. Comentarios o Dudas (Opcional - Si no deja comentario no pasa nada) -->
                            <div>
                                <label for="cotizaComentarios" style="display:block;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--gcl);margin-bottom:.35rem">
                                    Comentarios o Requerimiento <span style="color:#9ca3af;font-weight:400;text-transform:none">(Opcional)</span>
                                </label>
                                <textarea id="cotizaComentarios" rows="3" placeholder="Escribe aquí cualquier duda, prendas de tu interés, cantidades estimadas o detalles que desees comentarnos (opcional)..."
                                    style="width:100%;padding:.9rem 1rem;border:1px solid rgba(255,255,255,0.15);border-radius:10px;background:rgba(255,255,255,0.06);color:#fff;font-family:Poppins;font-size:.86rem;outline:none;resize:vertical;transition:border-color .2s"
                                    onfocus="this.style.borderColor='var(--ama)'" onblur="this.style.borderColor='rgba(255,255,255,0.15)'"></textarea>
                            </div>

                            <button type="submit" class="btn btn-w" style="justify-content:center;padding:1rem;font-size:.95rem;margin-top:.4rem;width:100%">
                                📨 Solicitar Cotización Personal
                            </button>
                        </form>
                    </div>

                </div>
            </section>
        </div><!-- /view-cotiza -->

    </main><!-- /views-viewport -->

